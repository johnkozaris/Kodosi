{
  "relayProtocolVersion": 10,
  "compatibilityPolicy": "exactMatch",
  "payloadAuthority": "The backend relays terminal and pending-permission payloads as ciphertext only and parses only authenticated routing headers.",
  "unknownMessagePolicy": "terminalClose",
  "malformedPayloadPolicy": "terminalClose",
  "messages": {
    "device.proofChallenge": {
      "direction": "backendToClient",
      "lane": "lifecycle",
      "framing": "json",
      "maxBytes": 16384,
      "requiredFields": [
        "type",
        "connectionId",
        "purpose",
        "challenge"
      ],
      "optionalFields": [
        "sessionId"
      ],
      "ordering": "must precede device.proof and route hello/join",
      "idempotencyKey": null,
      "droppable": false,
      "coalesceable": false,
      "security": "fresh 32-byte server nonce; single socket use; purpose and optional sessionId are signed"
    },
    "device.proof": {
      "direction": "clientToBackend",
      "lane": "lifecycle",
      "framing": "json",
      "maxBytes": 16384,
      "requiredFields": [
        "type",
        "deviceId",
        "signature"
      ],
      "optionalFields": [
        "sessionId",
        "expectedIncarnationId"
      ],
      "ordering": "must answer the immediately preceding device.proofChallenge before host.hello or participant.join",
      "idempotencyKey": null,
      "droppable": false,
      "coalesceable": false,
      "security": "ML-DSA signature binds authenticated user, deviceId, connectionId, purpose, sessionId, expectedIncarnationId, and fresh challenge"
    },
    "host.hello": {
      "direction": "hostToBackend",
      "lane": "lifecycle",
      "framing": "json",
      "maxBytes": 2097152,
      "requiredFields": [
        "type",
        "sessionId",
        "sessionSecret",
        "deviceId",
        "expectedIncarnationId",
        "relayProtocolVersion"
      ],
      "optionalFields": [],
      "ordering": "none",
      "idempotencyKey": null,
      "droppable": false,
      "coalesceable": false,
      "versionNegotiation": "relayProtocolVersion must equal 10. Every other version is rejected. expectedIncarnationId is required and must match the active durable incarnation."
    },
    "host.heartbeat": {
      "direction": "hostToBackend",
      "lane": "lifecycle",
      "framing": "json",
      "maxBytes": 2097152,
      "requiredFields": [
        "type",
        "sessionId"
      ],
      "ordering": "none",
      "idempotencyKey": null,
      "droppable": false,
      "coalesceable": true
    },
    "host.end": {
      "direction": "hostToBackend",
      "lane": "lifecycle",
      "framing": "json",
      "maxBytes": 2097152,
      "requiredFields": [
        "type",
        "sessionId",
        "reason"
      ],
      "ordering": "none",
      "idempotencyKey": "sessionId",
      "reasonValues": [
        "host_stopped"
      ],
      "durabilityFailureMode": "closeHostWithoutFanout",
      "droppable": false,
      "coalesceable": false
    },
    "host.fenceAck": {
      "direction": "hostToBackend",
      "lane": "fence",
      "framing": "json",
      "maxBytes": 16384,
      "requiredFields": [
        "type",
        "sessionId",
        "fenceId"
      ],
      "ordering": "after the referenced host fence has been processed",
      "idempotencyKey": "sessionId+fenceId",
      "droppable": false,
      "coalesceable": true
    },
    "term.semanticCheckpoint": {
      "direction": "hostToBackendToParticipant",
      "lane": "terminal",
      "framing": "binary:0x03",
      "maxBytes": 8388671,
      "requiredFields": [
        "frameType",
        "keyGeneration",
        "counter",
        "checkpointRevision",
        "nextSequence",
        "ciphertext"
      ],
      "aeadAssociatedData": [
        "frameType",
        "keyGeneration",
        "counter",
        "checkpointRevision",
        "nextSequence"
      ],
      "payloadSemantics": "opaque encrypted semantic checkpoint; backend parses only the routing header",
      "ordering": "keyGeneration+semanticCheckpointCounterMonotonic; checkpointRevision+nextSequence remain monotonic across key generations",
      "counterDomain": "semanticCheckpoint HKDF subkey; independent from rawBatch, presentation, and pendingPermissions",
      "idempotencyKey": "sessionId+keyGeneration+semanticCheckpoint+counter",
      "droppable": false,
      "coalesceable": true
    },
    "term.rawBatch": {
      "direction": "hostToBackendToParticipant",
      "lane": "terminal",
      "framing": "binary:0x04",
      "maxBytes": 2097152,
      "requiredFields": [
        "frameType",
        "keyGeneration",
        "counter",
        "firstSequence",
        "nextSequence",
        "ciphertext"
      ],
      "aeadAssociatedData": [
        "frameType",
        "keyGeneration",
        "counter",
        "firstSequence",
        "nextSequence"
      ],
      "payloadSemantics": "opaque encrypted raw terminal bytes; retained in one shared ring bounded to 8 MiB and 256 frames",
      "ordering": "keyGeneration+rawBatchCounterMonotonic; exactSequenceContiguous across key generations",
      "counterDomain": "rawBatch HKDF subkey; independent from semanticCheckpoint, presentation, and pendingPermissions",
      "idempotencyKey": "sessionId+keyGeneration+rawBatch+counter",
      "droppable": true,
      "coalesceable": false
    },
    "term.presentation": {
      "direction": "hostToBackendToParticipant",
      "lane": "terminal",
      "framing": "binary:0x05",
      "maxBytes": 8388645,
      "requiredFields": [
        "frameType",
        "keyGeneration",
        "counter",
        "presentationRevision",
        "ciphertext"
      ],
      "aeadAssociatedData": [
        "frameType",
        "keyGeneration",
        "counter",
        "presentationRevision"
      ],
      "payloadSemantics": "opaque encrypted finite presentation; backend parses only the routing header",
      "ordering": "keyGeneration+presentationCounterMonotonic; presentationRevision remains monotonic across key generations",
      "counterDomain": "presentation HKDF subkey; independent from semanticCheckpoint, rawBatch, and pendingPermissions",
      "idempotencyKey": "sessionId+keyGeneration+presentation+counter",
      "droppable": true,
      "coalesceable": true
    },
    "permission.pendingSnapshot": {
      "direction": "hostToBackendToParticipant",
      "lane": "pendingPermissions",
      "framing": "binary:0x06",
      "maxBytes": 2097152,
      "requiredFields": [
        "frameType",
        "keyGeneration",
        "counter",
        "snapshotGeneration",
        "sessionId",
        "incarnationId",
        "ciphertext"
      ],
      "aeadAssociatedData": [
        "frameType",
        "keyGeneration",
        "counter",
        "snapshotGeneration",
        "sessionId",
        "incarnationId"
      ],
      "payloadSemantics": "opaque encrypted complete latest pending-permissions set; an empty set clears remote pending state",
      "precondition": "key.rotation with matching keyGeneration must be accepted before the snapshot; encrypted under the pendingPermissions HKDF subkey",
      "ordering": "snapshotGeneration strictly increases per session incarnation; counter strictly increases per key generation and WebSocket admission epoch",
      "counterDomain": "pendingPermissions HKDF subkey; independent from semanticCheckpoint, rawBatch, and presentation",
      "authorization": "forward only to owner participants or roles with Suggest, SendInput, or ApproveDeny",
      "cache": "at most one latest ciphertext snapshot per live session; key rotation clears old-key ciphertext and per-key counters but preserves the incarnation and snapshot-generation high-water mark",
      "idempotencyKey": "sessionId+incarnationId+snapshotGeneration",
      "droppable": false,
      "coalesceable": true
    },
    "key.rotation": {
      "direction": "hostToBackendToParticipant",
      "lane": "fence",
      "framing": "json",
      "maxBytes": 2097152,
      "requiredFields": [
        "type",
        "sessionId",
        "keyGeneration"
      ],
      "ordering": "keyGenerationMonotonic; atomically purges queued prior-generation 0x03-0x06 ciphertext per participant and precedes encrypted frames for the new keyGeneration",
      "idempotencyKey": "sessionId+keyGeneration",
      "droppable": false,
      "coalesceable": false
    },
