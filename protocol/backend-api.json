{
  "apiContractVersion": 17,
  "authContractVersion": 1,
  "authentication": "OIDC bearer identity and enrolled device proof",
  "sessionAuthorization": {
    "ownDevices": "current approved devices of the owner",
    "friends": "explicit membership in the selected live publication",
    "terminalControl": [
      "input",
      "resize",
      "focus",
      "interrupt",
      "close"
    ],
    "administration": "owner; membership updates require the hosting device",
    "friendshipGrantsSessions": false,
    "missionMembershipGrantsSessions": false
  },
  "sessionPublication": {
    "identity": [
      "id",
      "incarnationId",
      "hostDeviceId"
    ],
    "reuseAfterEnd": false,
    "membershipMutation": "replace chosen friend IDs with expected authorizationRevision",
    "revocation": "advance the revision; close the relay pipes of removed people and devices at once; tell the host",
    "inputReplayOnReconnect": false,
    "historicalMutationReceipts": false,
    "offlineExpiry": false,
    "missingRecovery": "current hosting device may republish same still-live incarnation with owner-only access"
  },
  "routes": {
    "accounts": [
      "GET /api/me"
    ],
    "identity": [
      "POST /api/me/devices/challenge",
      "POST /api/me/device-proofs/challenge",
      "POST /api/me/devices",
      "GET /api/me/identity",
      "GET /api/users/{userId}/identity",
      "POST /api/me/identity/device-list",
      "POST /api/me/identity/reset",
      "POST /api/me/connections/renew"
    ],
    "enrollment": [
      "POST /api/devices/link/init",
      "GET /api/devices/link/pending",
      "GET /api/devices/link/requests",
      "POST /api/devices/link/approve",
      "POST /api/devices/link/poll",
      "POST /api/devices/link/ack",
      "DELETE /api/devices/link/requests/{userCode}"
    ],
    "friends": [
      "GET /api/friends",
      "GET /api/friends/requests",
      "POST /api/friends/requests",
      "POST /api/friends/requests/{username}/accept",
      "POST /api/friends/requests/{username}/reject",
      "POST /api/friends/requests/{username}/cancel",
      "DELETE /api/friends/{username}"
    ],
    "sessions": [
      "GET /api/sessions",
      "POST /api/sessions",
      "GET /api/sessions/{id}",
      "PATCH /api/sessions/{id}",
      "DELETE /api/sessions/{id}",
      "PUT /api/sessions/{id}/mission",
      "PUT /api/sessions/{id}/members",
      "DELETE /api/sessions/{id}/members/me"
    ],
    "missions": [
      "GET /api/missions",
      "POST /api/missions",
      "GET /api/missions/{id}",
      "PATCH /api/missions/{id}",
      "DELETE /api/missions/{id}",
      "POST /api/missions/{id}/invitations",
      "POST /api/missions/invitations/{id}/accept",
      "POST /api/missions/invitations/{id}/reject",
      "DELETE /api/missions/{id}/members/{userId}"
    ]
  },
  "missionContent": "directory metadata only; no chat, tasks, or agent dispatch",
  "backendSecrets": "none; the server relays TLS records between a host device and a viewer device and holds no terminal key"
}
