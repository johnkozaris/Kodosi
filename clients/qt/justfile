set shell := ["bash", "-euo", "pipefail", "-c"]
set lazy

tools_dir := justfile_directory() + "/.tools"
cmake := tools_dir + "/cmake/bin/cmake"
ctest := tools_dir + "/cmake/bin/ctest"
qt_dir := tools_dir + "/Qt/gcc_64"
windows_cmake := tools_dir + "/cmake/bin/cmake.exe"
windows_ctest := tools_dir + "/cmake/bin/ctest.exe"
version := trim(`python3 scripts/release/product-version.py`)

# Install the pinned CMake, Ninja, Qt and Python tools in .tools.
tools-install:
    ./scripts/build/install-tools.sh

# Configure the CMake build in build/dev.
configure: tools-install
    CMAKE_PREFIX_PATH="{{ qt_dir }}" "{{ cmake }}" --preset dev

# Build the Linux app in build/dev.
build: configure
    "{{ cmake }}" --build --preset dev

# Lint the QML files.
lint: configure
    "{{ cmake }}" --build build/dev --target all_qmllint

# Build the Linux app and run its tests.
test: build
    "{{ cmake }}" --build build/dev --target test_prep/all
    "{{ ctest }}" --preset dev

# Check that the copies of the CMake and Qt versions agree with dependencies.lock.json.
dependency-pins-check:
    python3 scripts/build/verify-dependency-pins.py

# Test the release, archive and Windows package scripts.
release-integrity-test:
    python3 -m unittest scripts/tests/test_release_integrity.py
    python3 -m unittest scripts/tests/test_reproducible_archives.py
    python3 -m unittest scripts/tests/test_windows_package.py

# Write the Rust license inventory for Linux, and verify it.
rust-license-test:
    rm -rf build/rust-license-test
    python3 scripts/release/generate-rust-license-inventory.py \
        --manifest ../../runtime/Cargo.toml \
        --target x86_64-unknown-linux-gnu \
        --output-dir build/rust-license-test
    python3 scripts/release/verify-rust-license-inventory.py \
        --tree build/rust-license-test \
        --target x86_64-unknown-linux-gnu

# Verify the native license evidence, and test its verifier.
native-license-test: tools-install
    python3 scripts/release/verify-native-license-evidence.py
    python3 -m unittest scripts/tests/test_native_license_evidence.py

# Lint and test the Linux app and its release and license scripts.
check: dependency-pins-check release-integrity-test rust-license-test native-license-test lint test

# Build the Windows app in Git Bash on Windows 11, x64 or ARM64.
windows-build: tools-install
    source ../../scripts/windows-env.sh && kodosi_windows_env && \
        "{{ windows_cmake }}" --preset windows-dev && \
        "{{ windows_cmake }}" --build --preset windows-dev

# Build and test the Windows app.
windows-check: windows-build
    source ../../scripts/windows-env.sh && kodosi_windows_target && \
        "{{ windows_ctest }}" --preset windows-dev

# Run the Windows app with the installed Qt libraries.
windows-run *arguments: windows-build
    source ../../scripts/windows-env.sh && kodosi_windows_target && \
        PATH="$PWD/.tools/Qt/$KODOSI_QT_ARCH/bin:$PATH" build/windows-dev/kodosi-qt.exe {{ arguments }}

# For a release, set KODOSI_MSIX_PUBLISHER to the subject of the signing certificate.
# The default publisher makes an unsigned development package.
# Build, test, package and verify build/release/kodosi-<version>-windows-<arch>.msix.
windows-package: tools-install
    source ../../scripts/windows-env.sh && kodosi_windows_env && \
        export SOURCE_DATE_EPOCH="$(python3 scripts/release/source-date-epoch.py --source-root .)" && \
        "{{ windows_cmake }}" --preset windows-release \
            ${KODOSI_MSIX_PUBLISHER:+"-DKODOSI_MSIX_PUBLISHER=$KODOSI_MSIX_PUBLISHER"} && \
        "{{ windows_cmake }}" --build --preset windows-release && \
        "{{ windows_ctest }}" --preset windows-release && \
        rm -rf build/windows-release/layout && \
        "{{ windows_cmake }}" --install build/windows-release --prefix build/windows-release/layout && \
        mkdir -p build/release && \
        package="build/release/kodosi-{{ version }}-windows-$KODOSI_WINDOWS_ARCH.msix" && \
        ./scripts/release/package-msix.sh build/windows-release/layout "$package" && \
        python3 scripts/release/verify-windows-package.py "$package" \
            --target "$KODOSI_RUST_TARGET" \
            --build-dir build/windows-release \
            --qt-root ".tools/Qt/$KODOSI_QT_ARCH"

# Sign a package from windows-package with Azure Artifact Signing.
windows-sign package:
    source ../../scripts/windows-env.sh && kodosi_windows_env && \
        ./scripts/release/sign-msix.sh "{{ package }}"

# Make and verify the Debian package and the portable archive in build/release.
package: tools-install
    mkdir -p build/release
    find build/release -maxdepth 1 -type f \
        \( -name 'kodosi_*.deb' \
        -o -name 'kodosi-*-linux-x86_64.tar.gz' \
        -o -name 'kodosi-bin-*.pkg.tar.zst' \
        -o -name 'release-manifest.json' \
        -o -name 'release-manifest.json.asc' \) \
        -delete
    git status --porcelain=v1 --untracked-files=no \
        > build/release/tracked-status.before
    SOURCE_DATE_EPOCH="$(python3 scripts/release/source-date-epoch.py --source-root .)" \
        CMAKE_PREFIX_PATH="{{ qt_dir }}" "{{ cmake }}" --preset release
    SOURCE_DATE_EPOCH="$(python3 scripts/release/source-date-epoch.py --source-root .)" \
        "{{ cmake }}" --build --preset release
    "{{ cmake }}" --build build/release --target test_prep/all
    QT_QPA_PLATFORM=offscreen QSG_RHI_BACKEND=software \
        "{{ ctest }}" --preset release
    cd build/release && \
        umask 022 && \
        SOURCE_DATE_EPOCH="$(python3 ../../scripts/release/source-date-epoch.py \
            --source-root ../..)" \
        "{{ cmake }}" --build . --target package
    SOURCE_DATE_EPOCH="$(python3 scripts/release/source-date-epoch.py --source-root .)" \
        ./scripts/release/normalize-cpack-packages.sh build/release
    git status --porcelain=v1 --untracked-files=no \
        > build/release/tracked-status.after
    if ! cmp -s build/release/tracked-status.before \
        build/release/tracked-status.after; then \
        echo "Package build modified tracked source files" >&2; \
        diff build/release/tracked-status.before \
            build/release/tracked-status.after || true; \
        exit 1; \
    fi
    ./scripts/release/verify-linux-package.sh build/release/kodosi_{{ version }}_amd64.deb
    ./scripts/release/verify-packaged-content.sh build/release/kodosi-{{ version }}-linux-x86_64.tar.gz

# Make and verify the Arch package from the portable archive.
arch-package: package
    package="$(./scripts/release/package-arch.sh \
        build/release/kodosi-{{ version }}-linux-x86_64.tar.gz build/release)" && \
        ./scripts/release/verify-packaged-content.sh "$package" && \
        printf 'Arch-compatible package built: %s\n' "$package"

# Make the Linux packages, then check that a second build makes the same packages.
reproducible-package: package reproducibility-check

# Make the packages two more times from build/release, and check that they are the same. Commit all the changes first.
reproducibility-check: tools-install
    ./scripts/release/verify-reproducible-packages.sh

# Make all the Linux release packages, then write and verify the release manifest.
release-package: reproducible-package arch-package release-manifest-gen

# Write and verify the release manifest for the packages in build/release.
release-manifest-gen:
    python3 scripts/release/generate-release-manifest.py \
        --source-root . \
        --output-dir build/release \
        --artifact kodosi_{{ version }}_amd64.deb \
        --artifact kodosi-{{ version }}-linux-x86_64.tar.gz \
        --artifact kodosi-bin-{{ version }}-1-x86_64.pkg.tar.zst
    python3 scripts/release/verify-release-manifest.py \
        --source-root . \
        --manifest build/release/release-manifest.json \
        --output-dir build/release

# Sign the release manifest with the OpenPGP key of this fingerprint or of KODOSI_GPG_FINGERPRINT.
release-manifest-sign fingerprint="":
    ./scripts/release/sign-release-manifest.sh \
        build/release/release-manifest.json \
        "{{ fingerprint }}"

# Check the signature of the release manifest against the OpenPGP key of this fingerprint.
release-signature-check fingerprint="":
    ./scripts/release/verify-release-signature.sh \
        build/release/release-manifest.json \
        build/release/release-manifest.json.asc \
        "{{ fingerprint }}"
