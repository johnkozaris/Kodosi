          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma in un terminale di Kodosi vuole sapere dove si trova questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi のターミナルのプログラムがこの Mac の位置を知ろうとしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 터미널의 프로그램이 이 Mac의 위치를 알려고 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
