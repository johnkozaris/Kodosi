    "NSLocalNetworkUsageDescription" : {
      "comment" : "The reason that macOS shows when Kodosi asks for the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi verbindet sich direkt mit deinen anderen Computern in diesem Netzwerk, damit ihre Terminals und geteilten Browser sofort reagieren, und kann sie aus dem Ruhezustand aufwecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi συνδέεται απευθείας με τους άλλους υπολογιστές σας σε αυτό το δίκτυο, ώστε τα τερματικά και οι κοινόχρηστοι browser τους να αποκρίνονται αμέσως, και μπορεί να τους ξυπνά από τον ύπνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi connects straight to your other computers on this network, so that their terminals and shared browsers answer at once, and it can wake them from sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se conecta directamente a tus otros ordenadores de esta red para que sus terminales y navegadores compartidos respondan al instante, y puede reactivarlos desde la suspensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se connecte directement à vos autres ordinateurs sur ce réseau, pour que leurs terminaux et navigateurs partagés répondent immédiatement, et peut les réveiller de la veille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi si collega direttamente agli altri tuoi computer su questa rete, così i loro terminali e browser condivisi rispondono subito, e può riattivarli dalla sospensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi はこのネットワーク上のほかのコンピュータに直接接続し、それらのターミナルと共有ブラウザがすぐに応答できるようにします。また、それらをスリープから復帰させることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi는 이 네트워크의 다른 컴퓨터에 바로 연결해서 그 컴퓨터의 터미널과 공유 브라우저가 즉시 응답하게 하고, 잠자기에서 깨울 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 会直接连接到此网络中你的其他电脑，让它们的终端和共享浏览器即时响应，并可将它们从睡眠中唤醒。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "The reason that macOS shows when a program in a terminal asks for this.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
