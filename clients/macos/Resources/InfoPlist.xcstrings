  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "The reason that macOS shows when a program in a terminal asks for this.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm in einem Kodosi-Terminal möchte eine andere App steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα πρόγραμμα σε ένα τερματικό του Kodosi θέλει να ελέγξει μια άλλη εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A program in a Kodosi terminal wants to control another app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa de un terminal de Kodosi quiere controlar otra app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme d'un terminal Kodosi veut contrôler une autre app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma in un terminale di Kodosi vuole controllare un'altra app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi のターミナルのプログラムがほかの App を操作しようとしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 터미널의 프로그램이 다른 앱을 제어하려고 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 终端中的程序想要控制另一个 App。"
          }
        }
      }
    },
