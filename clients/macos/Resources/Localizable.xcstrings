    "Kodosi downloads updates in the background and installs them when you quit it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi lädt Updates im Hintergrund und installiert sie, wenn du es beendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
