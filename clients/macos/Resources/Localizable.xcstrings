            "value" : "Όταν ένα τερματικό περιμένει ή τελειώνει"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un terminal espera o termina"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un terminal attend ou termine"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un terminale attende o finisce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルが待機したり終了したりしたとき"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널이 기다리거나 끝날 때"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当终端等待或完成时"
          }
        }
      }
    },
    "When a viewer is off, the canvas shows a preview of its files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Ansicht aus ist, zeigt das Canvas eine Vorschau ihrer Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μια προβολή είναι ανενεργή, το canvas δείχνει προεπισκόπηση των αρχείων της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un visor está desactivado, el lienzo muestra una vista previa de sus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une visionneuse est désactivée, le canvas affiche un aperçu de ses fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un visualizzatore è disattivato, il canvas mostra un'anteprima dei suoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビューアがオフのときは、キャンバスにファイルのプレビューが表示されます。"
