    "Agents in Kodosi terminals always find the kodosi command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents in Kodosi-Terminals finden den Befehl kodosi immer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι agents στα τερματικά του Kodosi βρίσκουν πάντα την εντολή kodosi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes de los terminales de Kodosi siempre encuentran el comando kodosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents des terminaux Kodosi trouvent toujours la commande kodosi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli agenti nei terminali di Kodosi trovano sempre il comando kodosi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi のターミナル内のエージェントは、いつでも kodosi コマンドを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 터미널의 에이전트는 언제나 kodosi 명령을 쓸 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 终端中的 Agent 总能找到 kodosi 命令。"
          }
        }
      }
    },
    "Agents in Kodosi terminals and in other terminals find the kodosi command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agents in Kodosi-Terminals und in anderen Terminals finden den Befehl kodosi."
