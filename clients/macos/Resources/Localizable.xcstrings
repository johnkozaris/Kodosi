    "Kodosi asks before it downloads an update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi fragt, bevor es ein Update lädt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi ρωτά πριν κατεβάσει μια ενημέρωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi pregunta antes de descargar una actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi demande avant de télécharger une mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi chiede prima di scaricare un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi はアップデートをダウンロードする前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi는 업데이트를 내려받기 전에 물어봐요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 会在下载更新前询问你。"
          }
        }
      }
    },
    "Kodosi cannot open the Keychain, where it keeps your sign-in. Kodosi tries again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi kann den Schlüsselbund nicht öffnen, in dem es deine Anmeldung speichert. Kodosi versucht es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi δεν μπορεί να ανοίξει την Κλειδοθήκη, όπου κρατά τη σύνδεσή σας. Θα δοκιμάσει ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi no puede abrir el Llavero, donde guarda tu inicio de sesión. Lo volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi ne peut pas ouvrir le trousseau, où il conserve votre connexion. Kodosi va réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi non riesce ad aprire il Portachiavi, dove conserva il tuo accesso. Kodosi riproverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン情報を保存しているキーチェーンを Kodosi が開けません。自動的に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi가 로그인 정보를 보관하는 키체인을 열 수 없어요. 자동으로 다시 시도해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 无法打开保存你登录信息的钥匙串。Kodosi 会重试。"
          }
        }
      }
    },
    "Kodosi could not reach the earlier Kodosi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi hat die frühere Kodosi-Version nicht erreicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi δεν μπόρεσε να επικοινωνήσει με την προηγούμενη έκδοση του Kodosi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
