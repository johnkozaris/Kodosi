    },
    "Write one above. People and agents can pick it up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib oben eine. Personen und Agents können sie übernehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε μία παραπάνω. Άτομα και agents μπορούν να την αναλάβουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
