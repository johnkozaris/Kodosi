        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구는 나중에 초대해도 돼요. 방에 둔 내 터미널은 내 친구들에게 공유돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
