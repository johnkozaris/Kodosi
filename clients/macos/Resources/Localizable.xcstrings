    "Invite friends after. Your terminals in the room go to your friends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade danach Freunde ein. Deine Terminals im Raum gehen an deine Freunde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσκαλέστε φίλους μετά. Τα τερματικά σας στο δωμάτιο πηγαίνουν στους φίλους σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a amigos después. Tus terminales en la sala son para tus amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez inviter des amis ensuite. Vos terminaux dans le salon vont à vos amis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrai invitare gli amici dopo. I tuoi terminali nella stanza vanno ai tuoi amici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレンドは後から招待できます。ルームに置いたターミナルはフレンドに共有されます。"
          }
