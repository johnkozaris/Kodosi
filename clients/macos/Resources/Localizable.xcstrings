          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi n'a pas pu joindre l'ancienne version de Kodosi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi non è riuscito a raggiungere la versione precedente di Kodosi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi は以前の Kodosi に接続できませんでした。"
          }
        },
        "ko" : {
