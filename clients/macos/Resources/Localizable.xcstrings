    "The Kodosi server does not answer. Kodosi tries again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kodosi-Server antwortet nicht. Kodosi versucht es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής του Kodosi δεν απαντά. Το Kodosi θα δοκιμάσει ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de Kodosi no responde. Kodosi lo volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur Kodosi ne répond pas. Kodosi va réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di Kodosi non risponde. Kodosi riproverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi サーバーが応答しません。自動的に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 서버가 응답하지 않아요. 자동으로 다시 시도해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 服务器没有响应。Kodosi 会重试。"
          }
        }
      }
    },
    "The `kodosi host` command (process %@) runs the earlier version. Stop it in its terminal and start it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl `kodosi host` (Prozess %@) läuft noch mit der früheren Version. Beende ihn in seinem Terminal und starte ihn neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εντολή `kodosi host` (διεργασία %@) τρέχει την προηγούμενη έκδοση. Σταματήστε την στο τερματικό της και ξεκινήστε την ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El comando `kodosi host` (proceso %@) ejecuta la versión anterior. Detenlo en su terminal y vuelve a iniciarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande `kodosi host` (processus %@) exécute l'ancienne version. Arrêtez-la dans son terminal, puis relancez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il comando `kodosi host` (processo %@) esegue la versione precedente. Fermalo nel suo terminale e avvialo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`kodosi host` コマンド（プロセス %@）が以前のバージョンで動いています。そのターミナルで停止してから、もう一度起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`kodosi host` 명령(프로세스 %@)이 이전 버전으로 실행 중이에요. 해당 터미널에서 멈춘 뒤 다시 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`kodosi host` 命令（进程 %@）仍在运行旧版本。请在它的终端中停止它，然后重新启动。"
          }
        }
      }
    },
