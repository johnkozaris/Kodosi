    "Terminals on this Mac keep running. You cannot undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Terminals auf diesem Mac laufen weiter. Du kannst das nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τερματικά σε αυτό το Mac συνεχίζουν να τρέχουν. Δεν μπορείτε να το αναιρέσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
