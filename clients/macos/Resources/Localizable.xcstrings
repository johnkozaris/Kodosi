    "Closing the window quits Kodosi. Your terminals stop, and start again when Kodosi opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Schließen des Fensters beendet Kodosi. Deine Terminals werden beendet und starten wieder, wenn Kodosi öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλείσιμο του παραθύρου τερματίζει το Kodosi. Τα τερματικά σας σταματούν και ξεκινούν ξανά όταν ανοίξει το Kodosi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar la ventana, Kodosi se cierra. Tus terminales se detienen y vuelven a iniciarse cuando se abre Kodosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer la fenêtre quitte Kodosi. Vos terminaux s'arrêtent et redémarrent à l'ouverture de Kodosi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se chiudi la finestra, esci da Kodosi. I tuoi terminali si fermano e ripartono quando riapri Kodosi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウを閉じると Kodosi が終了します。ターミナルは停止し、Kodosi を開くと再び起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창을 닫으면 Kodosi가 종료돼요. 터미널은 멈추고 Kodosi를 열면 다시 시작돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭窗口会退出 Kodosi。你的终端会停止，并在 Kodosi 打开时重新启动。"
          }
        }
      }
    },
