    "A room keeps people, agents and terminals in one place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Raum bündelt Personen, Agents und Terminals an einem Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα δωμάτιο συγκεντρώνει άτομα, agents και τερματικά σε ένα σημείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sala reúne personas, agentes y terminales en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un salon réunit personnes, agents et terminaux au même endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stanza riunisce persone, agenti e terminali in un unico posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルームでは、人、エージェント、ターミナルをひとつにまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방에는 사람, 에이전트, 터미널이 한곳에 모여요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "房间把人、Agent 和终端放在一起。"
          }
        }
      }
    },
    "A terminal on a new branch gets its own folder. Kodosi removes a folder with no changes when its terminal ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Terminal auf einem neuen Branch bekommt einen eigenen Ordner. Kodosi entfernt einen Ordner ohne Änderungen, wenn sein Terminal endet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα τερματικό σε νέο branch αποκτά δικό του φάκελο. Το Kodosi αφαιρεί έναν φάκελο χωρίς αλλαγές όταν τελειώνει το τερματικό του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminal en una rama nueva tiene su propia carpeta. Kodosi quita una carpeta sin cambios cuando su terminal termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminal sur une nouvelle branche a son propre dossier. Kodosi supprime ce dossier à la fermeture du terminal s'il ne contient aucune modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminale su un nuovo branch ha una sua cartella. Quando il terminale viene chiuso, Kodosi rimuove la cartella se non contiene modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいブランチのターミナルには専用のフォルダが作られます。ターミナルが終了したとき、変更のないフォルダは Kodosi が削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 브랜치의 터미널에는 전용 폴더가 생겨요. 터미널이 끝날 때 변경 사항이 없는 폴더는 Kodosi가 지워요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新分支上的终端会有自己的文件夹。终端结束时，Kodosi 会移除没有改动的文件夹。"
          }
        }
      }
    },
