    "It can then use all your terminals, rooms and friends. Approve it only if you hold that device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann dann alle deine Terminals, Räume und Freunde nutzen. Gib es nur frei, wenn du dieses Gerät in der Hand hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα μπορεί έπειτα να χρησιμοποιεί όλα τα τερματικά, τα δωμάτια και τους φίλους σας. Εγκρίνετέ την μόνο αν κρατάτε αυτή τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego podrá usar todos tus terminales, salas y amigos. Apruébalo solo si tienes ese dispositivo en tus manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pourra alors utiliser tous vos terminaux, salons et amis. Approuvez-le seulement si vous avez cet appareil en main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrà poi usare tutti i tuoi terminali, stanze e amici. Approvalo solo se hai in mano quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認すると、そのデバイスはあなたのすべてのターミナル、ルーム、フレンドを使えるようになります。そのデバイスが手元にある場合にだけ承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인하면 그 기기가 내 모든 터미널, 방, 친구를 쓸 수 있어요. 그 기기를 직접 가지고 있을 때만 승인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准后，它可以使用你的所有终端、房间和好友。只有当那台设备在你手中时才批准。"
          }
        }
      }
    },
    "It leaves %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es verlässt %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φεύγει από το %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il quitte %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ からは外れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서는 빠져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将离开 %@。"
          }
        }
      }
    },
    "Its conversation and sharing end. Terminals keep running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unterhaltung endet, und die Terminals sind nicht mehr geteilt. Sie laufen weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συζήτηση και η κοινή χρήση του τερματίζονται. Τα τερματικά συνεχίζουν να τρέχουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su conversación y el uso compartido terminan. Los terminales siguen en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa conversation et ses partages prennent fin. Les terminaux continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua conversazione e le condivisioni terminano. I terminali continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話と共有は終了します。ターミナルは実行を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화와 공유가 끝나요. 터미널은 계속 실행돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其对话和共享将结束，终端会继续运行。"
          }
        }
      }
    },
    "Its programs stop." : {
      "localizations" : {
        "de" : {
