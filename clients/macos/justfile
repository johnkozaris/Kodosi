ghostty_dir := env('KODOSI_GHOSTTY_DIR', justfile_directory() + "/../../terminal/ghostty")

export KODOSI_GHOSTTY_DIR := ghostty_dir

default: all

ghostty:
    ../../scripts/verify-ghostty.sh

xcode-gen:
    scripts/build/generate-xcode-project.sh

package-test: ghostty
    swift test \
        --package-path ../apple

lint:
    swiftformat Sources Tests ../apple/Sources ../apple/Tests ../apple/Plugins ../apple/Package.swift --lint --swiftversion 6.0
    swiftlint lint --quiet Sources Tests ../apple/Sources ../apple/Tests ../apple/Plugins

format:
    swiftformat Sources Tests ../apple/Sources ../apple/Tests ../apple/Plugins ../apple/Package.swift --swiftversion 6.0

test: xcode-gen package-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        test

build-debug: xcode-gen package-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        build

build-release: ghostty xcode-gen package-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Release \
        -destination 'generic/platform=macOS' \
        build

archive-working-tree: xcode-gen
    KODOSI_WORKING_TREE_VALIDATION=1 ../../scripts/verify-ghostty.sh
    KODOSI_WORKING_TREE_VALIDATION=1 swift test \
        --package-path ../apple
    KODOSI_WORKING_TREE_VALIDATION=1 xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme WorkingTreeValidation \
        -configuration WorkingTreeValidation \
        -archivePath build/working-tree/KodosiDesktop.xcarchive \
        -destination 'generic/platform=macOS' \
        archive

release-graph-verifier:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    source "$root/scripts/build/deployment-target.sh"
    kodosi_load_macos_deployment_target "$root"
    (
        cd "$root"
        scripts/tests/test-rust-archive.sh "$KODOSI_MACOS_DEPLOYMENT_TARGET" arm64
    )
    "$root/scripts/tests/test-publishability.sh"
    "$root/scripts/tests/test-ghostty-link-provenance.sh"
    "$root/scripts/tests/test-generated-project.sh"

signature-verifier:
    scripts/tests/test-developer-id-signature.sh

provisioning-profile-verifier:
    scripts/tests/test-provisioning-profile.sh

native-notice-verifier:
    scripts/tests/test-native-notices.sh

ci: lint release-graph-verifier signature-verifier provisioning-profile-verifier native-notice-verifier package-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Release \
        -destination 'generic/platform=macOS' \
        build

all: lint test build-release

verify-signed:
    scripts/release/verify-signed.sh
