ghostty_dir := env('KODOSI_GHOSTTY_DIR', justfile_directory() + "/../../terminal/ghostty")
version := trim(`cat ../../VERSION`)
tools_dir := justfile_directory() + "/../apple/.tools"
swiftlint := tools_dir + "/swiftlint/swiftlint"
swiftformat := tools_dir + "/swiftformat/swiftformat"
xcodegen := tools_dir + "/xcodegen/bin/xcodegen"

export KODOSI_GHOSTTY_DIR := ghostty_dir

[private]
default: check

# Install the pinned SwiftLint, SwiftFormat and XcodeGen in clients/apple/.tools.
tools-install:
    ../apple/scripts/install-tools.sh

# Generate the Xcode project from project.yml.
xcode-gen: tools-install
    KODOSI_VERSION="{{ version }}" KODOSI_MACOS_DEPLOYMENT_TARGET="$(cat Config/macOSDeploymentTarget)" "{{ xcodegen }}" generate --quiet

# Test the shared Swift package in clients/apple.
apple-test:
    swift test \
        --package-path ../apple

# Lint Swift sources for the Mac app and shared Apple package.
lint: tools-install
    "{{ swiftformat }}" Sources Tests ../apple/Sources ../apple/Tests ../apple/Package.swift --lint
    "{{ swiftlint }}" lint --quiet Sources Tests ../apple/Sources ../apple/Tests

# Format Swift sources for the Mac app and shared Apple package.
format: tools-install
    "{{ swiftformat }}" Sources Tests ../apple/Sources ../apple/Tests ../apple/Package.swift

# Test the shared Swift package and the Mac app.
test: xcode-gen apple-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        test

# Test the shared Swift package, then build the Debug Mac app.
build: xcode-gen apple-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        build

# Build the Release Mac app. Commit all changes first.
release-build: xcode-gen apple-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Release \
        -destination 'generic/platform=macOS' \
        build

# Build a local validation archive from the working tree (not for distribution).
working-tree-build: xcode-gen
    python3 ../../terminal/ghostty/scripts/verify-ghostty-pins.py --working-tree
    KODOSI_WORKING_TREE_VALIDATION=1 swift test \
        --package-path ../apple
    KODOSI_WORKING_TREE_VALIDATION=1 xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme WorkingTreeValidation \
        -configuration WorkingTreeValidation \
        -archivePath build/working-tree/KodosiDesktop.xcarchive \
        -destination 'generic/platform=macOS' \
        archive

# Verify that Swift packages and Ghostty match the app deployment targets.
deployment-targets-check:
    ../apple/scripts/verify-deployment-targets.py

# Lint, test, build the Release Mac app, and check translations. Commit all changes first.
check: lint deployment-targets-check xcode-gen apple-test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Debug \
        -destination 'platform=macOS' \
        test
    xcodebuild -project KodosiDesktop.xcodeproj \
        -scheme KodosiDesktop \
        -configuration Release \
        -destination 'generic/platform=macOS' \
        build
    python3 ../apple/scripts/sync-string-catalogs.py --check
    python3 ../../scripts/check-translations.py

# Build, notarize, and package build/export/Kodosi-<version>.dmg. Commit all changes first.
release-package: xcode-gen
    scripts/release/archive.sh build/archive/KodosiDesktop.xcarchive
    scripts/release/export.sh build/archive/KodosiDesktop.xcarchive build/export
    scripts/release/notarize.sh build/export/Kodosi.app
    scripts/release/package-dmg.sh build/export/Kodosi.app build/export/Kodosi-{{ version }}.dmg

# Write the Homebrew cask build/kodosi.rb for the disk image at KODOSI_DOWNLOAD_URL.
cask-gen:
    scripts/release/generate-cask.sh build/export/Kodosi-{{ version }}.dmg build/kodosi.rb

# Verify code signatures, provisioning profiles, and entitlements of the exported release app.
signature-check:
    scripts/release/verify-signed.sh
