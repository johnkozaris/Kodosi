    },
    "Kodosi started again before the terminal connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi wurde neu gestartet, bevor das Terminal verbunden war."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi ξεκίνησε ξανά πριν συνδεθεί το τερματικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se reinició antes de que el terminal se conectara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi a redémarré avant que le terminal ne se connecte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi si è riavviato prima che il terminale si connettesse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルが接続する前に Kodosi が再起動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널이 연결되기 전에 Kodosi가 다시 시작됐어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端连接前 Kodosi 已重新启动。"
          }
        }
      }
    },
    "Kodosi stopped before the terminal connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi wurde beendet, bevor das Terminal verbunden war."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi σταμάτησε πριν συνδεθεί το τερματικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se ha detenido antes de que el terminal se conectara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi s'est arrêté avant que le terminal ne se connecte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi si è fermato prima che il terminale si connettesse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルが接続する前に Kodosi が停止しました。"
          }
        },
