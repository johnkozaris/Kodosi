    "On a device you already use, choose Approve, then enter this code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle auf einem Gerät, das du schon nutzt, „Freigeben“ und gib dann diesen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια συσκευή που ήδη χρησιμοποιείτε, επιλέξτε «Έγκριση» και μετά εισαγάγετε αυτόν τον κωδικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un dispositivo que ya uses, elige «Aprobar» y escribe este código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un appareil que vous utilisez déjà, choisissez « Approuver », puis saisissez ce code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un dispositivo che usi già, scegli «Approva» e poi inserisci questo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに使っているデバイスで「承認」を選び、このコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 쓰고 있는 기기에서 '승인'을 누른 뒤 이 코드를 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你已在使用的设备上选择“批准”，然后输入此验证码。"
          }
        }
      }
    },
