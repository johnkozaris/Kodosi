          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなた"
          }
        },
        "ko" : {
