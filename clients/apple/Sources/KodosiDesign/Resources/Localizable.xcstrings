    "On a device you already use, open Settings and choose Add a device. Then enter this code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf einem Gerät, das du schon nutzt, die Einstellungen und wähle „Gerät hinzufügen“. Gib dann diesen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια συσκευή που ήδη χρησιμοποιείτε, ανοίξτε τις Ρυθμίσεις και επιλέξτε «Προσθήκη συσκευής». Μετά εισαγάγετε αυτόν τον κωδικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un dispositivo que ya uses, abre Ajustes y elige «Añadir un dispositivo». Después escribe este código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un appareil que vous utilisez déjà, ouvrez les Réglages et choisissez « Ajouter un appareil ». Saisissez ensuite ce code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un dispositivo che usi già, apri Impostazioni e scegli «Aggiungi un dispositivo». Poi inserisci questo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに使っているデバイスで設定を開き、「デバイスを追加」を選びます。次に、このコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 쓰고 있는 기기에서 설정을 열고 '기기 추가'를 고르세요. 그런 다음 이 코드를 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你已在使用的设备上打开“设置”并选择“添加设备”，然后输入此验证码。"
          }
        }
      }
    },
    "On a device you already use, open Settings and choose Add a device. Then scan this code, or enter it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf einem Gerät, das du schon nutzt, die Einstellungen und wähle „Gerät hinzufügen“. Scanne dann diesen Code oder gib ihn ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια συσκευή που ήδη χρησιμοποιείτε, ανοίξτε τις Ρυθμίσεις και επιλέξτε «Προσθήκη συσκευής». Μετά σαρώστε αυτόν τον κωδικό ή εισαγάγετέ τον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un dispositivo que ya uses, abre Ajustes y elige «Añadir un dispositivo». Después escanea este código o escríbelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un appareil que vous utilisez déjà, ouvrez les Réglages et choisissez « Ajouter un appareil ». Scannez ensuite ce code ou saisissez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un dispositivo che usi già, apri Impostazioni e scegli «Aggiungi un dispositivo». Poi scansiona questo codice o inseriscilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに使っているデバイスで設定を開き、「デバイスを追加」を選びます。次に、このコードをスキャンするか入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 쓰고 있는 기기에서 설정을 열고 '기기 추가'를 고르세요. 그런 다음 이 코드를 스캔하거나 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
