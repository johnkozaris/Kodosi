        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi はこの画像を読み込めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi가 이 이미지를 읽을 수 없어요."
          }
