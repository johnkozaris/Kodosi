        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi σταμάτησε πριν στείλει αυτό που πληκτρολογήσατε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se ha detenido antes de enviar lo que has escrito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi s'est arrêté avant d'envoyer votre saisie."
          }
