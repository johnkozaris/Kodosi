    },
    "This terminal still waits for earlier typing. Kodosi did not send your paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Terminal wartet noch auf frühere Eingaben. Kodosi hat dein Eingefügtes nicht gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το τερματικό περιμένει ακόμη να σταλούν όσα πληκτρολογήσατε πριν. Το Kodosi δεν έστειλε την επικόλλησή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este terminal aún tiene pendiente lo que has escrito antes. Kodosi no ha enviado lo que has pegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce terminal n'a pas encore reçu votre saisie précédente. Kodosi n'a pas envoyé le contenu collé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo terminale sta ancora inviando l'input precedente. Kodosi non ha inviato ciò che hai incollato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このターミナルは以前の入力をまだ待っています。Kodosi は貼り付けた内容を送信しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 터미널은 아직 이전 입력을 기다리고 있어요. Kodosi가 붙여넣은 내용을 보내지 않았어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
