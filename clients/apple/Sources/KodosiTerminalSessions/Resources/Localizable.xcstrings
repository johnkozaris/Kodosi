        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 无法读取此图片。"
          }
        }
      }
    },
    "Kodosi did not send your typing (error %d)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi hat deine Eingabe nicht gesendet (Fehler %d)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi δεν έστειλε αυτό που πληκτρολογήσατε (σφάλμα %d)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi no ha enviado lo que has escrito (error %d)."
          }
        },
