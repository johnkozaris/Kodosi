        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 未发送你的输入（错误 %d）。"
          }
        }
      }
    },
    "Kodosi stopped before it sent your typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi wurde beendet, bevor es deine Eingabe gesendet hat."
