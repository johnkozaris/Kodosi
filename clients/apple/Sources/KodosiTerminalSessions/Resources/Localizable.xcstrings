          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端无法连接。"
          }
        }
      }
    },
    "The terminal received an invalid control frame. Retry the terminal to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Terminal hat einen ungültigen Steuer-Frame erhalten. Versuche es erneut, um wieder zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τερματικό έλαβε μη έγκυρο πλαίσιο ελέγχου. Δοκιμάστε ξανά για επανασύνδεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El terminal ha recibido una trama de control no válida. Reinténtalo para reconectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le terminal a reçu une trame de contrôle non valide. Réessayez pour le reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il terminale ha ricevuto un frame di controllo non valido. Riprova per riconnetterlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルが無効な制御フレームを受信しました。再試行して再接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널이 잘못된 제어 프레임을 받았어요. 다시 시도해서 다시 연결하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端收到了无效的控制帧。请重试以重新连接。"
          }
        }
      }
    },
    "This terminal fell behind. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Terminal kommt nicht mehr hinterher. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το τερματικό δεν πρόλαβε τις ενημερώσεις. Δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
