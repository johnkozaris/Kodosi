    "That paste is too large, so Kodosi did not send it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Eingefügte ist zu groß, darum hat Kodosi es nicht gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επικόλληση είναι πολύ μεγάλη, οπότε το Kodosi δεν την έστειλε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que has pegado es demasiado grande, así que Kodosi no lo ha enviado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu collé est trop volumineux, Kodosi ne l'a donc pas envoyé."
