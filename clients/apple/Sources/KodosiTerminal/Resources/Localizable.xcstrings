    "A program in %@ asks for the text that you copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm in %@ möchte den Text lesen, den du kopiert hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα πρόγραμμα στο %@ ζητά το κείμενο που αντιγράψατε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa en %@ pide el texto que has copiado."
          }
