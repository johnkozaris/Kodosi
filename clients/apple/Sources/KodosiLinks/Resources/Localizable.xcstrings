    "The link comes from terminal output. Open it only if you trust it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link stammt aus der Ausgabe eines Terminals. Öffne ihn nur, wenn du ihm vertraust."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο σύνδεσμος προέρχεται από την έξοδο του τερματικού. Ανοίξτε τον μόνο αν τον εμπιστεύεστε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace viene de la salida del terminal. Ábrelo solo si confías en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien provient de la sortie du terminal. Ouvrez-le seulement si vous lui faites confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link arriva dall'output del terminale. Aprilo solo se ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクはターミナルの出力から来たものです。信頼できる場合にのみ開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크는 터미널 출력에서 왔어요. 믿을 수 있을 때만 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此链接来自终端输出。仅在你信任它时打开。"
          }
        }
      }
    },
    "The link comes from the canvas of a terminal. Open it only if you trust it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link stammt aus dem Canvas eines Terminals. Öffne ihn nur, wenn du ihm vertraust."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο σύνδεσμος προέρχεται από το canvas ενός τερματικού. Ανοίξτε τον μόνο αν τον εμπιστεύεστε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace viene del lienzo de un terminal. Ábrelo solo si confías en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien provient du canvas d'un terminal. Ouvrez-le seulement si vous lui faites confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link arriva dal canvas di un terminale. Aprilo solo se ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクはターミナルのキャンバスから来たものです。信頼できる場合にのみ開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크는 터미널의 캔버스에서 왔어요. 믿을 수 있을 때만 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此链接来自某个终端的画布。仅在你信任它时打开。"
          }
        }
      }
    },
    "The link has hidden characters that can change how it looks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link enthält versteckte Zeichen, die sein Aussehen verändern können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο σύνδεσμος έχει κρυφούς χαρακτήρες που μπορούν να αλλάξουν την εμφάνισή του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace tiene caracteres ocultos que pueden cambiar cómo se ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien contient des caractères cachés qui peuvent modifier son apparence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link contiene caratteri nascosti che possono cambiarne l'aspetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクには、見た目を変えられる隠し文字が含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크에는 모양을 바꿀 수 있는 숨은 문자가 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该链接包含可能改变其显示效果的隐藏字符。"
          }
        }
      }
    },
