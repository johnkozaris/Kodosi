{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "The reason that iOS shows when Kodosi asks to use the camera to scan an invite or the code of a device.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi nutzt die Kamera, um die Einladung eines Freundes oder den Code eines Geräts zu scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi χρησιμοποιεί την κάμερα για να σαρώσει την πρόσκληση ενός φίλου ή τον κωδικό μιας συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi uses the camera to scan a friend's invite or the code of a device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi usa la cámara para escanear la invitación de un amigo o el código de un dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi utilise l'appareil photo pour scanner l'invitation d'un ami ou le code d'un appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi usa la fotocamera per scansionare l'invito di un amico o il codice di un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi はフレンドの招待やデバイスのコードをスキャンするためにカメラを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi는 친구의 초대나 기기의 코드를 스캔할 때 카메라를 사용해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 使用相机扫描好友的邀请或设备的二维码。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "The reason that iOS shows when Kodosi asks to use Face ID for its lock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi fragt nach Face ID, bevor es deine Terminals zeigt, wenn du es in den Einstellungen sperrst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi ζητά Face ID πριν δείξει τα τερματικά σας, όταν το κλειδώνετε στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi asks for Face ID before it shows your terminals, when you lock it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi pide Face ID antes de mostrar tus terminales, cuando lo bloqueas en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi demande Face ID avant d'afficher vos terminaux, quand vous le verrouillez dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi chiede Face ID prima di mostrare i tuoi terminali, quando lo blocchi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で Kodosi をロックすると、ターミナルを表示する前に Face ID を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Kodosi를 잠그면 터미널을 보여 주기 전에 Face ID를 요청합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置中锁定 Kodosi 后，它会在显示你的终端之前要求 Face ID。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "The reason that iOS shows when Kodosi asks for the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi verbindet sich direkt mit deinem Computer in diesem Netzwerk, damit ein geteilter Browser sofort reagiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Kodosi συνδέεται απευθείας με τον υπολογιστή σας σε αυτό το δίκτυο, ώστε ένας κοινόχρηστος browser να αποκρίνεται αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi connects straight to your computer on this network, so that a shared browser answers at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se conecta directamente a tu ordenador de esta red para que un navegador compartido responda al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi se connecte directement à votre ordinateur sur ce réseau, pour qu'un navigateur partagé réponde immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi si collega direttamente al tuo computer su questa rete, così un browser condiviso risponde subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi はこのネットワーク上のあなたのコンピュータに直接接続し、共有ブラウザがすぐに応答できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi는 이 네트워크의 내 컴퓨터에 바로 연결해서 공유 브라우저가 즉시 응답하게 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodosi 会直接连接到此网络中你的电脑，让共享浏览器即时响应。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}