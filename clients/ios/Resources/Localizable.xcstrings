{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ also keeps the model and effort for its next sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ behält Modell und Denkaufwand auch für seine nächsten Sitzungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ κρατά το μοντέλο και την ένταση σκέψης και για τις επόμενες συνεδρίες του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también conserva el modelo y el razonamiento para sus próximas sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ garde aussi le modèle et le raisonnement pour ses prochaines sessions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mantiene modello e ragionamento anche per le sessioni successive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、このモデルと推論レベルを次回以降のセッションでも使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이 모델과 추론 수준을 다음 세션에도 그대로 써요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 之后的会话也会沿用这个模型和推理强度。"
          }
        }
      }
    },
    "%@ asks for permission" : {
      "localizations" : {
