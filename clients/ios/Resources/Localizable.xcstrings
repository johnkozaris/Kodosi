    "Show them your invite, or share it. They add it to send you a request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig ihnen deine Einladung oder teile sie. Wenn sie sie hinzufügen, bekommst du eine Anfrage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείξτε τους την πρόσκλησή σας ή μοιραστείτε την. Την προσθέτουν για να σας στείλουν αίτημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muéstrales tu invitación o compártela. La añaden para enviarte una solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez-leur votre invitation ou partagez-la. Ils l'ajoutent pour vous envoyer une demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra loro il tuo invito o condividilo. Lo aggiungono per inviarti una richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待を見せるか共有してください。相手がそれを追加すると、あなたにリクエストが届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대를 보여 주거나 공유하세요. 상대가 초대를 추가하면 나에게 요청이 와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向对方展示或分享你的邀请。对方添加后会向你发送请求。"
          }
        }
      }
    },
    "Shows the people and settings of this project" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
