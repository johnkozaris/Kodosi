    "Terminals on your computers keep running. Sign in again to use them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Terminals auf deinen Computern laufen weiter. Melde dich erneut an, um sie hier zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τερματικά στους υπολογιστές σας συνεχίζουν να τρέχουν. Συνδεθείτε ξανά για να τα χρησιμοποιήσετε εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los terminales de tus ordenadores siguen en marcha. Vuelve a iniciar sesión para usarlos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les terminaux de vos ordinateurs continuent de fonctionner. Reconnectez-vous pour les utiliser ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I terminali sui tuoi computer continuano a funzionare. Accedi di nuovo per usarli qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのターミナルは実行を続けます。ここで使うにはもう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 터미널은 계속 실행돼요. 여기서 쓰려면 다시 로그인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你电脑上的终端会继续运行。重新登录即可在这里使用。"
          }
        }
      }
    },
    "Terminals on your computers keep running. You cannot undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Terminals auf deinen Computern laufen weiter. Du kannst das nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τερματικά στους υπολογιστές σας συνεχίζουν να τρέχουν. Δεν μπορείτε να το αναιρέσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los terminales de tus ordenadores siguen en marcha. No puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les terminaux de vos ordinateurs continuent de fonctionner. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I terminali sui tuoi computer continuano a funzionare. Non puoi annullare questa azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのターミナルは実行を続けます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 터미널은 계속 실행돼요. 되돌릴 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你电脑上的终端会继续运行。此操作无法撤销。"
