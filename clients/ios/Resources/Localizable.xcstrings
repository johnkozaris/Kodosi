    "The invite that %@ sent you matches this identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einladung, die %@ dir geschickt hat, passt zu dieser Identität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσκληση που σας έστειλε ο χρήστης %@ ταιριάζει με αυτή την ταυτότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La invitación que te ha enviado %@ coincide con esta identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'invitation que %@ vous a envoyée correspond à cette identité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'invito che ti ha inviato %@ corrisponde a questa identità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ さんから届いた招待は、この ID と一致しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 보낸 초대가 이 신원과 일치해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 发给你的邀请与此身份一致。"
          }
        }
      }
    },
    "The recovery key that you have now stops working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein jetziger Wiederherstellungsschlüssel funktioniert dann nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί ανάκτησης που έχετε τώρα παύει να λειτουργεί."
          }
        },
        "es" : {
          "stringUnit" : {
