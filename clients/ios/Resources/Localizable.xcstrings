    "Their identity changed. Trust it only if they told you so." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Identität dieser Person hat sich geändert. Vertraue ihr nur, wenn die Person es dir gesagt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταυτότητα του ατόμου άλλαξε. Ορίστε την ως αξιόπιστη μόνο αν σας το είπε το ίδιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su identidad ha cambiado. Confía en ella solo si esta persona te lo dijo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son identité a changé. Faites-lui confiance seulement si cette personne vous l'a dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua identità è cambiata. Considerala attendibile solo se questa persona te lo ha detto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手の ID が変わりました。相手から知らされた場合だけ信頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대의 신원이 바뀌었어요. 상대가 직접 알려 준 경우에만 신뢰하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方的身份已变更。仅在对方告诉过你时才信任新身份。"
          }
        }
      }
    },
