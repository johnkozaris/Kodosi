        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기를 잃어버렸을 때"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你丢失了所有设备"
          }
        }
      }
    },
    "In %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@"
          }
        },
        "el" : {
