    "Send your invite to a friend, or add them with their invite or username. Friends can open the terminals you share, and you can open theirs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick einem Freund deine Einladung oder füge ihn mit seiner Einladung oder seinem Benutzernamen hinzu. Freunde können die Terminals öffnen, die du teilst, und du ihre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλτε την πρόσκλησή σας σε έναν φίλο ή προσθέστε τον με την πρόσκληση ή το όνομα χρήστη του. Οι φίλοι μπορούν να ανοίγουν τα τερματικά που μοιράζεστε, κι εσείς τα δικά τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tu invitación a un amigo o añádelo con su invitación o su nombre de usuario. Tus amigos pueden abrir los terminales que compartes, y tú los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez votre invitation à un ami, ou ajoutez-le avec son invitation ou son nom d'utilisateur. Vos amis peuvent ouvrir les terminaux que vous partagez, et vous les leurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia il tuo invito a un amico o aggiungilo con il suo invito o nome utente. Gli amici possono aprire i terminali che condividi, e tu i loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレンドに招待を送るか、相手の招待やユーザー名で追加してください。フレンドはあなたが共有したターミナルを開けます。あなたもフレンドのターミナルを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구에게 초대를 보내거나, 친구의 초대나 사용자 이름으로 추가하세요. 친구는 내가 공유한 터미널을 열 수 있고, 나도 친구의 터미널을 열 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的邀请发给好友，或通过对方的邀请或用户名添加好友。好友可以打开你共享的终端，你也可以打开他们的。"
          }
        }
      }
    },
