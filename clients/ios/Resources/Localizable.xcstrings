    "Ask %@ for their invite in a place you trust, such as a call or a message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte %@ um eine Einladung über einen Weg, dem du vertraust, etwa einen Anruf oder eine Nachricht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον χρήστη %@ την πρόσκλησή του από ένα κανάλι που εμπιστεύεστε, π.χ. μια κλήση ή ένα μήνυμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %@ su invitación por un medio de confianza, como una llamada o un mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez son invitation à %@ par un moyen de confiance, comme un appel ou un message."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a %@ il suo invito tramite un canale fidato, come una chiamata o un messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話やメッセージなど、信頼できる方法で %@ さんに招待を頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화나 메시지처럼 믿을 수 있는 방법으로 %@ 님에게 초대를 요청하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请通过你信任的方式（如通话或消息）向 %@ 索取邀请。"
          }
        }
      }
    },
