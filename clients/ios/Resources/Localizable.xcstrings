    "See what your agents do, answer them, and talk in your projects. Your terminals keep running on your computers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, was deine Agents tun, antworte ihnen und rede in deinen Projekten mit. Deine Terminals laufen auf deinen Computern weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τι κάνουν οι agents σας, απαντήστε τους και μιλήστε στα έργα σας. Τα τερματικά σας συνεχίζουν να τρέχουν στους υπολογιστές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira lo que hacen tus agentes, respóndeles y habla en tus proyectos. Tus terminales siguen en marcha en tus ordenadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez ce que font vos agents, répondez-leur et discutez dans vos projets. Vos terminaux continuent de fonctionner sur vos ordinateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cosa fanno i tuoi agenti, rispondi loro e parla nei tuoi progetti. I tuoi terminali continuano a funzionare sui tuoi computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの作業を確認して返答し、プロジェクトで会話できます。ターミナルは各コンピュータで動き続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 하는 일을 보고, 답하고, 프로젝트에서 대화하세요. 터미널은 내 컴퓨터에서 계속 실행돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看 Agent 的工作、回复它们，并在项目中交流。你的终端会在你的电脑上继续运行。"
          }
        }
      }
    },
