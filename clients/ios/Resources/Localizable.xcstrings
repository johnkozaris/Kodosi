    "A project gathers terminals from any folder and computer, with its tasks and repositories. Invite friends when you want." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Projekt bündelt Terminals aus jedem Ordner und von jedem Computer, mit seinen Aufgaben und Repositorys. Lade Freunde ein, wenn du möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα έργο συγκεντρώνει τερματικά από οποιονδήποτε φάκελο και υπολογιστή, μαζί με τις εργασίες και τα αποθετήριά του. Προσκαλέστε φίλους όποτε θέλετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto reúne terminales de cualquier carpeta y ordenador, con sus tareas y repositorios. Invita a amigos cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un projet rassemble des terminaux de n'importe quel dossier et ordinateur, avec ses tâches et ses dépôts. Invitez des amis quand vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un progetto riunisce terminali da qualsiasi cartella e computer, con le sue attività e i suoi repository. Invita gli amici quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトは、どのフォルダやコンピュータのターミナルも、タスクやリポジトリと一緒にまとめます。フレンドはいつでも招待できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 어느 폴더와 컴퓨터의 터미널이든 작업, 저장소와 함께 모아요. 친구는 원할 때 초대하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目汇集来自任意文件夹和电脑的终端，以及它的任务和仓库。可随时邀请好友。"
          }
        }
      }
    },
    "A recovery key approves a new device when you have no other device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wiederherstellungsschlüssel gibt ein neues Gerät frei, wenn du kein anderes Gerät mehr hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κλειδί ανάκτησης εγκρίνει μια νέα συσκευή όταν δεν έχετε άλλη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una clave de recuperación aprueba un dispositivo nuevo cuando no tienes ningún otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé de récupération approuve un nouvel appareil quand vous n'en avez aucun autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave di recupero approva un nuovo dispositivo quando non ne hai altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーキーがあれば、ほかのデバイスがなくても新しいデバイスを承認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 키가 있으면 다른 기기가 없어도 새 기기를 승인할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有其他设备时，可以用恢复密钥批准新设备。"
          }
        }
      }
    },
