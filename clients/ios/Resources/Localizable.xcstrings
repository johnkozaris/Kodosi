    "Dosi forgets this chat, here and on your other computers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi vergisst diesen Chat, hier und auf deinen anderen Computern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Dosi ξεχνά αυτή τη συνομιλία, εδώ και στους άλλους υπολογιστές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi olvida este chat, aquí y en tus otros ordenadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi oublie ce chat, ici et sur vos autres ordinateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi dimentica questa chat, qui e sugli altri tuoi computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi はこのチャットを忘れます。ほかのコンピュータでも同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi가 이 채팅을 잊어요. 여기와 다른 컴퓨터 모두에서요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosi 会忘记这段聊天，包括你其他电脑上的。"
          }
        }
      }
    },
