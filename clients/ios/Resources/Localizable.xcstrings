    "Share one of your terminals with this project. Your friends in the project get full control." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile eines deiner Terminals mit diesem Projekt. Deine Freunde im Projekt bekommen die volle Kontrolle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιραστείτε ένα από τα τερματικά σας με αυτό το έργο. Οι φίλοι σας στο έργο αποκτούν πλήρη έλεγχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte uno de tus terminales con este proyecto. Tus amigos en el proyecto tendrán control total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez l'un de vos terminaux avec ce projet. Vos amis dans le projet en auront le contrôle total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi uno dei tuoi terminali con questo progetto. I tuoi amici nel progetto ne avranno il pieno controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルをこのプロジェクトと共有しましょう。プロジェクトにいるフレンドがフル操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 터미널 하나를 이 프로젝트와 공유해 보세요. 프로젝트에 있는 친구들이 전체 권한을 가져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与此项目共享你的一个终端。项目里你的好友都能完全控制它。"
          }
        }
      }
    },
