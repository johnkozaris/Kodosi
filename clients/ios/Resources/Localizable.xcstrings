    "Start a new chat?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuen Chat starten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έναρξη νέας συνομιλίας;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Empezar un chat nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
