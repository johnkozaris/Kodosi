simulator := env('KODOSI_IOS_SIMULATOR', 'Kodosi iPhone 17 Pro')
build_number := env('KODOSI_BUILD', '1')
tools_dir := justfile_directory() + "/../apple/.tools"
swiftlint := tools_dir + "/swiftlint/swiftlint"
swiftformat := tools_dir + "/swiftformat/swiftformat"
xcodegen := tools_dir + "/xcodegen/bin/xcodegen"

[private]
default: build

# Install the pinned SwiftLint, SwiftFormat and XcodeGen in clients/apple/.tools.
tools-install:
    ../apple/scripts/install-tools.sh

# Generate the Xcode project from project.yml.
xcode-gen: tools-install
    KODOSI_VERSION="$(cat ../../VERSION)" KODOSI_BUILD="{{ build_number }}" KODOSI_IOS_DEPLOYMENT_TARGET="$(cat ../apple/Config/iOSDeploymentTarget)" "{{ xcodegen }}" generate --quiet

# Lint Swift sources for the iOS app and notification extension.
lint: tools-install
    "{{ swiftformat }}" Sources Tests Notifications --lint
    "{{ swiftlint }}" lint --quiet Sources Tests Notifications

# Format Swift sources for the iOS app and notification extension.
format: tools-install
    "{{ swiftformat }}" Sources Tests Notifications

# Verify that Swift packages and Ghostty match the app deployment targets.
deployment-targets-check:
    ../apple/scripts/verify-deployment-targets.py

# Build the Debug app for the iOS simulator.
build: xcode-gen
    xcodebuild -project KodosiMobile.xcodeproj \
        -scheme KodosiMobile \
        -configuration Debug \
        -destination 'generic/platform=iOS Simulator' \
        build

# Run unit tests on KODOSI_IOS_SIMULATOR (creating the simulator if missing).
test: xcode-gen
    #!/usr/bin/env bash
    set -euo pipefail
    id=$(scripts/prepare-simulator.sh "{{ simulator }}")
    xcodebuild -project KodosiMobile.xcodeproj \
        -scheme KodosiMobile \
        -configuration Debug \
        -destination "id=$id" \
        test

# Build the Release app for iOS devices.
device-build: xcode-gen
    xcodebuild -project KodosiMobile.xcodeproj \
        -scheme KodosiMobile \
        -configuration Release \
        -destination 'generic/platform=iOS' \
        -allowProvisioningUpdates \
        build

# Lint, test, build the iOS app for devices, and check translations.
check: lint deployment-targets-check test device-build
    python3 ../apple/scripts/sync-string-catalogs.py --check
    python3 ../../scripts/check-translations.py
