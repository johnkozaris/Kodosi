GHOSTTY_WINDOWS_VT_CPU=baseline
GHOSTTY_WINDOWS_VT_OPTIMIZE=ReleaseFast

# The machine's architecture, as Qt and Rust choose it, even from emulated Git Bash.
# shellcheck source=../../scripts/windows-env.sh
source ../../scripts/windows-env.sh
case "$(kodosi_windows_arch)" in
    x64)
        GHOSTTY_WINDOWS_VT_TARGET=x86_64-windows-msvc
        GHOSTTY_WINDOWS_VT_LAYOUT=windows-x86_64
        ;;
    arm64)
        GHOSTTY_WINDOWS_VT_TARGET=aarch64-windows-msvc
        GHOSTTY_WINDOWS_VT_LAYOUT=windows-arm64
        ;;
    *)
        return 1 2>/dev/null || exit 1
        ;;
esac
