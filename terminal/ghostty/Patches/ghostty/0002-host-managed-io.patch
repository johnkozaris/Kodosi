diff --git a/src/termio/HostManaged.zig b/src/termio/HostManaged.zig
new file mode 100644
index 000000000..eb98d9c10
--- /dev/null
+++ b/src/termio/HostManaged.zig
@@ -0,0 +1,194 @@
+const HostManaged = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+
+userdata: ?*anyopaque,
+write: Config.Write,
+resize_cb: ?Config.Resize,
+exited: std.atomic.Value(bool) = .init(false),
+
+pub const Config = struct {
+    pub const Write = *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void;
+    pub const Resize = *const fn (?*anyopaque, u16, u16, u32, u32) callconv(.c) void;
+
+    userdata: ?*anyopaque = null,
+    write: Write,
+    resize: ?Resize = null,
+};
+
+pub fn init(config: Config) HostManaged {
+    return .{
+        .userdata = config.userdata,
+        .write = config.write,
+        .resize_cb = config.resize,
+    };
+}
+
+pub fn deinit(self: *HostManaged) void {
+    _ = self;
+}
+
+pub fn initTerminal(self: *HostManaged, term: *terminal.Terminal) void {
+    _ = self;
+    _ = term;
+}
+
+pub fn threadEnter(
+    self: *HostManaged,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .host_managed = .{} };
+}
+
+pub fn threadExit(self: *HostManaged, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *HostManaged,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *HostManaged,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    if (self.exited.load(.acquire)) return;
+    const callback = self.resize_cb orelse return;
+    callback(
+        self.userdata,
+        grid_size.columns,
+        grid_size.rows,
+        screen_size.width,
+        screen_size.height,
+    );
+}
+
+pub fn queueWrite(
+    self: *HostManaged,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+    _ = linefeed;
+
+    if (data.len == 0 or self.exited.load(.acquire)) return;
+    self.write(self.userdata, data.ptr, data.len);
+}
+
+pub fn childExitedAbnormally(
+    self: *HostManaged,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+pub fn markExited(self: *HostManaged) bool {
+    return !self.exited.swap(true, .acq_rel);
+}
+
+pub fn isExited(self: *const HostManaged) bool {
+    return self.exited.load(.acquire);
+}
+
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+
+    pub fn changeConfig(self: *ThreadData, config: *termio.DerivedConfig) void {
+        _ = self;
+        _ = config;
+    }
+};
+
+test "host-managed rejects IO after exit" {
+    const testing = std.testing;
+
+    const State = struct {
+        writes: usize = 0,
+        resize: ?struct {
+            columns: u16,
+            rows: u16,
+            width: u32,
+            height: u32,
+        } = null,
+
+        fn receiveBuffer(userdata: ?*anyopaque, _: [*]const u8, len: usize) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            self.writes += len;
+        }
+
+        fn receiveResize(
+            userdata: ?*anyopaque,
+            columns: u16,
+            rows: u16,
+            width: u32,
+            height: u32,
+        ) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            self.resize = .{
+                .columns = columns,
+                .rows = rows,
+                .width = width,
+                .height = height,
+            };
+        }
+    };
+
+    var state: State = .{};
+    var host_managed: HostManaged = .init(.{
+        .userdata = &state,
+        .write = State.receiveBuffer,
+        .resize = State.receiveResize,
+    });
+    var thread_data: termio.Termio.ThreadData = undefined;
+
+    try host_managed.queueWrite(testing.allocator, &thread_data, "test", false);
+    try host_managed.resize(
+        .{ .columns = 80, .rows = 24 },
+        .{ .width = 800, .height = 600 },
+    );
+    try testing.expectEqual(@as(usize, 4), state.writes);
+    try testing.expectEqual(@as(u16, 80), state.resize.?.columns);
+    try testing.expectEqual(@as(u16, 24), state.resize.?.rows);
+    try testing.expectEqual(@as(u32, 800), state.resize.?.width);
+    try testing.expectEqual(@as(u32, 600), state.resize.?.height);
+
+    try testing.expect(host_managed.markExited());
+    try testing.expect(!host_managed.markExited());
+    try host_managed.queueWrite(testing.allocator, &thread_data, "ignored", false);
+    try host_managed.resize(
+        .{ .columns = 120, .rows = 40 },
+        .{ .width = 1200, .height = 900 },
+    );
+    try testing.expectEqual(@as(usize, 4), state.writes);
+    try testing.expectEqual(@as(u16, 80), state.resize.?.columns);
+}
