+const ImageProtocol = enum {
+    kitty,
+    glyph,
+};
+
+fn imageProtocolAllowed(enabled: bool, protocol: ImageProtocol) bool {
+    return enabled and switch (protocol) {
+        .kitty, .glyph => true,
+    };
+}
+
+test "image storage disabled rejects every image protocol" {
+    const testing = std.testing;
+
+    try testing.expect(!imageProtocolAllowed(false, .kitty));
+    try testing.expect(!imageProtocolAllowed(false, .glyph));
+}
+
+test "image storage enabled admits every image protocol" {
+    const testing = std.testing;
+
+    try testing.expect(imageProtocolAllowed(true, .kitty));
+    try testing.expect(imageProtocolAllowed(true, .glyph));
+}
