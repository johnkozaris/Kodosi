+/// Replace a host-managed terminal from a portable replay. The grid and replay
+/// are applied under one renderer-state lock so no live output can observe or
+/// mutate the terminal between them.
+pub fn replaceOutput(
+    self: *Termio,
+    buf: []const u8,
+    columns: u16,
+    rows: u16,
+) !void {
+    if (columns == 0 or rows == 0) return error.InvalidGridSize;
+
+    const terminal_width = try std.math.mul(
+        u32,
+        @as(u32, columns),
+        self.size.cell.width,
+    );
+    const terminal_height = try std.math.mul(
+        u32,
+        @as(u32, rows),
+        self.size.cell.height,
+    );
+    const horizontal_padding = try std.math.add(
+        u32,
+        self.size.padding.left,
+        self.size.padding.right,
+    );
+    const vertical_padding = try std.math.add(
+        u32,
+        self.size.padding.top,
+        self.size.padding.bottom,
+    );
+    const screen_width = try std.math.add(u32, terminal_width, horizontal_padding);
+    const screen_height = try std.math.add(u32, terminal_height, vertical_padding);
+
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    try self.terminal.resize(self.alloc, .{
+        .cols = columns,
+        .rows = rows,
+        .cell_size_px = .{
+            .width = self.size.cell.width,
+            .height = self.size.cell.height,
+        },
+    });
+    self.terminal.fullReset();
+    self.resetTerminalStream();
+    self.size.screen = .{ .width = screen_width, .height = screen_height };
+    self.processOutputLocked(buf);
+}
+
+/// Reset all parser and stream-handler state while retaining only the stable
+/// renderer, mailbox, configuration, and terminal pointers.
+fn resetTerminalStream(self: *Termio) void {
+    const current = &self.terminal_stream.handler;
+    const handler: StreamHandler = .{
+        .alloc = current.alloc,
+        .termio_mailbox = current.termio_mailbox,
+        .surface_mailbox = current.surface_mailbox,
+        .renderer_state = current.renderer_state,
+        .renderer_wakeup = current.renderer_wakeup,
+        .renderer_mailbox = current.renderer_mailbox,
+        .size = current.size,
+        .terminal = current.terminal,
+        .osc_color_report_format = current.osc_color_report_format,
+        .clipboard_write = current.clipboard_write,
+        .image_protocols_enabled = current.image_protocols_enabled,
+        .clipboard_write_limit = current.clipboard_write_limit,
+        .enquiry_response = current.enquiry_response,
+    };
+    self.terminal_stream.deinit();
+    self.terminal_stream = .init(.{
+        .allocator = self.alloc,
+        .handler = handler,
+    });
+}
