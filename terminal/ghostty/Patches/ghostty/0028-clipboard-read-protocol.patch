+/// to write the reply that the program expects.
+pub const Protocol = enum(c_int) {
+    /// OSC 52.
+    osc_52 = 0,
+
+    /// The Kitty clipboard protocol (OSC 5522).
+    kitty = 1,
+    _,
+};
