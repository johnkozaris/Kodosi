+/// Resize a host-managed terminal as the host resized its own, between the
+/// output before the resize and the output after it. The cells take the
+/// host's pixel size, so images cover the same cells as on the host, while
+/// this surface draws them at its own cell size.
+pub fn hostResizeLocked(
+    self: *Termio,
+    cols: terminalpkg.size.CellCountInt,
+    rows: terminalpkg.size.CellCountInt,
+    cell_width_px: u32,
+    cell_height_px: u32,
+) Result {
+    const new_size = hostManagedSize(self.size, cols, rows) catch return .limit_exceeded;
+    self.terminal.resize(self.alloc, .{
+        .cols = cols,
+        .rows = rows,
+        .cell_size_px = .{ .width = cell_width_px, .height = cell_height_px },
+    }) catch |err| return switch (err) {
+        error.OutOfMemory => .out_of_memory,
+        error.InvalidValue => .invalid_value,
+    };
+    self.size = new_size;
+    return .success;
+}
+
+/// The size of a host-managed surface that shows the host's grid in the
+/// cells and padding of this surface.
+fn hostManagedSize(
+    surface: renderer.Size,
+    cols: terminalpkg.size.CellCountInt,
+    rows: terminalpkg.size.CellCountInt,
+) error{Overflow}!renderer.Size {
+    const padding = surface.padding;
+    return .{
+        .screen = .{
+            .width = try std.math.add(
+                u32,
+                try std.math.mul(u32, cols, surface.cell.width),
+                try std.math.add(u32, padding.left, padding.right),
+            ),
+            .height = try std.math.add(
+                u32,
+                try std.math.mul(u32, rows, surface.cell.height),
+                try std.math.add(u32, padding.top, padding.bottom),
+            ),
+        },
+        .cell = surface.cell,
+        .padding = padding,
+    };
+}
