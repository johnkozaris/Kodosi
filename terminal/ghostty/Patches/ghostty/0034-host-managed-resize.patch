+
+test "a host-managed surface shows the host's grid in its own cells" {
+    const testing = std.testing;
+    const surface: renderer.Size = .{
+        .screen = .{ .width = 1000, .height = 700 },
+        .cell = .{ .width = 10, .height = 20 },
+        .padding = .{ .top = 2, .bottom = 3, .left = 4, .right = 5 },
+    };
+    const size = try hostManagedSize(surface, 80, 24);
+    try testing.expectEqual(@as(u32, 809), size.screen.width);
+    try testing.expectEqual(@as(u32, 485), size.screen.height);
+    try testing.expectEqual(renderer.GridSize{ .columns = 80, .rows = 24 }, size.grid());
+    try testing.expectEqual(surface.cell, size.cell);
+
+    var wide = surface;
+    wide.cell.width = std.math.maxInt(u32);
+    try testing.expectError(error.Overflow, hostManagedSize(wide, 2, 1));
+}
