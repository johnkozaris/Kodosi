+    stream.nextSlice("\x1b]8;id=first;https://one.example\x1b\\one");
+    stream.nextSlice("\x1b]8;;\x1b\\ ");
+    stream.nextSlice("\x1b]8;id=second;https://two.example\x1b\\\x1b[1mtwo\x1b[0m");
+    stream.nextSlice("\x1b]8;;\x1b\\ plain");
+
+    const page = t.screens.active.pages.pages.last.?.page();
