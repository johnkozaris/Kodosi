+test "Terminal formatter selects inactive primary without mutation" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var t = try Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+    try t.printString("primary");
+    _ = try t.switchScreen(.alternate);
+    try t.printString("alternate");
+
+    var formatter: TerminalFormatter = .init(&t, .plain);
+    formatter.screen = .primary;
+    try formatter.format(&builder.writer);
+
+    try testing.expectEqualStrings("primary", builder.writer.buffered());
+    try testing.expectEqual(.alternate, t.screens.active_key);
+}
