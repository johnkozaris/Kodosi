+test "set hierarchical_context callback" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(
+        &lib.alloc.test_allocator,
+        &t,
+        80,
+        24,
+    ));
+    defer free(t);
+
+    const S = struct {
+        var count: usize = 0;
+        var last_size: usize = 0;
+        var last_action: HierarchicalContextAction = .end;
+        var last_id: [64]u8 = undefined;
+        var last_id_len: usize = 0;
+        var last_fields: [128]u8 = undefined;
+        var last_fields_len: usize = 0;
+
+        fn signal(
+            _: Terminal,
+            _: ?*anyopaque,
+            context: *const HierarchicalContext,
+        ) callconv(lib.calling_conv) void {
+            count += 1;
+            last_size = context.size;
+            last_action = context.action;
+            last_id_len = context.id.len;
+            @memcpy(last_id[0..last_id_len], context.id.ptr[0..last_id_len]);
+            last_fields_len = context.fields.len;
+            @memcpy(last_fields[0..last_fields_len], context.fields.ptr[0..last_fields_len]);
+        }
+    };
+
+    // Without a callback the signal is dropped.
+    const start = "\x1B]3008;start=a1;type=remote;targethost=build\x5cx3bhost\x1B\\";
+    vt_write(t, start, start.len);
+    try testing.expectEqual(0, S.count);
+
+    try testing.expectEqual(Result.success, set(t, .hierarchical_context, @ptrCast(&S.signal)));
+    vt_write(t, start, start.len);
+    try testing.expectEqual(1, S.count);
+    try testing.expectEqual(@sizeOf(HierarchicalContext), S.last_size);
+    try testing.expectEqual(HierarchicalContextAction.start, S.last_action);
+    try testing.expectEqualStrings("a1", S.last_id[0..S.last_id_len]);
+    try testing.expectEqualStrings(
+        "type=remote;targethost=build\\x3bhost",
+        S.last_fields[0..S.last_fields_len],
+    );
+
+    const end = "\x1B]3008;end=a1\x07";
+    vt_write(t, end, end.len);
+    try testing.expectEqual(2, S.count);
+    try testing.expectEqual(HierarchicalContextAction.end, S.last_action);
+    try testing.expectEqualStrings("a1", S.last_id[0..S.last_id_len]);
+    try testing.expectEqual(0, S.last_fields_len);
+
+    // An invalid signal is never reported.
+    const invalid = "\x1B]3008;begin=a1\x07";
+    vt_write(t, invalid, invalid.len);
+    try testing.expectEqual(2, S.count);
+
+    try testing.expectEqual(Result.success, set(t, .hierarchical_context, null));
+    vt_write(t, start, start.len);
+    try testing.expectEqual(2, S.count);
+}
