+test "kitty renderer draws a placement in its own cell size" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    // The terminal has 10x20 pixel cells, as on the computer that sets its
+    // size; this renderer draws 5x10 pixel cells.
+    var t = try terminal.Terminal.init(io, alloc, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(alloc);
+    t.width_px = 30;
+    t.height_px = 60;
+
+    var state: State = .empty;
+    defer state.deinit(alloc);
+    var render_state: terminal.RenderState = .empty;
+    defer render_state.deinit(alloc);
+
+    const storage = &t.screens.active.kitty_images;
+    try storage.addImage(io, alloc, t.screens.active, .{
+        .id = 1,
+        .width = 20,
+        .height = 20,
+        .format = .gray,
+        .data = .{ .complete = try alloc.alloc(u8, 400) },
+    });
+    const pin = try t.screens.active.pages.trackPin(
+        t.screens.active.cursor.page_pin.*,
+    );
+    try storage.addPlacement(io, alloc, t.screens.active, 1, 1, .{
+        .location = .{ .pin = pin },
+        .x_offset = 4,
+        .y_offset = 6,
+    });
+
+    // The image covers the same cells: three columns and two rows.
+    try render_state.update(alloc, &t);
+    const drawn: CellSize = .{ .width = 5, .height = 10 };
+    try testing.expect(state.kittyRequiresUpdate(&t, &render_state, drawn));
+    state.kittyUpdate(alloc, &t, &render_state, drawn);
+    const placement = state.kitty_placements.items[0];
+    try testing.expectEqual(@as(u32, 10), placement.width);
+    try testing.expectEqual(@as(u32, 10), placement.height);
+    try testing.expectEqual(@as(u32, 2), placement.cell_offset_x);
+    try testing.expectEqual(@as(u32, 3), placement.cell_offset_y);
+    try testing.expectEqual(@as(u32, 20), placement.source_width);
+    try testing.expect(!state.kittyRequiresUpdate(&t, &render_state, drawn));
+
+    // With the terminal's own cell size nothing changes.
+    const own: CellSize = .{ .width = 10, .height = 20 };
+    try testing.expect(state.kittyRequiresUpdate(&t, &render_state, own));
+    state.kittyUpdate(alloc, &t, &render_state, own);
+    try testing.expectEqual(@as(u32, 20), state.kitty_placements.items[0].width);
+    try testing.expectEqual(@as(u32, 4), state.kitty_placements.items[0].cell_offset_x);
+}
