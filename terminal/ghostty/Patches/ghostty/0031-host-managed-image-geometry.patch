+    /// Converts the pixels of a terminal's cells to the pixels of the cells
+    /// that the renderer draws.
+    const TerminalScale = struct {
+        terminal: CellSize,
+        renderer: CellSize,
+
+        fn init(t: *const terminal.Terminal, cell_size: CellSize) TerminalScale {
+            const width = if (t.cols > 0) t.width_px / t.cols else 0;
+            const height = if (t.rows > 0) t.height_px / t.rows else 0;
+            return .{
+                .terminal = if (width == 0 or height == 0)
+                    cell_size
+                else
+                    .{ .width = width, .height = height },
+                .renderer = cell_size,
+            };
+        }
+
+        fn x(self: TerminalScale, value: u32) u32 {
+            return convert(value, self.terminal.width, self.renderer.width);
+        }
+
+        fn y(self: TerminalScale, value: u32) u32 {
+            return convert(value, self.terminal.height, self.renderer.height);
+        }
+
+        fn convert(value: u32, from: u32, to: u32) u32 {
+            if (from == to or from == 0) return value;
+            return std.math.cast(u32, @as(u64, value) * to / from) orelse std.math.maxInt(u32);
+        }
+    };
