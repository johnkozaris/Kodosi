+/// Capture one screen without touching its committed page/grid state.
+pub fn captureScreen(
+    alloc: Allocator,
+    key: ScreenKey,
+    screen: *const Screen,
+) CaptureError!ScreenState {
+    if (comptime @hasField(Screen, "kitty_images")) {
+        if (screen.kitty_images.images.count() != 0 or
+            screen.kitty_images.placements.count() != 0)
+        {
+            return error.UnsupportedKittyImages;
+        }
+    }
+
+    var active_hyperlink: ?ActiveHyperlink = null;
+    errdefer if (active_hyperlink) |link| {
+        alloc.free(link.uri);
+        if (link.explicitId) |id| alloc.free(id);
+    };
+    if (screen.cursor.hyperlink) |link| {
+        const uri = try alloc.dupe(u8, link.uri);
+        errdefer alloc.free(uri);
+        active_hyperlink = switch (link.id) {
+            .implicit => |id| .{
+                .kind = .implicit,
+                .uri = uri,
+                .implicitId = id,
+            },
+            .explicit => |id| .{
+                .kind = .explicit,
+                .uri = uri,
+                .explicitId = try alloc.dupe(u8, id),
+            },
+        };
+    }
+
+    return .{
+        .key = key,
+        .cursor = .{
+            .x = screen.cursor.x,
+            .y = screen.cursor.y,
+            .pendingWrap = screen.cursor.pending_wrap,
+            .visualStyle = .init(screen.cursor.cursor_style),
+            .pen = .init(screen.cursor.style),
+            .protected = screen.cursor.protected,
+            .activeHyperlink = active_hyperlink,
+            .hyperlinkImplicitCounter = screen.cursor.hyperlink_implicit_id,
+            .semantic = .{
+                .seen = screen.semantic_prompt.seen,
+                .content = .init(screen.cursor.semantic_content),
+                .clearEol = screen.cursor.semantic_content_clear_eol,
+                .click = .init(screen.semantic_prompt.click),
+            },
+        },
+        .savedCursor = if (screen.saved_cursor) |saved| .init(saved) else null,
+        .charset = .init(screen.charset),
+        .protectedMode = .init(screen.protected_mode),
+        .kittyKeyboard = .init(screen.kitty_keyboard),
+    };
+}
