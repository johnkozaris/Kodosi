+pub const RestoreError = Allocator.Error || ValidationError || error{OutOfSpace};
+
+/// Construct a native screen directly from semantic state.
+///
+/// No terminal or parser is used as an intermediate. Every allocation remains
+/// local until all state has been restored; an error destroys the entire
+/// temporary screen before returning.
+pub fn restoreScreen(
+    io: std.Io,
+    alloc: Allocator,
+    options: Screen.Options,
+    state: ScreenState,
+) RestoreError!Screen {
+    try state.validate(options.cols, options.rows);
+
+    var result = try Screen.init(io, alloc, options);
+    errdefer result.deinit();
+
+    // A fresh Screen has no images. Keep this assertion adjacent to direct
+    // construction so later changes cannot silently introduce image restore.
+    if (comptime @hasField(Screen, "kitty_images")) {
+        if (result.kitty_images.images.count() != 0 or
+            result.kitty_images.placements.count() != 0)
+        {
+            return error.UnsupportedKittyImages;
+        }
+    }
+
+    result.cursorAbsolute(state.cursor.x, state.cursor.y);
+    result.cursor.cursor_style = state.cursor.visualStyle.native();
+    result.cursor.pending_wrap = state.cursor.pendingWrap;
+    result.cursor.protected = state.cursor.protected;
+    result.cursor.style = try state.cursor.pen.native();
+    try result.manualStyleUpdate();
+
+    result.charset = state.charset.native();
+    result.protected_mode = state.protectedMode.native();
+    result.kitty_keyboard = try state.kittyKeyboard.native();
+    result.semantic_prompt = .{
+        .seen = state.cursor.semantic.seen,
+        .click = state.cursor.semantic.click.native(),
+    };
+    result.cursor.semantic_content = state.cursor.semantic.content.native();
+    result.cursor.semantic_content_clear_eol = state.cursor.semantic.clearEol;
+
+    if (state.cursor.activeHyperlink) |link| {
+        switch (link.kind) {
+            .explicit => try result.startHyperlink(link.uri, link.explicitId.?),
+            .implicit => {
+                result.cursor.hyperlink_implicit_id = link.implicitId.?;
+                try result.startHyperlink(link.uri, null);
+            },
+        }
+    }
+    result.cursor.hyperlink_implicit_id = state.cursor.hyperlinkImplicitCounter;
+
+    result.saved_cursor = if (state.savedCursor) |saved| try saved.native() else null;
+    result.assertIntegrity();
+    return result;
+}
+
+pub fn restoreScreenWithPages(
+    io: std.Io,
+    alloc: Allocator,
+    pages: @import("PageList.zig"),
+    state: ScreenState,
+) RestoreError!Screen {
+    try state.validate(pages.cols, pages.rows);
+    var owned_pages = pages;
+    errdefer owned_pages.deinit();
+
+    const pin_value = owned_pages.pin(.{ .active = .{
+        .x = state.cursor.x,
+        .y = state.cursor.y,
+    } }) orelse return error.InvalidCursor;
+    const cursor_pin = try owned_pages.trackPin(pin_value);
+    errdefer owned_pages.untrackPin(cursor_pin);
+    const rac = cursor_pin.rowAndCell();
+
+    var result: Screen = .{
+        .io = io,
+        .alloc = alloc,
+        .pages = owned_pages,
+        .no_scrollback = owned_pages.constructionOptions().max_size == 0,
+        .cursor = .{
+            .x = state.cursor.x,
+            .y = state.cursor.y,
+            .cursor_style = state.cursor.visualStyle.native(),
+            .pending_wrap = state.cursor.pendingWrap,
+            .protected = state.cursor.protected,
+            .style = try state.cursor.pen.native(),
+            .hyperlink_implicit_id = state.cursor.hyperlinkImplicitCounter,
+            .semantic_content = state.cursor.semantic.content.native(),
+            .semantic_content_clear_eol = state.cursor.semantic.clearEol,
+            .page_pin = cursor_pin,
+            .page_row = rac.row,
+            .page_cell = rac.cell,
+        },
+        .saved_cursor = if (state.savedCursor) |saved| try saved.native() else null,
+        .charset = state.charset.native(),
+        .protected_mode = state.protectedMode.native(),
+        .kitty_keyboard = try state.kittyKeyboard.native(),
+        .semantic_prompt = .{
+            .seen = state.cursor.semantic.seen,
+            .click = state.cursor.semantic.click.native(),
+        },
+    };
+    errdefer result.deinit();
+    try result.manualStyleUpdate();
+    if (state.cursor.activeHyperlink) |link| {
+        switch (link.kind) {
+            .explicit => try result.startHyperlink(link.uri, link.explicitId.?),
+            .implicit => {
+                result.cursor.hyperlink_implicit_id = link.implicitId.?;
+                try result.startHyperlink(link.uri, null);
+            },
+        }
+        result.cursor.hyperlink_implicit_id = state.cursor.hyperlinkImplicitCounter;
+    }
+    result.pages.assertIntegrity();
+    result.assertIntegrity();
+    owned_pages = undefined;
+    return result;
+}
