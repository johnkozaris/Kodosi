+//! Owned, portable JSON encoding for terminal-wide semantic checkpoint state.
+//!
+//! This module deliberately stops at the screen boundary. Screen/page data and
+//! parser continuation are supplied by the containing checkpoint transaction.
+//! Decoding creates a new native Terminal; callers retain ownership until the
+//! complete transaction has validated and may then publish it atomically.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const ansi = @import("ansi.zig");
+const build_options = @import("terminal_options");
+const color = @import("color.zig");
+const modes = @import("modes.zig");
+const mouse = @import("mouse.zig");
+const osc = @import("osc.zig");
+const Screen = @import("Screen.zig");
+const ScreenSet = @import("ScreenSet.zig");
+const Tabstops = @import("Tabstops.zig");
+const Terminal = @import("Terminal.zig");
+
+pub const schema = "kodosi-terminal-wide-checkpoint";
+pub const version: u16 = 1;
+pub const mode_count = 43;
+pub const original_palette_count = 256;
+pub const max_pwd_bytes = 4096;
+pub const max_title_bytes = 1024;
+
+/// Decoder resource policy. These limits are caller policy, not wire fields.
+pub const Limits = struct {
+    max_document_bytes: usize = 1024 * 1024,
+    max_string_bytes: usize = 4096,
+    max_cells: usize = 16 * 1024 * 1024,
+};
+
+pub const Error = error{
+    DocumentTooLarge,
+    WrongSchema,
+    UnsupportedVersion,
+    InvalidDimensions,
+    InvalidMargins,
+    InvalidScreenRouting,
+    InvalidTabStop,
+    InvalidModeSet,
+    InvalidEnum,
+    InvalidCodepoint,
+    InvalidCursor,
+    InvalidPalette,
+    InvalidString,
+    InvalidScrollbackLimit,
+    UnsupportedGraphics,
+};
+
+pub const ScreenId = enum(u8) {
+    primary = 1,
+    alternate = 2,
+};
+
+pub const StatusDisplayId = enum(u8) {
+    main = 1,
+    status_line = 2,
+};
+
+pub const CursorStyleId = enum(u8) {
