+pub fn constructionOptions(self: *const PageList) Options {
+    return .{
+        .cols = self.cols,
+        .rows = self.rows,
+        .max_size = if (self.limits.bytes.explicit == std.math.maxInt(usize))
+            null
+        else
+            self.limits.bytes.explicit,
+        .max_lines = if (self.limits.lines.explicit == std.math.maxInt(usize))
+            null
+        else
+            self.limits.lines.explicit,
+    };
+}
+
 /// Change the maximum logical page allocation at runtime. Null removes the
 /// explicit byte limit and zero disables scrollback.
 ///
