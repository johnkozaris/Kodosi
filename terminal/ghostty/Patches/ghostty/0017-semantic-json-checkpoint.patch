+pub const Graphics = struct {
+    kitty_images: u32,
+    kitty_placements: u32,
+    kitty_loading: bool,
+    glyphs: u32,
+};
+
+/// Exact version-1 wire object. Unknown, duplicate, and missing fields fail in
+/// std.json before semantic validation runs.
+pub const Document = struct {
+    schema: []const u8,
+    version: u16,
+    dimensions: Dimensions,
+    margins: Margins,
+    status_display: u8,
+    screens: ScreenRouting,
+    tab_stops: []const u16,
+    modes: ModeSets,
+    effective_mouse: EffectiveMouse,
+    previous_printable: ?u32,
+    cursor_defaults: CursorDefaults,
+    flags: Flags,
+    mouse_shape: u8,
+    colors: Colors,
+    text: Text,
+    scrollback: Scrollback,
+    graphics: Graphics,
+};
+
+/// Owns all slices in a decoded document.
+pub const Decoded = struct {
+    parsed: std.json.Parsed(Document),
+
+    pub fn deinit(self: Decoded) void {
+        self.parsed.deinit();
+    }
+
+    pub fn document(self: *const Decoded) *const Document {
+        return &self.parsed.value;
+    }
+
+    /// Construct a complete, independent native Terminal. No existing terminal
+    /// is accepted or mutated. The caller owns the result and must deinit it.
+    pub fn createTerminal(
+        self: *const Decoded,
+        io: std.Io,
+        alloc: Allocator,
+    ) !Terminal {
+        return documentToTerminal(&self.parsed.value, io, alloc);
+    }
+};
+
+/// Parse and semantically validate an exact version-1 JSON document.
+pub fn decode(
+    alloc: Allocator,
+    bytes: []const u8,
+    limits: Limits,
+) !Decoded {
+    if (bytes.len > limits.max_document_bytes) return error.DocumentTooLarge;
+    var parsed = try std.json.parseFromSlice(Document, alloc, bytes, .{
+        .duplicate_field_behavior = .@"error",
+        .ignore_unknown_fields = false,
+        .max_value_len = limits.max_string_bytes,
+        .allocate = .alloc_always,
+    });
+    errdefer parsed.deinit();
+    try validate(&parsed.value, limits);
+    return .{ .parsed = parsed };
+}
+
+pub fn capture(alloc: Allocator, terminal: *const Terminal) !std.json.Parsed(Document) {
+    const bytes = try encodeAlloc(alloc, terminal);
+    defer alloc.free(bytes);
+    return std.json.parseFromSlice(Document, alloc, bytes, .{
+        .duplicate_field_behavior = .@"error",
+        .ignore_unknown_fields = false,
+        .allocate = .alloc_always,
+    });
+}
+
+/// Encode canonical minified JSON directly from native terminal-wide state.
+pub fn encode(terminal: *const Terminal, writer: *std.Io.Writer) !void {
+    try validateNativeGraphics(terminal);
+    try validateNative(terminal);
+
+    var json: std.json.Stringify = .{ .writer = writer };
+    try json.beginObject();
+    try field(&json, "schema", schema);
+    try field(&json, "version", version);
+
+    try json.objectField("dimensions");
+    try json.beginObject();
+    try field(&json, "columns", terminal.cols);
+    try field(&json, "rows", terminal.rows);
+    try field(&json, "width_px", terminal.width_px);
+    try field(&json, "height_px", terminal.height_px);
+    try json.endObject();
+
+    try json.objectField("margins");
+    try json.beginObject();
+    try field(&json, "top", terminal.scrolling_region.top);
+    try field(&json, "bottom", terminal.scrolling_region.bottom);
+    try field(&json, "left", terminal.scrolling_region.left);
+    try field(&json, "right", terminal.scrolling_region.right);
+    try json.endObject();
+
+    try field(&json, "status_display", statusDisplayToWire(terminal.status_display));
+
+    try json.objectField("screens");
+    try json.beginObject();
+    try json.objectField("initialized");
+    try json.beginArray();
+    try json.write(@intFromEnum(ScreenId.primary));
+    if (terminal.screens.get(.alternate) != null) {
+        try json.write(@intFromEnum(ScreenId.alternate));
+    }
+    try json.endArray();
+    try field(&json, "active", screenToWire(terminal.screens.active_key));
+    try json.endObject();
+
+    try json.objectField("tab_stops");
+    try json.beginArray();
+    for (0..terminal.cols) |column| {
+        if (terminal.tabstops.get(column)) try json.write(column);
+    }
+    try json.endArray();
+
+    try json.objectField("modes");
+    try json.beginObject();
+    try writeModeSet(&json, "current", terminal.modes.values);
+    try writeModeSet(&json, "saved", terminal.modes.saved);
+    try writeModeSet(&json, "default", terminal.modes.default);
+    try json.endObject();
+
+    try json.objectField("effective_mouse");
+    try json.beginObject();
+    try field(&json, "event", mouseEventToWire(terminal.flags.mouse_event));
+    try field(&json, "format", mouseFormatToWire(terminal.flags.mouse_format));
+    try json.endObject();
+
+    try field(&json, "previous_printable", terminal.previous_char);
+
+    try json.objectField("cursor_defaults");
+    try json.beginObject();
+    try field(&json, "is_default", terminal.cursor.is_default);
+    try field(&json, "style", cursorStyleToWire(terminal.cursor.default_style));
+    try field(&json, "blink", terminal.cursor.default_blink);
+    try json.endObject();
+
+    try json.objectField("flags");
+    try json.beginObject();
+    try field(&json, "modify_other_keys_2", terminal.flags.modify_other_keys_2);
+    try field(&json, "mouse_shift_capture", mouseShiftToOptional(terminal.flags.mouse_shift_capture));
+    try field(&json, "focused", terminal.flags.focused);
+    try field(&json, "visible", terminal.flags.visible);
+    try field(&json, "password_input", terminal.flags.password_input);
+    try field(&json, "shell_redraw", shellRedrawToWire(terminal.flags.shell_redraws_prompt));
+    try json.endObject();
+
+    try field(&json, "mouse_shape", mouseShapeToWire(terminal.mouse_shape));
+
+    try json.objectField("colors");
+    try json.beginObject();
+    try writeDynamicRGB(&json, "foreground", terminal.colors.foreground);
+    try writeDynamicRGB(&json, "background", terminal.colors.background);
+    try writeDynamicRGB(&json, "cursor", terminal.colors.cursor);
+    try json.objectField("original_palette");
+    try json.beginArray();
+    for (terminal.colors.palette.original) |value| try writeRGB(&json, value);
+    try json.endArray();
+    try json.objectField("palette_overrides");
+    try json.beginArray();
+    for (terminal.colors.palette.current, 0..) |value, index| {
+        if (!terminal.colors.palette.mask.isSet(index)) continue;
+        try json.beginObject();
+        try field(&json, "index", index);
+        try json.objectField("color");
+        try writeRGB(&json, value);
+        try json.endObject();
+    }
+    try json.endArray();
+    try json.endObject();
+
+    try json.objectField("text");
+    try json.beginObject();
+    try json.objectField("pwd");
+    try writeBytes(&json, terminal.getPwd() orelse &.{});
+    try json.objectField("title");
+    try writeBytes(&json, terminal.getTitle() orelse &.{});
+    try json.endObject();
+
+    const primary = terminal.screens.get(.primary).?;
+    try json.objectField("scrollback");
+    try json.beginObject();
+    try field(&json, "max_bytes", nativeLimitToWire(primary.pages.limits.bytes.explicit));
+    try field(&json, "max_lines", nativeLimitToWire(primary.pages.limits.lines.explicit));
+    try json.endObject();
+
+    try json.objectField("graphics");
+    try json.beginObject();
+    try field(&json, "kitty_images", @as(u32, 0));
+    try field(&json, "kitty_placements", @as(u32, 0));
+    try field(&json, "kitty_loading", false);
+    try field(&json, "glyphs", @as(u32, 0));
+    try json.endObject();
+    try json.endObject();
+}
+
+/// Encode into an allocator-owned canonical JSON byte slice.
+pub fn encodeAlloc(alloc: Allocator, terminal: *const Terminal) ![]u8 {
+    var result: std.Io.Writer.Allocating = .init(alloc);
+    errdefer result.deinit();
+    try encode(terminal, &result.writer);
+    return result.toOwnedSlice();
+}
+
+pub fn validate(document: *const Document, limits: Limits) !void {
+    if (!std.mem.eql(u8, document.schema, schema)) return error.WrongSchema;
+    if (document.version != version) return error.UnsupportedVersion;
+    if (document.dimensions.columns == 0 or document.dimensions.rows == 0) {
+        return error.InvalidDimensions;
+    }
+    const cells = std.math.mul(
+        usize,
+        document.dimensions.columns,
+        document.dimensions.rows,
+    ) catch return error.InvalidDimensions;
+    if (cells > limits.max_cells) return error.InvalidDimensions;
+    if (document.margins.top > document.margins.bottom or
+        document.margins.bottom >= document.dimensions.rows or
+        document.margins.left > document.margins.right or
+        document.margins.right >= document.dimensions.columns)
+    {
+        return error.InvalidMargins;
+    }
+    _ = statusDisplayFromWire(document.status_display) orelse return error.InvalidEnum;
+    try validateScreens(document.screens);
+    try validateSortedUniqueRange(u16, document.tab_stops, document.dimensions.columns, error.InvalidTabStop);
+    try validateModeSet(document.modes.current);
+    try validateModeSet(document.modes.saved);
+    try validateModeSet(document.modes.default);
+    _ = mouseEventFromWire(document.effective_mouse.event) orelse return error.InvalidEnum;
+    _ = mouseFormatFromWire(document.effective_mouse.format) orelse return error.InvalidEnum;
+    if (document.previous_printable) |cp| try validateCodepoint(cp);
+    _ = cursorStyleFromWire(document.cursor_defaults.style) orelse return error.InvalidCursor;
+    _ = shellRedrawFromWire(document.flags.shell_redraw) orelse return error.InvalidEnum;
+    _ = mouseShapeFromWire(document.mouse_shape) orelse return error.InvalidEnum;
+    if (document.colors.original_palette.len != original_palette_count) return error.InvalidPalette;
+    var previous_override: ?u8 = null;
+    for (document.colors.palette_overrides) |entry| {
+        if (previous_override) |previous| {
+            if (entry.index <= previous) return error.InvalidPalette;
+        }
+        previous_override = entry.index;
+    }
+    if (document.text.pwd.len > limits.max_string_bytes or
+        document.text.title.len > limits.max_string_bytes or
+        document.text.pwd.len > max_pwd_bytes or document.text.title.len > max_title_bytes)
+    {
+        return error.InvalidString;
+    }
+    if (document.scrollback.max_bytes == std.math.maxInt(u64) or
+        document.scrollback.max_lines == std.math.maxInt(u64))
+    {
+        return error.InvalidScrollbackLimit;
+    }
+    if (document.graphics.kitty_images != 0 or
+        document.graphics.kitty_placements != 0 or
+        document.graphics.kitty_loading or
+        document.graphics.glyphs != 0)
+    {
+        return error.UnsupportedGraphics;
+    }
+}
+
+pub fn createTerminal(document: *const Document, io: std.Io, alloc: Allocator) !Terminal {
+    return documentToTerminal(document, io, alloc);
+}
+
+fn documentToTerminal(document: *const Document, io: std.Io, alloc: Allocator) !Terminal {
+    const default_modes = try modeSetFromWire(document.modes.default);
+    const original = paletteFromWire(document.colors.original_palette);
+    var palette: color.DynamicPalette = try .init(alloc, original);
+    var palette_owned = true;
+    errdefer if (palette_owned) palette.deinit(alloc);
+    for (document.colors.palette_overrides) |entry| {
+        palette.set(entry.index, rgbFromWire(entry.color));
+    }
+
+    var terminal = try Terminal.init(io, alloc, .{
+        .cols = document.dimensions.columns,
+        .rows = document.dimensions.rows,
+        .max_scrollback_bytes = try limitFromWire(document.scrollback.max_bytes),
+        .max_scrollback_lines = try limitFromWire(document.scrollback.max_lines),
+        .colors = .{
+            .foreground = dynamicRGBFromWire(document.colors.foreground),
+            .background = dynamicRGBFromWire(document.colors.background),
+            .cursor = dynamicRGBFromWire(document.colors.cursor),
+            .palette = palette,
+        },
+        .default_modes = default_modes,
+        .default_cursor_style = cursorStyleFromWire(document.cursor_defaults.style).?,
+        .default_cursor_blink = document.cursor_defaults.blink,
+    });
+    palette_owned = false;
+    errdefer terminal.deinit(alloc);
+
+    if (document.screens.initialized.len == 2) {
+        _ = try terminal.screens.getInit(io, alloc, .alternate, .{
+            .cols = document.dimensions.columns,
+            .rows = document.dimensions.rows,
+            .max_scrollback_bytes = 0,
+        });
+    }
+    terminal.screens.switchTo(screenFromWire(document.screens.active).?);
+    terminal.width_px = document.dimensions.width_px;
+    terminal.height_px = document.dimensions.height_px;
+    terminal.scrolling_region = .{
+        .top = document.margins.top,
+        .bottom = document.margins.bottom,
+        .left = document.margins.left,
+        .right = document.margins.right,
+    };
+    terminal.status_display = statusDisplayFromWire(document.status_display).?;
+    terminal.tabstops.reset(0);
+    for (document.tab_stops) |column| terminal.tabstops.set(column);
+    terminal.modes = .{
+        .values = try modeSetFromWire(document.modes.current),
+        .saved = try modeSetFromWire(document.modes.saved),
+        .default = default_modes,
+    };
+    terminal.previous_char = if (document.previous_printable) |cp| @intCast(cp) else null;
+    terminal.cursor = .{
+        .is_default = document.cursor_defaults.is_default,
+        .default_style = cursorStyleFromWire(document.cursor_defaults.style).?,
+        .default_blink = document.cursor_defaults.blink,
+    };
+    terminal.flags.modify_other_keys_2 = document.flags.modify_other_keys_2;
+    terminal.flags.mouse_shift_capture = if (document.flags.mouse_shift_capture) |value|
+        if (value) .true else .false
+    else
+        .null;
+    terminal.flags.focused = document.flags.focused;
+    terminal.flags.visible = document.flags.visible;
+    terminal.flags.password_input = document.flags.password_input;
+    terminal.flags.shell_redraws_prompt = shellRedrawFromWire(document.flags.shell_redraw).?;
+    terminal.flags.mouse_event = mouseEventFromWire(document.effective_mouse.event).?;
+    terminal.flags.mouse_format = mouseFormatFromWire(document.effective_mouse.format).?;
+    terminal.mouse_shape = mouseShapeFromWire(document.mouse_shape).?;
+    try terminal.setPwd(document.text.pwd);
+    try terminal.setTitle(document.text.title);
+    return terminal;
+}
+
+fn validateNative(terminal: *const Terminal) !void {
+    if (terminal.cols == 0 or terminal.rows == 0) return error.InvalidDimensions;
+    if (terminal.scrolling_region.top > terminal.scrolling_region.bottom or
+        terminal.scrolling_region.bottom >= terminal.rows or
+        terminal.scrolling_region.left > terminal.scrolling_region.right or
+        terminal.scrolling_region.right >= terminal.cols)
+    {
+        return error.InvalidMargins;
+    }
+    if (terminal.previous_char) |cp| try validateCodepoint(cp);
+    const primary = terminal.screens.get(.primary) orelse return error.InvalidScreenRouting;
+    _ = primary;
+    if (terminal.screens.active_key == .alternate and terminal.screens.get(.alternate) == null) {
+        return error.InvalidScreenRouting;
+    }
+    const pwd_len = if (terminal.getPwd()) |value| value.len else 0;
+    const title_len = if (terminal.getTitle()) |value| value.len else 0;
+    if (pwd_len > max_pwd_bytes or title_len > max_title_bytes) {
+        return error.InvalidString;
+    }
+    for (terminal.colors.palette.original, terminal.colors.palette.current, 0..) |original, current, index| {
+        if (!terminal.colors.palette.mask.isSet(index) and !original.eql(current)) {
+            return error.InvalidPalette;
+        }
+    }
+}
+
+fn validateNativeGraphics(terminal: *const Terminal) !void {
+    if (!terminal.glyph_glossary.isEmpty()) return error.UnsupportedGraphics;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            const screen = terminal.screens.get(key) orelse continue;
+            if (!screen.kitty_images.isEmpty()) return error.UnsupportedGraphics;
+        }
+    }
+}
+
+fn validateScreens(value: ScreenRouting) !void {
+    if (value.initialized.len < 1 or value.initialized.len > 2) return error.InvalidScreenRouting;
+    if (value.initialized[0] != @intFromEnum(ScreenId.primary)) return error.InvalidScreenRouting;
+    if (value.initialized.len == 2 and value.initialized[1] != @intFromEnum(ScreenId.alternate)) {
+        return error.InvalidScreenRouting;
+    }
+    const active = screenFromWire(value.active) orelse return error.InvalidScreenRouting;
+    if (active == .alternate and value.initialized.len != 2) return error.InvalidScreenRouting;
+}
+
+fn validateSortedUniqueRange(comptime T: type, values: []const T, max_exclusive: T, failure: anyerror) !void {
+    var previous: ?T = null;
+    for (values) |value| {
+        if (value >= max_exclusive) return failure;
+        if (previous) |prior| if (value <= prior) return failure;
+        previous = value;
+    }
+}
+
+fn validateModeSet(values: []const u8) !void {
+    var previous: u8 = 0;
+    for (values) |raw| {
+        if (raw <= previous or raw > mode_count) return error.InvalidModeSet;
+        if (std.enums.fromInt(ModeId, raw) == null) return error.InvalidModeSet;
+        previous = raw;
+    }
+}
+
+fn validateCodepoint(cp: u32) !void {
+    if (cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff)) return error.InvalidCodepoint;
+}
+
+fn field(json: *std.json.Stringify, name: []const u8, value: anytype) !void {
+    try json.objectField(name);
+    try json.write(value);
+}
+
+fn writeBytes(json: *std.json.Stringify, bytes: []const u8) !void {
+    try json.beginArray();
+    for (bytes) |byte| try json.write(byte);
+    try json.endArray();
+}
+
+fn writeRGB(json: *std.json.Stringify, value: color.RGB) !void {
+    try json.beginObject();
+    try field(json, "r", value.r);
+    try field(json, "g", value.g);
+    try field(json, "b", value.b);
+    try json.endObject();
+}
+
+fn writeDynamicRGB(json: *std.json.Stringify, name: []const u8, value: color.DynamicRGB) !void {
+    try json.objectField(name);
+    try json.beginObject();
+    try json.objectField("default");
+    if (value.default) |rgb| try writeRGB(json, rgb) else try json.write(null);
+    try json.objectField("override");
+    if (value.override) |rgb| try writeRGB(json, rgb) else try json.write(null);
+    try json.endObject();
+}
+
+fn writeModeSet(json: *std.json.Stringify, name: []const u8, packed_modes: modes.ModePacked) !void {
+    try json.objectField(name);
+    try json.beginArray();
+    inline for (mode_registry) |entry| {
+        if (@field(packed_modes, entry.native_name)) try json.write(@intFromEnum(entry.id));
+    }
+    try json.endArray();
+}
+
+const ModeRegistryEntry = struct { id: ModeId, native_name: []const u8 };
+const mode_registry = [_]ModeRegistryEntry{
+    .{ .id = .disable_keyboard, .native_name = "disable_keyboard" },
+    .{ .id = .insert, .native_name = "insert" },
+    .{ .id = .send_receive_mode, .native_name = "send_receive_mode" },
+    .{ .id = .linefeed, .native_name = "linefeed" },
+    .{ .id = .cursor_keys, .native_name = "cursor_keys" },
+    .{ .id = .column_132, .native_name = "132_column" },
+    .{ .id = .slow_scroll, .native_name = "slow_scroll" },
+    .{ .id = .reverse_colors, .native_name = "reverse_colors" },
+    .{ .id = .origin, .native_name = "origin" },
+    .{ .id = .wraparound, .native_name = "wraparound" },
+    .{ .id = .autorepeat, .native_name = "autorepeat" },
+    .{ .id = .mouse_event_x10, .native_name = "mouse_event_x10" },
+    .{ .id = .cursor_blinking, .native_name = "cursor_blinking" },
+    .{ .id = .cursor_visible, .native_name = "cursor_visible" },
+    .{ .id = .enable_mode_3, .native_name = "enable_mode_3" },
+    .{ .id = .reverse_wrap, .native_name = "reverse_wrap" },
+    .{ .id = .alt_screen_legacy, .native_name = "alt_screen_legacy" },
+    .{ .id = .keypad_keys, .native_name = "keypad_keys" },
+    .{ .id = .backarrow_key_mode, .native_name = "backarrow_key_mode" },
+    .{ .id = .enable_left_and_right_margin, .native_name = "enable_left_and_right_margin" },
+    .{ .id = .mouse_event_normal, .native_name = "mouse_event_normal" },
+    .{ .id = .mouse_event_button, .native_name = "mouse_event_button" },
+    .{ .id = .mouse_event_any, .native_name = "mouse_event_any" },
+    .{ .id = .focus_event, .native_name = "focus_event" },
+    .{ .id = .mouse_format_utf8, .native_name = "mouse_format_utf8" },
+    .{ .id = .mouse_format_sgr, .native_name = "mouse_format_sgr" },
+    .{ .id = .mouse_alternate_scroll, .native_name = "mouse_alternate_scroll" },
+    .{ .id = .mouse_format_urxvt, .native_name = "mouse_format_urxvt" },
+    .{ .id = .mouse_format_sgr_pixels, .native_name = "mouse_format_sgr_pixels" },
+    .{ .id = .ignore_keypad_with_numlock, .native_name = "ignore_keypad_with_numlock" },
+    .{ .id = .alt_esc_prefix, .native_name = "alt_esc_prefix" },
+    .{ .id = .alt_sends_escape, .native_name = "alt_sends_escape" },
+    .{ .id = .reverse_wrap_extended, .native_name = "reverse_wrap_extended" },
+    .{ .id = .alt_screen, .native_name = "alt_screen" },
+    .{ .id = .save_cursor, .native_name = "save_cursor" },
+    .{ .id = .alt_screen_save_cursor_clear_enter, .native_name = "alt_screen_save_cursor_clear_enter" },
+    .{ .id = .bracketed_paste, .native_name = "bracketed_paste" },
+    .{ .id = .synchronized_output, .native_name = "synchronized_output" },
+    .{ .id = .grapheme_cluster, .native_name = "grapheme_cluster" },
+    .{ .id = .report_color_scheme, .native_name = "report_color_scheme" },
+    .{ .id = .report_visibility, .native_name = "report_visibility" },
+    .{ .id = .in_band_size_reports, .native_name = "in_band_size_reports" },
+    .{ .id = .kitty_paste_events, .native_name = "kitty_paste_events" },
+};
+
+comptime {
+    @setEvalBranchQuota(10_000);
+    std.debug.assert(mode_registry.len == mode_count);
+    const native_fields = @typeInfo(modes.ModePacked).@"struct".fields;
+    std.debug.assert(native_fields.len == mode_registry.len);
+    for (mode_registry, 1..) |entry, id| {
+        std.debug.assert(@intFromEnum(entry.id) == id);
+        var native_match_count: usize = 0;
+        for (native_fields) |native| {
+            if (std.mem.eql(u8, native.name, entry.native_name)) native_match_count += 1;
+        }
+        std.debug.assert(native_match_count == 1);
+    }
+    for (native_fields) |native| {
+        var wire_match_count: usize = 0;
+        for (mode_registry) |entry| {
+            if (std.mem.eql(u8, native.name, entry.native_name)) wire_match_count += 1;
+        }
+        std.debug.assert(wire_match_count == 1);
+    }
+}
+
+fn modeSetFromWire(values: []const u8) !modes.ModePacked {
+    var result = std.mem.zeroes(modes.ModePacked);
+    for (values) |raw| {
+        const id = std.enums.fromInt(ModeId, raw) orelse return error.InvalidModeSet;
+        inline for (mode_registry) |entry| {
+            if (id == entry.id) @field(result, entry.native_name) = true;
+        }
+    }
+    return result;
+}
+
+fn rgbFromWire(value: RGB) color.RGB {
