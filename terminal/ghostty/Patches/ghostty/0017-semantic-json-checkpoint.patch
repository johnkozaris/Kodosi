+    pub fn validate(self: ScreenState, cols: u16, rows: u16) ValidationError!void {
+        if (self.schemaVersion != schema_version) return error.InvalidSchemaVersion;
+        try validateDimensions(cols, rows);
+        if (self.cursor.x >= cols or self.cursor.y >= rows) return error.InvalidCursor;
+        if (self.cursor.pendingWrap and self.cursor.x != cols - 1) {
+            return error.InvalidCursor;
+        }
+        _ = try self.cursor.pen.native();
+        if (self.cursor.activeHyperlink) |link| try link.validate();
+        if (self.savedCursor) |saved| try saved.validate(cols, rows);
+        try self.kittyKeyboard.validate();
+    }
+};
