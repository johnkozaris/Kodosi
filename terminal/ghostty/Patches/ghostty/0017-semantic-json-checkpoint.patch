+    all_scroll = 18,
+    col_resize = 19,
+    row_resize = 20,
+    n_resize = 21,
+    e_resize = 22,
+    s_resize = 23,
+    w_resize = 24,
+    ne_resize = 25,
+    nw_resize = 26,
+    se_resize = 27,
