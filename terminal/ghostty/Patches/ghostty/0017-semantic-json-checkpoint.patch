+/// Build a complete routed ScreenSet transactionally from screen DTOs.
+///
+/// Pages are blank at this layer. A later page codec can use `restoreScreen`
+/// directly and replace the blank page lists before assembling its own set.
+pub fn restoreScreenSet(
+    io: std.Io,
+    alloc: Allocator,
+    options: Screen.Options,
+    terminal_state: TerminalState,
+    states: []const ScreenState,
+) RestoreError!ScreenSet {
+    try terminal_state.validate();
+    const expected_count: usize = if (terminal_state.screens.alternate) 2 else 1;
+    if (states.len != expected_count) {
+        return error.InvalidScreenRouting;
+    }
+
+    var primary_state: ?ScreenState = null;
+    var alternate_state: ?ScreenState = null;
+    for (states) |state| switch (state.key) {
+        .primary => {
+            if (primary_state != null) return error.DuplicateScreen;
+            primary_state = state;
+        },
+        .alternate => {
+            if (alternate_state != null) return error.DuplicateScreen;
+            alternate_state = state;
+        },
+    };
+    if (primary_state == null) return error.MissingScreen;
+    if (terminal_state.screens.alternate != (alternate_state != null)) {
+        return error.InvalidScreenRouting;
+    }
+
+    const primary = try alloc.create(Screen);
+    errdefer alloc.destroy(primary);
+    primary.* = try restoreScreen(io, alloc, options, primary_state.?);
+    errdefer primary.deinit();
+
+    const alternate: ?*Screen = if (alternate_state) |state| alternate: {
+        const value = try alloc.create(Screen);
+        errdefer alloc.destroy(value);
+        value.* = try restoreScreen(io, alloc, options, state);
+        break :alternate value;
+    } else null;
+    errdefer if (alternate) |value| {
+        value.deinit();
+        alloc.destroy(value);
+    };
+
+    var all: std.EnumMap(ScreenSet.Key, *Screen) = .init(.{ .primary = primary });
+    if (alternate) |value| all.put(.alternate, value);
+    const active = switch (terminal_state.activeScreen) {
+        .primary => primary,
+        .alternate => alternate orelse return error.InvalidScreenRouting,
+    };
+
+    return .{
+        .active_key = terminal_state.activeScreen.native(),
+        .active = active,
+        .all = all,
+        .generations = .initFull(0),
+    };
+}
