diff --git a/src/terminal/c/checkpoint.zig b/src/terminal/c/checkpoint.zig
new file mode 100644
index 000000000..583e1aa01
--- /dev/null
+++ b/src/terminal/c/checkpoint.zig
@@ -0,0 +1,1261 @@
+//! Stable C ABI wrapper for owned JSON semantic checkpoints.
+
+const std = @import("std");
+const testing = std.testing;
+const build_options = @import("terminal_options");
+const lib = @import("../lib.zig");
+const CAllocator = lib.alloc.Allocator;
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+const formatter_c = @import("formatter.zig");
+const grid_ref_tracked_c = @import("grid_ref_tracked.zig");
+const selection_gesture_c = @import("selection_gesture.zig");
+const point = @import("../point.zig");
+const terminal_wide = @import("../checkpoint_json.zig");
+const screen_core = @import("../checkpoint_screen_json.zig");
+const page_core = @import("../checkpoint_page_json.zig");
+const stream_continuation = @import("../stream_continuation.zig");
+
+pub const schema_version = screen_core.schema_version;
+
+pub const Limits = extern struct {
+    size: usize = @sizeOf(Limits),
+    max_json_bytes: usize = screen_core.limits.max_json_bytes,
+    max_string_bytes: usize = screen_core.limits.max_json_bytes,
+    max_continuation_bytes: usize = screen_core.limits.max_continuation_bytes,
+    max_cells: usize = @as(usize, screen_core.limits.max_dimension) * screen_core.limits.max_dimension,
+};
+
+pub const EncodeOptions = extern struct {
+    size: usize = @sizeOf(EncodeOptions),
+    limits: Limits = .{},
+};
+
+pub const RestoreOptions = extern struct {
+    size: usize = @sizeOf(RestoreOptions),
+    limits: Limits = .{},
+};
+
+pub const Info = extern struct {
+    size: usize = @sizeOf(Info),
+    schema_version: u32 = schema_version,
+    json_bytes: usize = 0,
+    continuation_bytes: usize = 0,
+};
+
+pub const InfoOutput = struct {
+    ptr: *Info,
+    size: usize,
+};
+
+pub const ScreenEnvelope = struct {
+    state: screen_core.ScreenState,
+    grid: page_core.Document,
+};
+
+pub const Envelope = struct {
+    schemaVersion: u32 = schema_version,
+    terminal: std.json.Value,
+    routing: screen_core.TerminalState,
+    screens: []const ScreenEnvelope,
+    parser: screen_core.ParserState,
+};
+
+pub fn schema() callconv(lib.calling_conv) u32 {
+    return schema_version;
+}
+
+pub fn encode_buf(
+    terminal: terminal_c.Terminal,
+    options_: ?*const EncodeOptions,
+    buffer_: ?*lib.Buffer,
+    info_: ?*Info,
+) callconv(lib.calling_conv) Result {
+    const info = prepareInfo(info_) catch return .invalid_value;
+    const buffer = buffer_ orelse return .invalid_value;
+    buffer.len = 0;
+    const wrapper = terminal orelse return .invalid_value;
+    const options = options_ orelse return .invalid_value;
+    if (!validSize(options.size, EncodeOptions) or !validLimits(options.limits)) return .invalid_value;
+    if (buffer.ptr == null and buffer.cap != 0) return .invalid_value;
+
+    var writer: std.Io.Writer = .fixed(if (buffer.ptr) |ptr| ptr[0..buffer.cap] else &.{});
+    const result = encodeStream(wrapper.terminal.gpa(), wrapper.terminal, &wrapper.stream, options.limits, &writer, info) catch |err| switch (err) {
+        error.WriteFailed => {
+            var counter: std.Io.Writer.Discarding = .init(&.{});
+            _ = encodeStream(wrapper.terminal.gpa(), wrapper.terminal, &wrapper.stream, options.limits, &counter.writer, null) catch |count_err| return mapError(count_err);
+            buffer.len = std.math.cast(usize, counter.count) orelse return .limit_exceeded;
+            return .out_of_space;
+        },
+        else => return mapError(err),
+    };
+    _ = result;
+    buffer.len = writer.end;
+    return .success;
+}
+
+pub fn encode_alloc(
+    terminal: terminal_c.Terminal,
+    options_: ?*const EncodeOptions,
+    allocator_: ?*const CAllocator,
+    out_ptr_: ?*?[*]u8,
+    out_len_: ?*usize,
+    info_: ?*Info,
+) callconv(lib.calling_conv) Result {
+    const info = prepareInfo(info_) catch return .invalid_value;
+    const out_ptr = out_ptr_ orelse return .invalid_value;
+    const out_len = out_len_ orelse return .invalid_value;
+    out_ptr.* = null;
+    out_len.* = 0;
+    const wrapper = terminal orelse return .invalid_value;
+    const options = options_ orelse return .invalid_value;
+    if (!validSize(options.size, EncodeOptions) or !validLimits(options.limits)) return .invalid_value;
+
+    const alloc = lib.alloc.default(allocator_);
+    var writer: std.Io.Writer.Allocating = .init(alloc);
+    defer writer.deinit();
+    _ = encodeStream(wrapper.terminal.gpa(), wrapper.terminal, &wrapper.stream, options.limits, &writer.writer, info) catch |err| return mapError(err);
+    const bytes = writer.toOwnedSlice() catch return .out_of_memory;
+    out_ptr.* = bytes.ptr;
+    out_len.* = bytes.len;
+    return .success;
+}
+
+pub fn encodeStream(
+    alloc: std.mem.Allocator,
+    terminal: *const @import("../Terminal.zig"),
+    stream: anytype,
+    limits: Limits,
+    writer: *std.Io.Writer,
+    info: ?InfoOutput,
+) !void {
+    const wide_bytes = try terminal_wide.encodeAlloc(alloc, terminal);
+    defer alloc.free(wide_bytes);
+    var wide = try std.json.parseFromSlice(std.json.Value, alloc, wide_bytes, .{});
+    defer wide.deinit();
+    const routing = screen_core.TerminalState.capture(terminal);
+    var primary_state = try screen_core.captureScreen(alloc, .primary, terminal.screens.get(.primary).?);
+    defer primary_state.deinit(alloc);
+    var primary_grid = try page_core.capture(alloc, &terminal.screens.get(.primary).?.pages, pageLimits(limits));
+    defer primary_grid.deinit();
+
+    var alternate_state: ?screen_core.ScreenState = null;
+    defer if (alternate_state) |*value| value.deinit(alloc);
+    var alternate_grid: ?page_core.Captured = null;
+    defer if (alternate_grid) |*value| value.deinit();
+    if (terminal.screens.get(.alternate)) |screen| {
+        alternate_state = try screen_core.captureScreen(alloc, .alternate, screen);
+        alternate_grid = try page_core.capture(alloc, &screen.pages, pageLimits(limits));
+    }
+    var parser = if (stream.continuation == null and stream.ground()) parser: {
+        break :parser screen_core.ParserState{ .bytes = try alloc.dupe(u8, "") };
+    } else try screen_core.captureParser(
+        alloc,
+        stream,
+        limits.max_continuation_bytes,
+    );
+    defer parser.deinit(alloc);
+    const continuation_len = try decodedContinuationLen(parser);
+    if (continuation_len > limits.max_continuation_bytes) return error.LimitExceeded;
+
+    const screens: []const ScreenEnvelope = if (alternate_state) |alternate|
+        &.{
+            .{ .state = primary_state, .grid = primary_grid.value },
+            .{ .state = alternate, .grid = alternate_grid.?.value },
+        }
+    else
+        &.{.{ .state = primary_state, .grid = primary_grid.value }};
+    const envelope: Envelope = .{
+        .terminal = wide.value,
+        .routing = routing,
+        .screens = screens,
+        .parser = parser,
+    };
+
+    var encoded: std.Io.Writer.Allocating = .init(alloc);
+    defer encoded.deinit();
+    var stringify: std.json.Stringify = .{ .writer = &encoded.writer };
+    try stringify.write(envelope);
+    if (encoded.written().len > limits.max_json_bytes) return error.LimitExceeded;
+    try writer.writeAll(encoded.written());
+    writeInfo(info, .{
+        .json_bytes = encoded.written().len,
+        .continuation_bytes = continuation_len,
+    });
+}
+
+pub fn restore(
+    terminal: terminal_c.Terminal,
+    json_ptr: ?[*]const u8,
+    json_len: usize,
+    options_: ?*const RestoreOptions,
+    info_: ?*Info,
+) callconv(lib.calling_conv) Result {
+    const info = prepareInfo(info_) catch return .invalid_value;
+    const wrapper = terminal orelse return .invalid_value;
+    const options = options_ orelse return .invalid_value;
+    if (!validSize(options.size, RestoreOptions) or !validLimits(options.limits)) return .invalid_value;
+    const json = if (json_ptr) |ptr| ptr[0..json_len] else if (json_len == 0) &.{} else return .invalid_value;
+    if (json.len > options.limits.max_json_bytes) return .limit_exceeded;
+
+    restoreIo(wrapper, json, options.limits, info) catch |err| return mapError(err);
+    return .success;
+}
+
+pub fn constructTerminal(
+    alloc: std.mem.Allocator,
+    io: std.Io,
+    json: []const u8,
+    limits: Limits,
+) !struct { terminal: @import("../Terminal.zig"), parser: screen_core.ParserState, json_bytes: usize } {
+    const parsed = std.json.parseFromSlice(Envelope, alloc, json, .{
+        .max_value_len = @min(limits.max_string_bytes, limits.max_json_bytes),
+        .ignore_unknown_fields = false,
+    }) catch |err| return switch (err) {
+        error.OutOfMemory => error.OutOfMemory,
+        error.ValueTooLong => error.LimitExceeded,
+        else => error.InvalidCheckpoint,
+    };
+    defer parsed.deinit();
+    const envelope = parsed.value;
+    if (envelope.schemaVersion != schema_version) return error.UnsupportedVersion;
+    var wide = try std.json.parseFromValue(terminal_wide.Document, alloc, envelope.terminal, .{
+        .ignore_unknown_fields = false,
+    });
+    defer wide.deinit();
+    try terminal_wide.validate(&wide.value, .{
+        .max_document_bytes = limits.max_json_bytes,
+        .max_string_bytes = limits.max_string_bytes,
+        .max_cells = limits.max_cells,
+    });
+    try envelope.routing.validate();
+    const cols = wide.value.dimensions.columns;
+    const rows = wide.value.dimensions.rows;
+    if (envelope.screens.len == 0 or envelope.screens.len > 2) return error.InvalidCheckpoint;
+    const wide_has_primary = std.mem.indexOfScalar(
+        u8,
+        wide.value.screens.initialized,
+        1,
+    ) != null;
+    const wide_has_alternate = std.mem.indexOfScalar(
+        u8,
+        wide.value.screens.initialized,
+        2,
+    ) != null;
+    const routing_active: u8 = switch (envelope.routing.activeScreen) {
+        .primary => 1,
+        .alternate => 2,
+    };
+    if (!wide_has_primary or
+        wide_has_alternate != envelope.routing.screens.alternate or
+        wide.value.screens.active != routing_active)
+    {
+        return error.InvalidCheckpoint;
+    }
+    const continuation_len = decodedContinuationLen(envelope.parser) catch
+        return error.InvalidCheckpoint;
+    if (continuation_len > limits.max_continuation_bytes) return error.LimitExceeded;
+    envelope.parser.validate(alloc) catch |err| return normalizeCoreError(err);
+
+    var primary_screen: ?screen_core.ScreenState = null;
+    var primary_grid: ?*const page_core.Document = null;
+    var alternate_screen: ?screen_core.ScreenState = null;
+    var alternate_grid: ?*const page_core.Document = null;
+    for (envelope.screens) |*screen| {
+        try screen.state.validate(cols, rows);
+        try page_core.validate(alloc, &screen.grid, pageLimits(limits));
+        if (screen.grid.grid.columns != cols or screen.grid.grid.active_rows != rows) {
+            return error.InvalidCheckpoint;
+        }
+        switch (screen.state.key) {
+            .primary => {
+                if (primary_screen != null) return error.InvalidCheckpoint;
+                primary_screen = screen.state;
+                primary_grid = &screen.grid;
+            },
+            .alternate => {
+                if (alternate_screen != null) return error.InvalidCheckpoint;
+                alternate_screen = screen.state;
+                alternate_grid = &screen.grid;
+            },
+        }
+    }
+    if (primary_screen == null or envelope.routing.screens.alternate != (alternate_screen != null)) {
+        return error.InvalidCheckpoint;
+    }
+
+    const primary_pages = try page_core.construct(alloc, primary_grid.?, pageLimits(limits));
+    var primary = try screen_core.restoreScreenWithPages(
+        io,
+        alloc,
+        primary_pages,
+        primary_screen.?,
+    );
+    var primary_owned = true;
+    errdefer if (primary_owned) primary.deinit();
+
+    var alternate_pages: ?@import("../PageList.zig") = if (alternate_grid) |grid|
+        try page_core.construct(alloc, grid, pageLimits(limits))
+    else
+        null;
+    errdefer if (alternate_pages) |*pages| pages.deinit();
+    var new_terminal = try terminal_wide.createTerminal(
+        &wide.value,
+        io,
+        alloc,
+    );
+    errdefer new_terminal.deinit(alloc);
+    new_terminal.screens.get(.primary).?.deinit();
+    new_terminal.screens.get(.primary).?.* = primary;
+    primary_owned = false;
+    if (alternate_screen) |state| {
+        const slot = new_terminal.screens.get(.alternate) orelse return error.InvalidCheckpoint;
+        var pages = alternate_pages.?;
+        alternate_pages = null;
+        var restored = try screen_core.restoreScreenWithPages(
+            io,
+            alloc,
+            pages,
+            state,
+        );
+        pages = undefined;
+        slot.deinit();
+        slot.* = restored;
+        restored = undefined;
+    }
+    new_terminal.screens.switchTo(envelope.routing.activeScreen.native());
+    const parser = screen_core.ParserState{
+        .schemaVersion = envelope.parser.schemaVersion,
+        .encoding = envelope.parser.encoding,
+        .bytes = try alloc.dupe(u8, envelope.parser.bytes),
+    };
+    return .{ .terminal = new_terminal, .parser = parser, .json_bytes = json.len };
+}
+
+fn restoreIo(
+    wrapper: *terminal_c.TerminalWrapper,
+    json: []const u8,
+    limits: Limits,
+    info: ?InfoOutput,
+) !void {
+    const alloc = wrapper.terminal.gpa();
+    var constructed = try constructTerminal(alloc, wrapper.terminal.io(), json, limits);
+    var new_terminal = constructed.terminal;
+    var new_terminal_owned = true;
+    defer constructed.parser.deinit(alloc);
+    errdefer if (new_terminal_owned) new_terminal.deinit(alloc);
+
+    if (comptime build_options.kitty_graphics) {
+        const source_primary_policy = wrapper.terminal.screens.get(.primary).?.kitty_images.policy();
+        const restored_primary = new_terminal.screens.get(.primary).?;
+        restored_primary.kitty_images.setLimit(
+            restored_primary.io,
+            restored_primary.alloc,
+            restored_primary,
+            source_primary_policy.total_limit,
+        );
+        restored_primary.kitty_images.image_limits = source_primary_policy.image_limits;
+        if (new_terminal.screens.get(.alternate)) |restored_alternate| {
+            const source = wrapper.terminal.screens.get(.alternate) orelse
+                wrapper.terminal.screens.get(.primary).?;
+            const policy = source.kitty_images.policy();
+            restored_alternate.kitty_images.setLimit(
+                restored_alternate.io,
+                restored_alternate.alloc,
+                restored_alternate,
+                policy.total_limit,
+            );
+            restored_alternate.kitty_images.image_limits = policy.image_limits;
+        }
+    }
+
+    // Persistent parser state is reconstructed against the temporary terminal.
+    const continuation_len = decodedContinuationLen(constructed.parser) catch return error.InvalidCheckpoint;
+    const continuation_limit = terminal_c.continuationMaxBytes(wrapper);
+    const temporary_limit = @max(
+        @max(continuation_limit, continuation_len),
+        @as(usize, 1),
+    );
+    var new_stream = terminal_c.makeStream(
+        &new_terminal,
+        temporary_limit,
+        wrapper,
+    );
+    errdefer new_stream.deinit();
+
+    // Continuation replay can complete a buffered APC/DCS/OSC command, so all
+    // destination-owned policy and effect capability must be installed first.
+    new_stream.handler.effects = wrapper.stream.handler.effects;
+    new_stream.handler.unknown_sequence = wrapper.stream.handler.unknown_sequence;
+    new_stream.handler.terminfo_name = wrapper.stream.handler.terminfo_name;
+    new_stream.handler.title_report = false;
+    new_stream.handler.apc_handler.max_bytes = wrapper.stream.handler.apc_handler.max_bytes;
+    new_stream.handler.apc_handler.enabled = wrapper.stream.handler.apc_handler.enabled;
+    new_stream.handler.apc_handler.unknown_max_bytes = wrapper.stream.handler.apc_handler.unknown_max_bytes;
+    new_stream.handler.dcs_handler.max_bytes = wrapper.stream.handler.dcs_handler.max_bytes;
+    new_stream.handler.kitty_clipboard_write_max_bytes =
+        wrapper.stream.handler.kitty_clipboard_write_max_bytes;
+
+    try screen_core.restoreParser(alloc, &new_stream, constructed.parser);
+    terminal_c.setStreamContinuationMaxBytes(&new_stream, continuation_limit);
+
+    // Preserve destination-owned presentation/runtime context and safety policy.
+    new_terminal.flags.focused = wrapper.terminal.flags.focused;
+    new_terminal.flags.visible = wrapper.terminal.flags.visible;
+    new_stream.handler.semantic_failure = wrapper.stream.handler.semantic_failure;
+
+    // Temporary parser handlers must be at an inactive command boundary after
+    // canonical continuation replay unless the continuation itself owns their
+    // state. The original stream remains independently owned until commit.
+
+    // No fallible operation follows this point. Invalidate tracked references,
+    // commit terminal and stream together, then release the old owned state.
+    terminal_c.detachTrackedRefs(wrapper);
+    terminal_c.detachDependents(wrapper);
+    for (wrapper.searches.keys()) |search| search.terminal = null;
+    wrapper.searches.clearRetainingCapacity();
+    var old_terminal = wrapper.terminal.*;
+    var old_stream = wrapper.stream;
+    wrapper.terminal.* = new_terminal;
+    new_terminal_owned = false;
+    wrapper.stream = new_stream;
+    wrapper.stream.handler.terminal = wrapper.terminal;
+    old_stream.deinit();
+    old_terminal.deinit(alloc);
+
+    writeInfo(info, .{
+        .json_bytes = constructed.json_bytes,
+        .continuation_bytes = decodedContinuationLen(constructed.parser) catch 0,
+    });
+}
+
+pub fn pageLimits(limits: Limits) page_core.Limits {
+    return .{
+        .total_bytes = limits.max_json_bytes,
+        .cells = limits.max_cells,
+        .string_bytes = limits.max_string_bytes,
+        .native_bytes = limits.max_json_bytes *| 64,
+    };
+}
+
+fn captureParser(
+    alloc: std.mem.Allocator,
+    stream: *const terminal_c.Stream,
+    max_continuation_bytes: usize,
+) !screen_core.ParserState {
+    if (stream.continuation == null and stream.ground()) {
+        const encoded = try alloc.dupe(u8, "");
+        return .{ .bytes = encoded };
+    }
+    return screen_core.captureParser(alloc, stream, max_continuation_bytes);
+}
+
+pub fn decodedContinuationLen(parser: screen_core.ParserState) !usize {
+    return std.base64.standard.Decoder.calcSizeForSlice(parser.bytes);
+}
+
+pub fn prepareInfo(info_: ?*Info) error{InvalidInfo}!?InfoOutput {
+    const info = info_ orelse return null;
+    const size = info.size;
+    if (size < @sizeOf(usize)) return error.InvalidInfo;
+    const output: InfoOutput = .{ .ptr = info, .size = size };
+    writeInfo(output, .{});
+    return output;
+}
+
+pub fn writeInfo(output_: ?InfoOutput, value: Info) void {
+    const output = output_ orelse return;
+    if (lib.structSizedFieldFits(Info, output.size, "schema_version")) {
+        output.ptr.schema_version = value.schema_version;
+    }
+    if (lib.structSizedFieldFits(Info, output.size, "json_bytes")) {
+        output.ptr.json_bytes = value.json_bytes;
+    }
+    if (lib.structSizedFieldFits(Info, output.size, "continuation_bytes")) {
+        output.ptr.continuation_bytes = value.continuation_bytes;
+    }
+}
+
+pub fn validSize(actual: usize, comptime T: type) bool {
+    return actual >= @sizeOf(T);
+}
+
+pub fn validLimits(limits: Limits) bool {
+    return validSize(limits.size, Limits) and limits.max_json_bytes > 0 and
+        limits.max_string_bytes > 0 and limits.max_continuation_bytes > 0 and
+        limits.max_cells > 0;
+}
+
+pub fn normalizeCoreError(err: anyerror) anyerror {
+    return switch (err) {
+        error.OutOfMemory => error.OutOfMemory,
+        error.ContinuationTooLarge => error.LimitExceeded,
+        else => error.InvalidCheckpoint,
+    };
+}
+
+pub fn mapError(err: anyerror) Result {
+    return switch (err) {
+        error.OutOfMemory, error.WriteFailed => .out_of_memory,
+        error.LimitExceeded, error.ContinuationTooLarge => .limit_exceeded,
+        error.UnsupportedVersion => .no_value,
+        else => .invalid_value,
+    };
+}
+
+fn testEnableContinuation(terminal: terminal_c.Terminal) !void {
+    const limit: usize = screen_core.limits.max_continuation_bytes;
+    try testing.expectEqual(Result.success, terminal_c.set(terminal, .continuation_max_bytes, &limit));
+}
+
+fn testEncoded(terminal: terminal_c.Terminal) ![]u8 {
