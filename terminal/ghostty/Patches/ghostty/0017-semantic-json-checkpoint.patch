+fn testTerminal() !Terminal {
+    return Terminal.init(std.testing.io, std.testing.allocator, .{
+        .cols = 12,
+        .rows = 4,
+        .max_scrollback_bytes = 12345,
+        .max_scrollback_lines = 77,
+    });
+}
