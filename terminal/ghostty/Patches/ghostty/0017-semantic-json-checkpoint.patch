+pub fn checkpointSelectionChanged(self: *Surface) void {
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .selection_changed,
+        {},
+    ) catch {};
+}
+
+pub fn checkpointRestoredMessage(self: *Surface) ?apprt.surface.Message {
+    const terminal_title = self.io.terminal.getTitle() orelse "";
+    var title: [256]u8 = @splat(0);
+    const title_len = @min(terminal_title.len, title.len - 1);
+    @memcpy(title[0..title_len], terminal_title[0..title_len]);
+    const terminal_pwd = self.io.terminal.getPwd() orelse "";
+    const pwd_message = apprt.surface.Message.WriteReq.init(self.alloc, terminal_pwd) catch return null;
+    return .{ .checkpoint_restored = .{
+        .title = title,
+        .pwd = pwd_message,
+        .mouse_shape = self.io.terminal.mouse_shape,
+        .selection_changed = true,
+    } };
+}
+
+pub fn deferCheckpointRestored(self: *Surface, msg: apprt.surface.Message) void {
+    const mailbox = self.io.surface_mailbox;
+    const alloc = self.alloc;
+    const task = alloc.create(DeferredCheckpointMessage) catch {
+        switch (msg) {
+            .checkpoint_restored => |*value| value.pwd.deinit(),
+            else => unreachable,
+        }
+        return;
+    };
+    task.* = .{ .mailbox = mailbox, .message = msg, .alloc = alloc };
+    const thread = std.Thread.spawn(.{}, deferredCheckpointMain, .{task}) catch {
+        alloc.destroy(task);
+        switch (msg) {
+            .checkpoint_restored => |*value| value.pwd.deinit(),
+            else => unreachable,
+        }
+        return;
+    };
+    thread.detach();
+}
+
+const DeferredCheckpointMessage = struct {
+    mailbox: apprt.surface.Mailbox,
+    message: apprt.surface.Message,
+    alloc: std.mem.Allocator,
+};
+
+fn deferredCheckpointMain(task: *DeferredCheckpointMessage) void {
+    defer task.alloc.destroy(task);
+    _ = task.mailbox.push(task.message, .{ .forever = {} });
+}
+
+pub fn applyCheckpointGeometry(self: *Surface, size: rendererpkg.Size) void {
+    self.size = size;
+}
+
