+fn roundTrip(source: *const Terminal) !struct { bytes: []u8, terminal: Terminal } {
+    const alloc = std.testing.allocator;
+    const bytes = try encodeAlloc(alloc, source);
+    errdefer alloc.free(bytes);
+    var decoded = try decode(alloc, bytes, .{});
+    defer decoded.deinit();
+    const terminal = try decoded.createTerminal(std.testing.io, alloc);
+    return .{ .bytes = bytes, .terminal = terminal };
+}
