+
+test "checkpoint restore rejects inconsistent screen routing" {
+    var source: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &source,
+        8,
+        2,
+    ));
+    defer terminal_c.free(source);
+    const encoded = try testEncoded(source);
+    defer lib.alloc.default(&lib.alloc.test_allocator).free(encoded);
+
+    const needle = "\"initialized\":[1]";
+    const replacement = "\"initialized\":[1,2]";
+    const offset = std.mem.indexOf(u8, encoded, needle) orelse
+        return error.TestUnexpectedResult;
+    const modified = try testing.allocator.alloc(
+        u8,
+        encoded.len + replacement.len - needle.len,
+    );
+    defer testing.allocator.free(modified);
+    @memcpy(modified[0..offset], encoded[0..offset]);
+    @memcpy(
+        modified[offset..][0..replacement.len],
+        replacement,
+    );
+    @memcpy(
+        modified[offset + replacement.len ..],
+        encoded[offset + needle.len ..],
+    );
+
+    var destination: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &destination,
+        8,
+        2,
+    ));
+    defer terminal_c.free(destination);
+    terminal_c.vt_write(destination, "before", 6);
+    const original_x = destination.?.terminal.screens.active.cursor.x;
+    try testing.expectEqual(Result.invalid_value, restore(
+        destination,
+        modified.ptr,
+        modified.len,
+        &RestoreOptions{},
+        null,
+    ));
+    try testing.expectEqual(original_x, destination.?.terminal.screens.active.cursor.x);
+}
+
+test "checkpoint C ABI insufficient buffer reports exact size" {
+    var terminal: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &terminal, 8, 2));
+    defer terminal_c.free(terminal);
+    var query: lib.Buffer = .{};
+    try testing.expectEqual(Result.out_of_space, encode_buf(terminal, &EncodeOptions{}, &query, null));
+    try testing.expect(query.len > 0);
+    const needed = query.len;
+    var short: [8]u8 = undefined;
+    var buffer: lib.Buffer = .{ .ptr = &short, .cap = short.len };
+    try testing.expectEqual(Result.out_of_space, encode_buf(terminal, &EncodeOptions{}, &buffer, null));
+    try testing.expectEqual(needed, buffer.len);
+}
+
+test "checkpoint C ABI allocation failure initializes outputs" {
+    var terminal: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &terminal, 8, 2));
+    defer terminal_c.free(terminal);
+    var failing = testing.FailingAllocator.init(testing.allocator, .{ .fail_index = 0 });
+    const failing_zig = failing.allocator();
+    const failing_c: CAllocator = .fromZig(&failing_zig);
+    var ptr: ?[*]u8 = @ptrFromInt(1);
+    var len: usize = 99;
+    try testing.expectEqual(Result.out_of_memory, encode_alloc(terminal, &EncodeOptions{}, &failing_c, &ptr, &len, null));
+    try testing.expectEqual(null, ptr);
+    try testing.expectEqual(@as(usize, 0), len);
+}
