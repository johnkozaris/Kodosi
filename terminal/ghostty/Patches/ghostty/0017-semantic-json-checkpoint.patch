+//! Kodosi-owned semantic JSON checkpoint state for terminal routing, screens,
+//! cursors, and parser continuation.
+//!
+//! Grid pages are deliberately outside this module. Screen restoration creates
+//! native `Screen` values directly and transactionally; the page checkpoint
+//! layer can replace their blank page lists before the resulting `ScreenSet` is
+//! installed. Committed screen state is never reconstructed by feeding terminal
+//! input.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const ansi = @import("ansi.zig");
+const charsets = @import("charsets.zig");
+const color = @import("color.zig");
+const hyperlink = @import("hyperlink.zig");
+const kitty = @import("kitty.zig");
+const osc = @import("osc.zig");
+const page = @import("page.zig");
+const sgr = @import("sgr.zig");
+const stream_continuation = @import("stream_continuation.zig");
+const style = @import("style.zig");
+const Screen = @import("Screen.zig");
+const ScreenSet = @import("ScreenSet.zig");
+const Terminal = @import("Terminal.zig");
+const TerminalStream = @import("stream_terminal.zig").Stream;
+
+/// Version of the owned JSON objects in this module. The eventual checkpoint
+/// envelope owns its own top-level version and composes these objects.
+pub const schema_version: u32 = 2;
+
+/// Defensive defaults for callers parsing these objects from an envelope.
+pub const limits = struct {
+    pub const max_json_bytes: usize = 8 * 1024 * 1024;
+    pub const max_continuation_bytes: usize = 1024 * 1024;
+    pub const max_hyperlink_uri_bytes: usize = 64 * 1024;
+    pub const max_hyperlink_id_bytes: usize = 4 * 1024;
+    pub const max_dimension: u16 = 4096;
+};
+
+/// Owned wire registry for screen identity. Values are strings and conversions
+/// are explicit, so native enum declaration order is not a wire contract.
+pub const ScreenKey = enum {
+    primary,
+    alternate,
+
+    pub fn native(self: ScreenKey) ScreenSet.Key {
+        return switch (self) {
+            .primary => .primary,
+            .alternate => .alternate,
+        };
+    }
+
+    fn init(value: ScreenSet.Key) ScreenKey {
+        return switch (value) {
+            .primary => .primary,
+            .alternate => .alternate,
+        };
+    }
+};
+
+pub const TerminalState = struct {
+    schemaVersion: u32 = schema_version,
+    activeScreen: ScreenKey,
+    screens: ScreenRouting,
+
+    pub const ScreenRouting = struct {
+        primary: bool = true,
+        alternate: bool,
+    };
+
+    pub fn capture(terminal: *const Terminal) TerminalState {
+        return .{
+            .activeScreen = .init(terminal.screens.active_key),
+            .screens = .{
+                .alternate = terminal.screens.get(.alternate) != null,
+            },
+        };
+    }
+
+    pub fn validate(self: TerminalState) ValidationError!void {
