+fn validateDimensions(cols: u16, rows: u16) ValidationError!void {
+    if (cols == 0 or rows == 0 or
+        cols > limits.max_dimension or rows > limits.max_dimension)
+    {
+        return error.InvalidDimensions;
+    }
+}
+
+pub const ParserState = struct {
+    schemaVersion: u32 = schema_version,
+    encoding: Encoding = .base64,
+    bytes: []const u8,
+
+    pub const Encoding = enum { base64 };
+
+    pub fn deinit(self: *ParserState, alloc: Allocator) void {
+        alloc.free(self.bytes);
+        self.* = undefined;
+    }
+
+    pub fn validate(self: ParserState, alloc: Allocator) (Allocator.Error || ValidationError)!void {
+        if (self.schemaVersion != schema_version) return error.InvalidSchemaVersion;
+        const decoded = try self.decode(alloc);
+        defer alloc.free(decoded);
+        stream_continuation.validate(decoded) catch return error.InvalidContinuation;
+    }
+
+    pub fn decode(self: ParserState, alloc: Allocator) (Allocator.Error || ValidationError)![]u8 {
+        if (self.schemaVersion != schema_version) return error.InvalidSchemaVersion;
+        const Decoder = std.base64.standard.Decoder;
+        const decoded_len = Decoder.calcSizeForSlice(self.bytes) catch {
+            return error.InvalidContinuation;
+        };
+        if (decoded_len > limits.max_continuation_bytes) {
+            return error.ContinuationTooLarge;
+        }
+        const decoded = try alloc.alloc(u8, decoded_len);
+        errdefer alloc.free(decoded);
+        Decoder.decode(decoded, self.bytes) catch return error.InvalidContinuation;
+        return decoded;
+    }
+};
+
+/// Export parser, UTF-8, OSC, APC, or DCS continuation only through the
+/// persistent Stream's direct continuation tracker API.
+pub fn captureParser(
+    alloc: Allocator,
+    stream: anytype,
+    max_continuation_bytes: usize,
+) (Allocator.Error || std.Io.Writer.Error || ValidationError || error{
+    ContinuationDisabled,
+    ContinuationUnavailable,
+})!ParserState {
+    const effective_limit = @min(
+        max_continuation_bytes,
+        limits.max_continuation_bytes,
+    );
+    var counter: std.Io.Writer.Discarding = .init(&.{});
+    try stream.writeContinuation(&counter.writer);
+    const raw_len = std.math.cast(usize, counter.count) orelse
+        return error.ContinuationTooLarge;
+    if (raw_len > effective_limit) {
+        return error.ContinuationTooLarge;
+    }
+
+    const raw = try alloc.alloc(u8, raw_len);
+    defer alloc.free(raw);
+    var raw_writer: std.Io.Writer = .fixed(raw);
+    try stream.writeContinuation(&raw_writer);
+    stream_continuation.validate(raw_writer.buffered()) catch {
+        return error.InvalidContinuation;
+    };
+
+    const Encoder = std.base64.standard.Encoder;
+    const encoded = try alloc.alloc(u8, Encoder.calcSize(raw_len));
+    errdefer alloc.free(encoded);
+    _ = Encoder.encode(encoded, raw_writer.buffered());
+    return .{ .bytes = encoded };
+}
+
+/// Seed a fresh persistent Stream from canonical continuation bytes and prove
+/// that the direct tracker re-exports exactly the same canonical suffix.
+pub fn restoreParser(
+    alloc: Allocator,
+    stream: anytype,
+    state: ParserState,
+) (Allocator.Error || std.Io.Writer.Error || ValidationError || error{
+    ContinuationDisabled,
+    ContinuationUnavailable,
+})!void {
+    const decoded = try state.decode(alloc);
+    defer alloc.free(decoded);
+    stream_continuation.validate(decoded) catch return error.InvalidContinuation;
+
+    stream.nextSlice(decoded);
+    var reexported: std.Io.Writer.Allocating = .init(alloc);
+    defer reexported.deinit();
+    try stream.writeContinuation(&reexported.writer);
+    if (!std.mem.eql(u8, decoded, reexported.written())) {
+        return error.InvalidContinuation;
+    }
+}
