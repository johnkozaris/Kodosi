+//! Owned JSON encoding for the PAGE/GRID/HISTORY semantic checkpoint.
+//!
+//! This operates directly on Page and PageList and never reconstructs committed
+//! state by feeding terminal input. It exposes no C ABI.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const PageList = @import("PageList.zig");
+const pagepkg = @import("page.zig");
+const stylepkg = @import("style.zig");
+const hyperlink = @import("hyperlink.zig");
+const size = @import("size.zig");
+
+const Page = pagepkg.Page;
+const Cell = pagepkg.Cell;
+const NativeUnderline = @TypeOf(@as(stylepkg.Style, .{}).flags.underline);
+
+pub const schema = "kodosi-page-grid-history-checkpoint";
+pub const version: u16 = 2;
+
+/// Decoder policy, never serialized as part of the semantic document.
+pub const Limits = struct {
+    total_bytes: usize = 64 * 1024 * 1024,
+    pages: usize = 4096,
+    rows: usize = 262_144,
+    cells: usize = 16_777_216,
+    strings: usize = 131_072,
+    string_bytes: usize = 8 * 1024 * 1024,
+    grapheme_codepoints: usize = 1_048_576,
+    styles: usize = 262_144,
+    hyperlinks: usize = 262_144,
+    native_bytes: usize = 512 * 1024 * 1024,
+};
+
+pub const Error = error{
+    InputTooLarge,
+    TooManyPages,
+    TooManyRows,
+    TooManyCells,
+    TooManyStrings,
+    TooManyStringBytes,
+    TooManyGraphemes,
+    TooManyStyles,
+    TooManyHyperlinks,
+    NativeSizeLimit,
+    WrongSchema,
+    UnsupportedVersion,
+    InvalidDimensions,
+    InvalidCapacity,
+    InvalidStyle,
+    InvalidStyleReference,
+    InvalidHyperlink,
+    InvalidHyperlinkReference,
+    InvalidUnicode,
+    InvalidGrapheme,
+    InvalidWideStructure,
+    InvalidWrapStructure,
+    IntegerOverflow,
+};
+
+/// Exact typed version-1 wire object. Unknown, duplicate, and missing fields
+/// are rejected by std.json before semantic validation.
+pub const Document = struct {
+    schema: []const u8,
+    version: u16,
+    grid: Grid,
+    /// Oldest retained page first, newest active page last.
+    pages: []const PageDto,
+};
+
+pub const Grid = struct {
+    columns: u16,
+    active_rows: u16,
+    max_scrollback_bytes: ?u64,
+    max_scrollback_rows: ?u64,
+};
+
+pub const PageDto = struct {
+    size: PageSize,
+    /// Stable logical allocation behavior needed for subsequent rollover,
+    /// reflow, and page-granular pruning. These are portable quantities, not
+    /// native backing bytes, offsets, pointers, buckets, or hashes.
+    capacity: PageCapacity,
+    styles: []const StyleDto,
+    hyperlinks: []const HyperlinkDto,
+    rows: []const RowDto,
+};
+
+pub const PageSize = struct { columns: u16, rows: u16 };
+pub const PageCapacity = struct {
+    columns: u16,
+    rows: u16,
+    styles: u16,
+    hyperlink_bytes: u16,
+    grapheme_bytes: u32,
+    string_bytes: u32,
+};
+
+pub const RowDto = struct {
+    soft_wrap: bool,
+    wrap_continuation: bool,
+    semantic_prompt: SemanticPrompt,
+    cells: []const CellDto,
+};
+
+pub const SemanticPrompt = enum { none, prompt, prompt_continuation };
+pub const SemanticContent = enum { output, input, prompt };
+pub const Width = enum { narrow, wide, spacer_tail, spacer_head };
+pub const ContentKind = enum { codepoint, palette_background, rgb_background };
+pub const Rgb = struct { red: u8, green: u8, blue: u8 };
+
+pub const Content = struct {
+    kind: ContentKind,
+    codepoint: ?u32,
+    palette: ?u8,
+    rgb: ?Rgb,
+};
+
+pub const CellDto = struct {
+    content: Content,
+    width: Width,
+    protected: bool,
+    semantic_content: SemanticContent,
+    style: ?u32,
+    hyperlink: ?u32,
+    /// Additional scalar values only; the base scalar is in content.codepoint.
+    grapheme_suffix: []const u32,
+
+    const Wire = struct { u8, u32, ?u32, ?u32, []const u32 };
+
+    pub fn jsonStringify(self: CellDto, jws: anytype) !void {
+        try jws.write(Wire{
+            try encodeFlags(self),
+            encodeContent(self.content),
+            self.style,
+            self.hyperlink,
+            self.grapheme_suffix,
+        });
+    }
+
+    pub fn jsonParse(
+        allocator: Allocator,
+        source: anytype,
+        options: std.json.ParseOptions,
+    ) !CellDto {
+        const wire = try std.json.innerParse(Wire, allocator, source, options);
+        return decodeWire(wire);
+    }
+
+    pub fn jsonParseFromValue(
+        allocator: Allocator,
+        source: std.json.Value,
+        options: std.json.ParseOptions,
+    ) !CellDto {
+        const wire = try std.json.innerParseFromValue(Wire, allocator, source, options);
+        return decodeWire(wire);
+    }
+};
+
+pub const ColorKind = enum { none, palette, rgb };
+pub const Color = struct { kind: ColorKind, palette: ?u8, rgb: ?Rgb };
+pub const Underline = enum { none, single, double, curly, dotted, dashed };
+pub const Attributes = struct {
+    bold: bool,
+    italic: bool,
+    faint: bool,
+    blink: bool,
+    inverse: bool,
+    invisible: bool,
+    strikethrough: bool,
+    overline: bool,
+    underline: Underline,
+};
+
+pub const StyleDto = struct {
+    id: u32,
+    foreground: Color,
+    background: Color,
+    underline_color: Color,
+    attributes: Attributes,
+
+    const Wire = struct { u32, u32, u32, u32, u16 };
+
+    pub fn jsonStringify(self: StyleDto, jws: anytype) !void {
+        try jws.write(Wire{
+            self.id,
+            encodeColor(self.foreground),
+            encodeColor(self.background),
+            encodeColor(self.underline_color),
+            encodeAttributes(self.attributes),
+        });
+    }
+
+    pub fn jsonParse(
+        allocator: Allocator,
+        source: anytype,
+        options: std.json.ParseOptions,
+    ) !StyleDto {
+        const wire = try std.json.innerParse(Wire, allocator, source, options);
+        return decodeStyleWire(wire);
+    }
+
+    pub fn jsonParseFromValue(
+        allocator: Allocator,
+        source: std.json.Value,
+        options: std.json.ParseOptions,
+    ) !StyleDto {
+        const wire = try std.json.innerParseFromValue(Wire, allocator, source, options);
+        return decodeStyleWire(wire);
+    }
+};
+
+pub const HyperlinkKind = enum { implicit, explicit };
+pub const Byte = struct {
+    value: u8,
+};
+
+pub const HyperlinkDto = struct {
+    id: u32,
+    kind: HyperlinkKind,
+    implicit_id: ?u32,
+    explicit_id: ?[]const Byte,
+    uri: []const Byte,
+};
+
+/// Owns every slice in a captured document.
+pub const Captured = struct {
+    arena: std.heap.ArenaAllocator,
+    value: Document,
+
+    pub fn deinit(self: *Captured) void {
+        self.arena.deinit();
+        self.* = undefined;
+    }
+};
+
+const Counts = struct {
+    pages: usize = 0,
+    rows: usize = 0,
+    cells: usize = 0,
+    strings: usize = 0,
+    string_bytes: usize = 0,
+    grapheme_codepoints: usize = 0,
+    styles: usize = 0,
+    hyperlinks: usize = 0,
+    native_bytes: usize = 0,
+
+    fn add(self: *Counts, comptime field_name: []const u8, n: usize) Error!void {
+        @field(self, field_name) = std.math.add(
+            usize,
+            @field(self, field_name),
+            n,
+        ) catch return error.IntegerOverflow;
+    }
+
+    fn enforce(self: Counts, limits: Limits) Error!void {
+        if (self.pages > limits.pages) return error.TooManyPages;
+        if (self.rows > limits.rows) return error.TooManyRows;
+        if (self.cells > limits.cells) return error.TooManyCells;
+        if (self.strings > limits.strings) return error.TooManyStrings;
+        if (self.string_bytes > limits.string_bytes) return error.TooManyStringBytes;
+        if (self.grapheme_codepoints > limits.grapheme_codepoints) return error.TooManyGraphemes;
+        if (self.styles > limits.styles) return error.TooManyStyles;
+        if (self.hyperlinks > limits.hyperlinks) return error.TooManyHyperlinks;
+        if (self.native_bytes > limits.native_bytes) return error.NativeSizeLimit;
+    }
+};
+
+/// Capture all retained history and active rows without changing compressed
+/// source pages to resident storage.
+pub fn capture(alloc: Allocator, list: *const PageList, limits: Limits) !Captured {
+    var result: Captured = .{
+        .arena = std.heap.ArenaAllocator.init(alloc),
+        .value = undefined,
+    };
+    errdefer result.arena.deinit();
+    const arena = result.arena.allocator();
+
+    const options = list.constructionOptions();
+    var page_values: std.ArrayList(PageDto) = .empty;
+    var counts: Counts = .{};
+    var node = list.getTopLeft(.screen).node;
+    while (true) {
+        try counts.add("pages", 1);
+        try counts.enforce(limits);
+        var preserved = try node.pagePreservingState(alloc);
+        defer preserved.deinit();
+        try page_values.append(arena, try capturePage(
+            arena,
+            preserved.page(),
+            &counts,
+            limits,
+        ));
+        node = node.next orelse break;
+    }
+
+    result.value = .{
+        .schema = schema,
+        .version = version,
+        .grid = .{
+            .columns = options.cols,
+            .active_rows = options.rows,
+            .max_scrollback_bytes = toOptionalU64(options.max_size),
+            .max_scrollback_rows = toOptionalU64(options.max_lines),
+        },
+        .pages = try page_values.toOwnedSlice(arena),
+    };
+    return result;
+}
+
+/// Encode canonical minified JSON into caller-owned bytes.
+pub fn encodeAlloc(alloc: Allocator, list: *const PageList, limits: Limits) ![]u8 {
+    var captured = try capture(alloc, list, limits);
+    defer captured.deinit();
+    var output: std.Io.Writer.Allocating = .init(alloc);
+    errdefer output.deinit();
+    var json: std.json.Stringify = .{ .writer = &output.writer };
+    try json.write(captured.value);
+    if (output.writer.buffered().len > limits.total_bytes) return error.InputTooLarge;
+    return output.toOwnedSlice();
+}
+
+/// Decode directly into final native page allocations owned transactionally by
+/// PageList.Builder. No existing PageList is accepted or mutated.
+pub fn decode(alloc: Allocator, bytes: []const u8, limits: Limits) !PageList {
+    if (bytes.len > limits.total_bytes) return error.InputTooLarge;
+    const parsed = try std.json.parseFromSlice(Document, alloc, bytes, .{
+        .duplicate_field_behavior = .@"error",
+        .ignore_unknown_fields = false,
+        .max_value_len = limits.string_bytes,
+        .allocate = .alloc_always,
+    });
+    defer parsed.deinit();
+    return construct(alloc, &parsed.value, limits);
+}
+
+/// Build a temporary native PageList from an already-owned typed document.
+pub fn construct(alloc: Allocator, document: *const Document, limits: Limits) !PageList {
+    try validate(alloc, document, limits);
+    var builder = try PageList.Builder.init(alloc, .{
+        .cols = document.grid.columns,
+        .rows = document.grid.active_rows,
+        .max_size = try fromOptionalU64(document.grid.max_scrollback_bytes),
+        .max_lines = try fromOptionalU64(document.grid.max_scrollback_rows),
+    });
+    defer builder.deinit();
+
+    for (document.pages) |wire| {
+        const native = try builder.allocatePage(nativeCapacity(wire.capacity));
+        native.size = .{ .cols = wire.size.columns, .rows = wire.size.rows };
+        try populatePage(alloc, native, wire);
+        try native.verifyIntegrity(alloc);
+    }
+    return builder.finish();
+}
+
+pub fn validate(alloc: Allocator, document: *const Document, limits: Limits) !void {
+    return validateWithAllocator(alloc, document, limits);
+}
+
+/// Semantic validation using only caller-accounted temporary allocations.
+pub fn validateWithAllocator(
+    alloc: Allocator,
+    document: *const Document,
+    limits: Limits,
+) !void {
+    if (!std.mem.eql(u8, document.schema, schema)) return error.WrongSchema;
+    if (document.version != version) return error.UnsupportedVersion;
+    if (document.grid.columns == 0 or document.grid.active_rows == 0 or
+        document.pages.len == 0)
+    {
+        return error.InvalidDimensions;
+    }
+    _ = try fromOptionalU64(document.grid.max_scrollback_bytes);
+    _ = try fromOptionalU64(document.grid.max_scrollback_rows);
+
+    var counts: Counts = .{};
+    var total_rows: usize = 0;
+    for (document.pages) |wire| {
+        try counts.add("pages", 1);
+        try validatePage(alloc, wire, limits, &counts);
+        total_rows = std.math.add(usize, total_rows, wire.size.rows) catch
+            return error.IntegerOverflow;
+    }
+    if (total_rows < document.grid.active_rows) return error.InvalidDimensions;
+    try validateRowChain(document.pages);
+    try counts.enforce(limits);
+}
+
+fn validatePage(
+    alloc: Allocator,
+    wire: PageDto,
+    limits: Limits,
+    counts: *Counts,
+) !void {
+    if (wire.size.columns == 0 or wire.size.rows == 0 or
+        wire.rows.len != wire.size.rows)
+    {
+        return error.InvalidDimensions;
+    }
+    if (wire.capacity.columns < wire.size.columns or wire.capacity.rows < wire.size.rows)
+        return error.InvalidCapacity;
+
+    // Bound every input before Page.layout performs alignment and multiplication.
+    const capacity_cells = std.math.mul(
+        usize,
+        wire.capacity.columns,
+        wire.capacity.rows,
+    ) catch return error.InvalidCapacity;
+    if (capacity_cells > limits.native_bytes / @sizeOf(Cell)) return error.NativeSizeLimit;
+    if (wire.capacity.grapheme_bytes > limits.native_bytes or
+        wire.capacity.string_bytes > limits.native_bytes)
+    {
+        return error.NativeSizeLimit;
+    }
+    const layout_bytes = Page.layout(nativeCapacity(wire.capacity)).total_size;
+    if (layout_bytes > size.max_page_size) return error.InvalidCapacity;
+    try counts.add("native_bytes", layout_bytes);
+    try counts.add("rows", wire.size.rows);
+    try counts.add("cells", std.math.mul(
+        usize,
+        wire.size.columns,
+        wire.size.rows,
+    ) catch return error.IntegerOverflow);
+
+    var style_ids = std.AutoHashMap(u32, void).init(alloc);
+    defer style_ids.deinit();
+    if (wire.styles.len > wire.capacity.styles) return error.InvalidCapacity;
+    for (wire.styles) |value| {
+        try counts.add("styles", 1);
+        if (value.id == 0) return error.InvalidStyle;
+        const entry = try style_ids.getOrPut(value.id);
+        if (entry.found_existing) return error.InvalidStyle;
+        try validateColor(value.foreground);
+        try validateColor(value.background);
+        try validateColor(value.underline_color);
+    }
+
+    var hyperlink_ids = std.AutoHashMap(u32, void).init(alloc);
+    defer hyperlink_ids.deinit();
+    for (wire.hyperlinks) |value| {
+        try counts.add("hyperlinks", 1);
+        if (value.id == 0 or value.uri.len == 0 or !validUtf8(value.uri))
+            return error.InvalidHyperlink;
+        const entry = try hyperlink_ids.getOrPut(value.id);
+        if (entry.found_existing) return error.InvalidHyperlink;
+        try countString(counts, limits, value.uri);
+        switch (value.kind) {
+            .implicit => if (value.implicit_id == null or value.explicit_id != null)
+                return error.InvalidHyperlink,
+            .explicit => {
+                const explicit = value.explicit_id orelse return error.InvalidHyperlink;
+                if (value.implicit_id != null or explicit.len == 0 or
+                    !validUtf8(explicit)) return error.InvalidHyperlink;
+                try countString(counts, limits, explicit);
+            },
+        }
+    }
+
+    var used_styles = std.AutoHashMap(u32, void).init(alloc);
+    defer used_styles.deinit();
+    var used_links = std.AutoHashMap(u32, void).init(alloc);
+    defer used_links.deinit();
+    for (wire.rows) |row| {
+        if (row.cells.len != wire.size.columns) return error.InvalidDimensions;
+        for (row.cells, 0..) |cell, x| {
+            try validateCell(cell);
+            try counts.add("grapheme_codepoints", cell.grapheme_suffix.len);
+            if (cell.style) |id| {
+                if (!style_ids.contains(id)) return error.InvalidStyleReference;
+                try used_styles.put(id, {});
+            }
+            if (cell.hyperlink) |id| {
+                if (!hyperlink_ids.contains(id)) return error.InvalidHyperlinkReference;
+                try used_links.put(id, {});
+            }
+            switch (cell.width) {
+                .narrow => {},
+                .wide => if (x + 1 >= row.cells.len or
+                    row.cells[x + 1].width != .spacer_tail) return error.InvalidWideStructure,
+                .spacer_tail => if (x == 0 or
+                    row.cells[x - 1].width != .wide) return error.InvalidWideStructure,
+                .spacer_head => if (x + 1 != row.cells.len or
+                    !row.soft_wrap) return error.InvalidWideStructure,
+            }
+        }
+    }
+    if (used_styles.count() != style_ids.count()) return error.InvalidStyleReference;
+    if (used_links.count() != hyperlink_ids.count()) return error.InvalidHyperlinkReference;
+    try counts.enforce(limits);
+}
+
+fn validateRowChain(pages: []const PageDto) !void {
+    var previous: ?RowDto = null;
+    for (pages) |wire| for (wire.rows) |row| {
+        if (previous) |prior| {
+            if (prior.soft_wrap != row.wrap_continuation) return error.InvalidWrapStructure;
+            if (prior.cells[prior.cells.len - 1].width == .spacer_head and
+                (row.cells.len < 2 or row.cells[0].width != .wide or
+                    row.cells[1].width != .spacer_tail))
+            {
+                return error.InvalidWideStructure;
+            }
+        }
+        previous = row;
+    };
+}
+
+fn validateCell(value: CellDto) !void {
+    switch (value.content.kind) {
+        .codepoint => {
+            const cp = value.content.codepoint orelse return error.InvalidUnicode;
+            if (value.content.palette != null or value.content.rgb != null or
+                !validScalar(cp, true)) return error.InvalidUnicode;
+            if (value.grapheme_suffix.len > pagepkg.grapheme_max_len or
+                (value.grapheme_suffix.len > 0 and cp == 0)) return error.InvalidGrapheme;
+            for (value.grapheme_suffix) |suffix| {
+                if (!validScalar(suffix, false)) return error.InvalidUnicode;
+            }
+        },
+        .palette_background => if (value.content.palette == null or
+            value.content.codepoint != null or value.content.rgb != null or
+            value.grapheme_suffix.len != 0) return error.InvalidGrapheme,
+        .rgb_background => if (value.content.rgb == null or
+            value.content.codepoint != null or value.content.palette != null or
+            value.grapheme_suffix.len != 0) return error.InvalidGrapheme,
+    }
+}
+
+fn capturePage(alloc: Allocator, native: *const Page, counts: *Counts, limits: Limits) !PageDto {
+    try counts.add("rows", native.size.rows);
+    try counts.add("cells", std.math.mul(
+        usize,
+        native.size.rows,
+        native.size.cols,
+    ) catch return error.IntegerOverflow);
+    try counts.add("native_bytes", native.memory.len);
+
+    var styles: std.ArrayList(StyleDto) = .empty;
+    var links: std.ArrayList(HyperlinkDto) = .empty;
+    var style_ids = std.AutoHashMap(stylepkg.Id, u32).init(alloc);
+    defer style_ids.deinit();
+    var link_ids = std.AutoHashMap(hyperlink.Id, u32).init(alloc);
+    defer link_ids.deinit();
+
+    const rows = native.rows.ptr(native.memory)[0..native.size.rows];
+    for (rows) |*row| for (row.cells.ptr(native.memory)[0..native.size.cols]) |*cell| {
+        if (cell.style_id != stylepkg.default_id and !style_ids.contains(cell.style_id)) {
+            try counts.add("styles", 1);
+            try counts.enforce(limits);
+            const id: u32 = @intCast(styles.items.len + 1);
+            try style_ids.put(cell.style_id, id);
+            try styles.append(alloc, styleFromNative(
+                id,
+                native.styles.get(native.memory, cell.style_id).*,
+            ));
+        }
+        if (cell.hyperlink) {
+            const native_id = native.lookupHyperlink(cell) orelse
+                return error.InvalidHyperlinkReference;
+            if (!link_ids.contains(native_id)) {
+                try counts.add("hyperlinks", 1);
+                try counts.enforce(limits);
+                const id: u32 = @intCast(links.items.len + 1);
+                try link_ids.put(native_id, id);
+                const entry = native.hyperlink_set.get(native.memory, native_id);
+                const uri = entry.uri.slice(native.memory);
+                if (uri.len == 0 or !std.unicode.utf8ValidateSlice(uri)) return error.InvalidUnicode;
+                try countString(counts, limits, uri);
+                const dto: HyperlinkDto = switch (entry.id) {
+                    .implicit => |implicit| .{
+                        .id = id,
+                        .kind = .implicit,
+                        .implicit_id = implicit,
+                        .explicit_id = null,
+                        .uri = try bytesToWire(alloc, uri),
+                    },
+                    .explicit => |slice| explicit: {
+                        const value = slice.slice(native.memory);
+                        if (value.len == 0 or !std.unicode.utf8ValidateSlice(value))
+                            return error.InvalidUnicode;
+                        try countString(counts, limits, value);
+                        break :explicit .{
+                            .id = id,
+                            .kind = .explicit,
+                            .implicit_id = null,
+                            .explicit_id = try bytesToWire(alloc, value),
+                            .uri = try bytesToWire(alloc, uri),
+                        };
+                    },
+                };
+                try links.append(alloc, dto);
+            }
+        }
+    };
+
+    var row_values: std.ArrayList(RowDto) = .empty;
+    for (rows) |*row| {
+        var cell_values: std.ArrayList(CellDto) = .empty;
+        for (row.cells.ptr(native.memory)[0..native.size.cols]) |*cell| {
+            var suffix: []const u32 = &.{};
+            if (cell.hasGrapheme()) {
+                const native_suffix = native.lookupGrapheme(cell) orelse return error.InvalidGrapheme;
+                try counts.add("grapheme_codepoints", native_suffix.len);
+                try counts.enforce(limits);
+                const copy = try alloc.alloc(u32, native_suffix.len);
+                for (native_suffix, copy) |cp, *destination| destination.* = cp;
+                suffix = copy;
+            }
+            try cell_values.append(alloc, .{
+                .content = contentFromNative(cell.*),
+                .width = widthFromNative(cell.wide),
+                .protected = cell.protected,
+                .semantic_content = semanticContentFromNative(cell.semantic_content),
+                .style = if (cell.style_id == stylepkg.default_id) null else
+                    style_ids.get(cell.style_id) orelse return error.InvalidStyleReference,
+                .hyperlink = if (cell.hyperlink)
+                    link_ids.get(native.lookupHyperlink(cell).?) orelse
+                        return error.InvalidHyperlinkReference
+                else null,
+                .grapheme_suffix = suffix,
+            });
+        }
+        try row_values.append(alloc, .{
+            .soft_wrap = row.wrap,
+            .wrap_continuation = row.wrap_continuation,
+            .semantic_prompt = semanticPromptFromNative(row.semantic_prompt),
+            .cells = try cell_values.toOwnedSlice(alloc),
+        });
+    }
+    try counts.enforce(limits);
+    return .{
+        .size = .{ .columns = native.size.cols, .rows = native.size.rows },
+        .capacity = capacityFromNative(native.capacity),
+        .styles = try styles.toOwnedSlice(alloc),
+        .hyperlinks = try links.toOwnedSlice(alloc),
+        .rows = try row_values.toOwnedSlice(alloc),
+    };
+}
+
+fn populatePage(alloc: Allocator, native: *Page, wire: PageDto) !void {
+    var styles = std.AutoHashMap(u32, stylepkg.Id).init(alloc);
+    defer styles.deinit();
+    var style_used = std.AutoHashMap(u32, void).init(alloc);
+    defer style_used.deinit();
+    for (wire.styles) |value| {
+        try styles.putNoClobber(value.id, try native.styles.add(
+            native.memory,
+            styleToNative(value),
+        ));
+    }
+
+    var links = std.AutoHashMap(u32, hyperlink.Id).init(alloc);
+    defer links.deinit();
+    var link_used = std.AutoHashMap(u32, void).init(alloc);
+    defer link_used.deinit();
+    for (wire.hyperlinks) |value| {
+        const uri = try wireToBytes(alloc, value.uri);
+        defer alloc.free(uri);
+        const explicit: ?[]u8 = if (value.explicit_id) |bytes|
+            try wireToBytes(alloc, bytes)
+        else
+            null;
+        defer if (explicit) |bytes| alloc.free(bytes);
+        try links.putNoClobber(value.id, try native.insertHyperlink(.{
+            .id = switch (value.kind) {
+                .implicit => .{ .implicit = value.implicit_id.? },
+                .explicit => .{ .explicit = explicit.? },
+            },
+            .uri = uri,
+        }));
+    }
+
+    for (wire.rows, 0..) |wire_row, y| {
+        const row = native.getRow(y);
+        row.wrap = wire_row.soft_wrap;
+        row.wrap_continuation = wire_row.wrap_continuation;
+        row.semantic_prompt = semanticPromptToNative(wire_row.semantic_prompt);
+        row.dirty = false;
+        for (wire_row.cells, native.getCells(row)) |wire_cell, *cell| {
+            cell.* = cellToNative(wire_cell);
+            if (wire_cell.style) |wire_id| {
+                const id = styles.get(wire_id) orelse return error.InvalidStyleReference;
+                const entry = try style_used.getOrPut(wire_id);
+                if (entry.found_existing) native.styles.use(native.memory, id);
+                cell.style_id = id;
+                row.styled = true;
+            }
+            if (wire_cell.hyperlink) |wire_id| {
+                const id = links.get(wire_id) orelse return error.InvalidHyperlinkReference;
+                const entry = try link_used.getOrPut(wire_id);
+                if (entry.found_existing) native.hyperlink_set.use(native.memory, id);
+                try native.setHyperlink(row, cell, id);
+            }
+            if (wire_cell.grapheme_suffix.len > 0) {
+                var suffix: [pagepkg.grapheme_max_len]u21 = undefined;
+                for (wire_cell.grapheme_suffix, suffix[0..wire_cell.grapheme_suffix.len]) |cp, *out|
+                    out.* = @intCast(cp);
+                try native.setGraphemes(row, cell, suffix[0..wire_cell.grapheme_suffix.len]);
+            }
+        }
+    }
+}
+
+fn capacityFromNative(value: pagepkg.Capacity) PageCapacity {
+    return .{
+        .columns = value.cols,
+        .rows = value.rows,
+        .styles = value.styles,
+        .hyperlink_bytes = value.hyperlink_bytes,
+        .grapheme_bytes = value.grapheme_bytes,
+        .string_bytes = value.string_bytes,
+    };
+}
+fn nativeCapacity(value: PageCapacity) pagepkg.Capacity {
+    return .{
+        .cols = value.columns,
+        .rows = value.rows,
+        .styles = value.styles,
+        .hyperlink_bytes = value.hyperlink_bytes,
+        .grapheme_bytes = value.grapheme_bytes,
+        .string_bytes = value.string_bytes,
+    };
+}
+fn toOptionalU64(value: ?usize) ?u64 {
+    return if (value) |finite| @intCast(finite) else null;
+}
+fn fromOptionalU64(value: ?u64) Error!?usize {
+    return if (value) |finite| std.math.cast(usize, finite) orelse
+        error.IntegerOverflow else null;
+}
+fn validScalar(cp: u32, allow_zero: bool) bool {
+    return (allow_zero or cp != 0) and cp <= 0x10ffff and
+        (cp < 0xd800 or cp > 0xdfff);
+}
+fn validUtf8(value: []const Byte) bool {
+    const raw: []const u8 = @ptrCast(value);
+    return std.unicode.utf8ValidateSlice(raw);
+}
+fn bytesToWire(alloc: Allocator, bytes: []const u8) ![]Byte {
+    const result = try alloc.alloc(Byte, bytes.len);
+    for (bytes, result) |byte, *wrapped| wrapped.* = .{ .value = byte };
+    return result;
+}
+fn wireToBytes(alloc: Allocator, bytes: []const Byte) ![]u8 {
+    const result = try alloc.alloc(u8, bytes.len);
+    for (bytes, result) |wrapped, *byte| byte.* = wrapped.value;
+    return result;
+}
+fn countString(counts: *Counts, limits: Limits, value: anytype) !void {
+    try counts.add("strings", 1);
+    try counts.add("string_bytes", value.len);
+    try counts.enforce(limits);
+}
+fn validateColor(value: Color) Error!void {
+    switch (value.kind) {
+        .none => if (value.palette != null or value.rgb != null) return error.InvalidStyle,
+        .palette => if (value.palette == null or value.rgb != null) return error.InvalidStyle,
+        .rgb => if (value.rgb == null or value.palette != null) return error.InvalidStyle,
+    }
+}
+
+fn encodeColor(value: Color) u32 {
+    return switch (value.kind) {
+        .none => 0,
+        .palette => (@as(u32, value.palette.?) << 2) | 1,
+        .rgb => rgb: {
+            const color = value.rgb.?;
+            const rgb_value = (@as(u32, color.red) << 16) |
+                (@as(u32, color.green) << 8) | color.blue;
+            break :rgb (rgb_value << 2) | 2;
+        },
+    };
+}
+
+fn decodeColor(value: u32) !Color {
+    return switch (value & 0x03) {
+        0 => if (value == 0) .{ .kind = .none, .palette = null, .rgb = null } else
+            error.UnexpectedToken,
+        1 => .{
+            .kind = .palette,
+            .palette = std.math.cast(u8, value >> 2) orelse return error.UnexpectedToken,
+            .rgb = null,
+        },
+        2 => if ((value >> 2) <= 0xffffff) rgb: {
+            const rgb_value = value >> 2;
+            break :rgb .{
+                .kind = .rgb,
+                .palette = null,
+                .rgb = .{
+                    .red = @truncate(rgb_value >> 16),
+                    .green = @truncate(rgb_value >> 8),
+                    .blue = @truncate(rgb_value),
+                },
+            };
+        } else error.UnexpectedToken,
+        else => error.UnexpectedToken,
+    };
+}
+
+fn encodeAttributes(value: Attributes) u16 {
+    var flags: u16 = 0;
+    flags |= @as(u16, @intFromBool(value.bold)) << 0;
+    flags |= @as(u16, @intFromBool(value.italic)) << 1;
+    flags |= @as(u16, @intFromBool(value.faint)) << 2;
+    flags |= @as(u16, @intFromBool(value.blink)) << 3;
+    flags |= @as(u16, @intFromBool(value.inverse)) << 4;
+    flags |= @as(u16, @intFromBool(value.invisible)) << 5;
+    flags |= @as(u16, @intFromBool(value.strikethrough)) << 6;
+    flags |= @as(u16, @intFromBool(value.overline)) << 7;
+    flags |= @as(u16, switch (value.underline) {
+        .none => 0,
+        .single => 1,
+        .double => 2,
+        .curly => 3,
+        .dotted => 4,
+        .dashed => 5,
+    }) << 8;
+    return flags;
+}
+
+fn decodeAttributes(flags: u16) !Attributes {
+    if ((flags & 0xf800) != 0) return error.UnexpectedToken;
+    const underline: Underline = switch ((flags >> 8) & 0x07) {
+        0 => .none,
+        1 => .single,
+        2 => .double,
+        3 => .curly,
+        4 => .dotted,
+        5 => .dashed,
+        else => return error.UnexpectedToken,
+    };
+    return .{
+        .bold = (flags & (1 << 0)) != 0,
+        .italic = (flags & (1 << 1)) != 0,
+        .faint = (flags & (1 << 2)) != 0,
+        .blink = (flags & (1 << 3)) != 0,
+        .inverse = (flags & (1 << 4)) != 0,
+        .invisible = (flags & (1 << 5)) != 0,
+        .strikethrough = (flags & (1 << 6)) != 0,
+        .overline = (flags & (1 << 7)) != 0,
+        .underline = underline,
+    };
+}
+
+fn decodeStyleWire(wire: StyleDto.Wire) !StyleDto {
+    return .{
+        .id = wire[0],
+        .foreground = try decodeColor(wire[1]),
+        .background = try decodeColor(wire[2]),
+        .underline_color = try decodeColor(wire[3]),
+        .attributes = try decodeAttributes(wire[4]),
+    };
+}
+
+fn encodeFlags(value: CellDto) !u8 {
+    const kind: u8 = switch (value.content.kind) {
+        .codepoint => 0,
+        .palette_background => 1,
+        .rgb_background => 2,
+    };
+    const width: u8 = switch (value.width) {
+        .narrow => 0,
+        .wide => 1,
+        .spacer_tail => 2,
+        .spacer_head => 3,
+    };
+    const semantic: u8 = switch (value.semantic_content) {
+        .output => 0,
+        .input => 1,
+        .prompt => 2,
+    };
+    return kind | (width << 2) | (@as(u8, @intFromBool(value.protected)) << 4) |
+        (semantic << 5);
+}
+
+fn encodeContent(value: Content) u32 {
+    return switch (value.kind) {
+        .codepoint => value.codepoint.?,
+        .palette_background => value.palette.?,
+        .rgb_background => rgb: {
+            const color = value.rgb.?;
+            break :rgb (@as(u32, color.red) << 16) |
+                (@as(u32, color.green) << 8) | color.blue;
+        },
+    };
+}
+
+fn decodeWire(wire: CellDto.Wire) !CellDto {
+    if ((wire[0] & 0x80) != 0) return error.UnexpectedToken;
+    const kind: ContentKind = switch (wire[0] & 0x03) {
+        0 => .codepoint,
+        1 => .palette_background,
+        2 => .rgb_background,
+        else => return error.UnexpectedToken,
+    };
+    const width: Width = switch ((wire[0] >> 2) & 0x03) {
+        0 => .narrow,
+        1 => .wide,
+        2 => .spacer_tail,
+        3 => .spacer_head,
+        else => unreachable,
+    };
+    const semantic_content: SemanticContent = switch ((wire[0] >> 5) & 0x03) {
+        0 => .output,
+        1 => .input,
+        2 => .prompt,
+        else => return error.UnexpectedToken,
+    };
+    const content: Content = switch (kind) {
+        .codepoint => .{
+            .kind = kind,
+            .codepoint = wire[1],
+            .palette = null,
+            .rgb = null,
+        },
+        .palette_background => .{
+            .kind = kind,
+            .codepoint = null,
+            .palette = std.math.cast(u8, wire[1]) orelse return error.UnexpectedToken,
+            .rgb = null,
+        },
+        .rgb_background => if (wire[1] <= 0xffffff) .{
+            .kind = kind,
+            .codepoint = null,
+            .palette = null,
+            .rgb = .{
+                .red = @truncate(wire[1] >> 16),
+                .green = @truncate(wire[1] >> 8),
+                .blue = @truncate(wire[1]),
+            },
+        } else return error.UnexpectedToken,
+    };
+    return .{
+        .content = content,
+        .width = width,
+        .protected = ((wire[0] >> 4) & 1) == 1,
+        .semantic_content = semantic_content,
+        .style = wire[2],
+        .hyperlink = wire[3],
+        .grapheme_suffix = wire[4],
+    };
+}
+
+fn contentFromNative(cell: Cell) Content {
+    return switch (cell.content_tag) {
+        .codepoint, .codepoint_grapheme => .{
+            .kind = .codepoint,
+            .codepoint = cell.content.codepoint.data,
+            .palette = null,
+            .rgb = null,
+        },
+        .bg_color_palette => .{
+            .kind = .palette_background,
+            .codepoint = null,
+            .palette = cell.content.color_palette.data,
+            .rgb = null,
+        },
+        .bg_color_rgb => .{
+            .kind = .rgb_background,
+            .codepoint = null,
+            .palette = null,
+            .rgb = .{
+                .red = cell.content.color_rgb.r,
+                .green = cell.content.color_rgb.g,
+                .blue = cell.content.color_rgb.b,
+            },
+        },
+    };
+}
+
+fn cellToNative(wire: CellDto) Cell {
+    var result: Cell = switch (wire.content.kind) {
+        .codepoint => .init(@intCast(wire.content.codepoint.?)),
+        .palette_background => .{
+            .content_tag = .bg_color_palette,
+            .content = .{ .color_palette = .{ .data = wire.content.palette.? } },
+        },
+        .rgb_background => block: {
+            const rgb = wire.content.rgb.?;
+            break :block .{
+                .content_tag = .bg_color_rgb,
+                .content = .{ .color_rgb = .{ .r = rgb.red, .g = rgb.green, .b = rgb.blue } },
+            };
+        },
+    };
+    result.wide = widthToNative(wire.width);
+    result.protected = wire.protected;
+    result.semantic_content = semanticContentToNative(wire.semantic_content);
+    return result;
+}
+
+fn widthFromNative(value: Cell.Wide) Width {
+    return switch (value) {
+        .narrow => .narrow,
+        .wide => .wide,
+        .spacer_tail => .spacer_tail,
+        .spacer_head => .spacer_head,
+    };
+}
+
+fn widthToNative(value: Width) Cell.Wide {
+    return switch (value) {
+        .narrow => .narrow,
+        .wide => .wide,
+        .spacer_tail => .spacer_tail,
+        .spacer_head => .spacer_head,
+    };
+}
+
+fn semanticContentFromNative(value: Cell.SemanticContent) SemanticContent {
+    return switch (value) {
+        .output => .output,
+        .input => .input,
+        .prompt => .prompt,
+    };
+}
+
+fn semanticContentToNative(value: SemanticContent) Cell.SemanticContent {
+    return switch (value) {
+        .output => .output,
+        .input => .input,
+        .prompt => .prompt,
+    };
+}
+
+fn semanticPromptFromNative(value: pagepkg.Row.SemanticPrompt) SemanticPrompt {
+    return switch (value) {
+        .none => .none,
+        .prompt => .prompt,
+        .prompt_continuation => .prompt_continuation,
+    };
+}
+
+fn semanticPromptToNative(value: SemanticPrompt) pagepkg.Row.SemanticPrompt {
+    return switch (value) {
+        .none => .none,
+        .prompt => .prompt,
+        .prompt_continuation => .prompt_continuation,
+    };
+}
+
+fn underlineFromNative(value: NativeUnderline) Underline {
+    return switch (value) {
+        .none => .none,
+        .single => .single,
+        .double => .double,
+        .curly => .curly,
+        .dotted => .dotted,
+        .dashed => .dashed,
+    };
+}
+
+fn underlineToNative(value: Underline) NativeUnderline {
+    return switch (value) {
+        .none => .none,
+        .single => .single,
+        .double => .double,
+        .curly => .curly,
+        .dotted => .dotted,
+        .dashed => .dashed,
+    };
+}
+
+fn colorFromNative(value: stylepkg.Style.Color) Color {
+    return switch (value) {
+        .none => .{ .kind = .none, .palette = null, .rgb = null },
+        .palette => |palette| .{ .kind = .palette, .palette = palette, .rgb = null },
+        .rgb => |rgb| .{ .kind = .rgb, .palette = null, .rgb = .{
+            .red = rgb.r, .green = rgb.g, .blue = rgb.b,
+        } },
+    };
+}
+fn colorToNative(value: Color) stylepkg.Style.Color {
+    return switch (value.kind) {
+        .none => .none,
+        .palette => .{ .palette = value.palette.? },
+        .rgb => block: {
+            const rgb = value.rgb.?;
+            break :block .{ .rgb = .{ .r = rgb.red, .g = rgb.green, .b = rgb.blue } };
+        },
+    };
+}
+fn styleFromNative(id: u32, value: stylepkg.Style) StyleDto {
+    return .{
+        .id = id,
+        .foreground = colorFromNative(value.fg_color),
+        .background = colorFromNative(value.bg_color),
+        .underline_color = colorFromNative(value.underline_color),
+        .attributes = .{
+            .bold = value.flags.bold,
+            .italic = value.flags.italic,
+            .faint = value.flags.faint,
+            .blink = value.flags.blink,
+            .inverse = value.flags.inverse,
+            .invisible = value.flags.invisible,
+            .strikethrough = value.flags.strikethrough,
+            .overline = value.flags.overline,
+            .underline = underlineFromNative(value.flags.underline),
+        },
+    };
+}
+fn styleToNative(value: StyleDto) stylepkg.Style {
+    return .{
+        .fg_color = colorToNative(value.foreground),
+        .bg_color = colorToNative(value.background),
+        .underline_color = colorToNative(value.underline_color),
+        .flags = .{
+            .bold = value.attributes.bold,
+            .italic = value.attributes.italic,
+            .faint = value.attributes.faint,
+            .blink = value.attributes.blink,
+            .inverse = value.attributes.inverse,
+            .invisible = value.attributes.invisible,
+            .strikethrough = value.attributes.strikethrough,
+            .overline = value.attributes.overline,
+            .underline = underlineToNative(value.attributes.underline),
+        },
+    };
+}
+
+fn captureOptions(list: *const PageList) PageList.Options {
+    return list.constructionOptions();
+}
+
+fn expectSemanticRoundtrip(source: *const PageList) !PageList {
+    const alloc = std.testing.allocator;
+    const bytes = try encodeAlloc(alloc, source, .{});
+    defer alloc.free(bytes);
+    var restored = try decode(alloc, bytes, .{});
+    errdefer restored.deinit();
+    const second = try encodeAlloc(alloc, &restored, .{});
+    defer alloc.free(second);
+    try std.testing.expectEqualStrings(bytes, second);
+    return restored;
+}
+
+fn buildRichList(alloc: Allocator) !PageList {
+    var builder = try PageList.Builder.init(alloc, .{
+        .cols = 4,
+        .rows = 2,
+        .max_size = null,
+        .max_lines = 300,
+    });
+    defer builder.deinit();
+    const first = try builder.allocatePage(.{
+        .cols = 4,
+        .rows = 4,
+        .styles = 16,
+        .hyperlink_bytes = 512,
+        .grapheme_bytes = 128,
+        .string_bytes = 256,
+    });
+    first.size.rows = 3;
+
+    const native_style = try first.styles.add(first.memory, .{
+        .fg_color = .{ .rgb = .{ .r = 1, .g = 2, .b = 3 } },
+        .bg_color = .{ .palette = 42 },
+        .underline_color = .{ .rgb = .{ .r = 4, .g = 5, .b = 6 } },
+        .flags = .{
+            .bold = true,
+            .italic = true,
+            .faint = true,
+            .blink = true,
+            .inverse = true,
+            .invisible = true,
+            .strikethrough = true,
+            .overline = true,
+            .underline = .curly,
+        },
+    });
+    const row0 = first.getRow(0);
+    const cells0 = first.getCells(row0);
+    cells0[0] = .init(0x1f469);
+    cells0[0].wide = .wide;
+    cells0[0].protected = true;
+    cells0[0].semantic_content = .prompt;
+    cells0[0].style_id = native_style;
+    row0.styled = true;
+    row0.semantic_prompt = .prompt;
+    try first.setGraphemes(row0, &cells0[0], &.{ 0x200d, 0x1f4bb });
+    cells0[1] = .{ .wide = .spacer_tail };
+    const explicit = try first.insertHyperlink(.{
+        .id = .{ .explicit = "build" },
+        .uri = "https://example.test/λ",
+    });
+    cells0[2] = .init('x');
+    try first.setHyperlink(row0, &cells0[2], explicit);
+    const implicit = try first.insertHyperlink(.{
+        .id = .{ .implicit = 77 },
+        .uri = "https://implicit.test/",
+    });
+    cells0[3] = .init('y');
+    cells0[3].semantic_content = .input;
+    try first.setHyperlink(row0, &cells0[3], implicit);
+
+    const row1 = first.getRow(1);
+    row1.wrap = true;
+    row1.semantic_prompt = .prompt_continuation;
+    first.getCells(row1)[3] = .{ .wide = .spacer_head };
+    const row2 = first.getRow(2);
+    row2.wrap_continuation = true;
+    first.getCells(row2)[0] = .init(0x754c);
+    first.getCells(row2)[0].wide = .wide;
+    first.getCells(row2)[1] = .{ .wide = .spacer_tail };
+    first.getCells(row2)[2] = .{
+        .content_tag = .bg_color_palette,
+        .content = .{ .color_palette = .{ .data = 9 } },
+    };
+    first.getCells(row2)[3] = .{
+        .content_tag = .bg_color_rgb,
+        .content = .{ .color_rgb = .{ .r = 7, .g = 8, .b = 9 } },
+    };
+
+    const second = try builder.allocatePage(.{ .cols = 4, .rows = 3 });
+    second.size.rows = 1;
+    second.getRowAndCell(0, 0).cell.* = .init('Z');
+    return builder.finish();
+}
+
+test "page checkpoint roundtrips Unicode style wide graphemes semantics and links" {
+    var source = try buildRichList(std.testing.allocator);
+    defer source.deinit();
+    var restored = try expectSemanticRoundtrip(&source);
+    defer restored.deinit();
+    try std.testing.expectEqual(@as(usize, 2), restored.totalPages());
+    const options = captureOptions(&restored);
+    try std.testing.expectEqual(@as(u16, 4), options.cols);
+    try std.testing.expectEqual(@as(u16, 2), options.rows);
+    try std.testing.expectEqual(@as(?usize, 300), options.max_lines);
+
+    var source_node = source.getTopLeft(.screen).node;
+    var restored_node = restored.getTopLeft(.screen).node;
+    while (true) {
+        try std.testing.expectEqualDeep(
+            source_node.capacity(),
+            restored_node.capacity(),
+        );
+        try std.testing.expectEqual(source_node.rows(), restored_node.rows());
+        source_node = source_node.next orelse break;
+        restored_node = restored_node.next orelse
+            return error.TestExpectedEqual;
+    }
+    try std.testing.expect(restored_node.next == null);
+}
+
+test "page checkpoint preserves suffix behavior across rollover reflow and pruning" {
+    const alloc = std.testing.allocator;
+    var builder = try PageList.Builder.init(alloc, .{
+        .cols = 2,
+        .rows = 1,
+        .max_size = null,
+        .max_lines = null,
+    });
+    defer builder.deinit();
+    for (0..220) |i| {
+        const page = try builder.allocatePage(.{ .cols = 2, .rows = 1 });
+        page.size.rows = 1;
+        page.getRowAndCell(0, 0).cell.* = .init(@intCast('a' + i % 26));
+    }
+    var source = try builder.finish();
+    defer source.deinit();
+    var restored = try expectSemanticRoundtrip(&source);
+    defer restored.deinit();
+
+    _ = try source.grow();
+    _ = try restored.grow();
+    try source.resize(.{ .cols = 3, .rows = 1, .reflow = true });
+    try restored.resize(.{ .cols = 3, .rows = 1, .reflow = true });
+    source.setMaxLines(215);
+    restored.setMaxLines(215);
+    source.setMaxBytes(2 * Page.layout(pagepkg.std_capacity).total_size);
+    restored.setMaxBytes(2 * Page.layout(pagepkg.std_capacity).total_size);
+
+    const first = try encodeAlloc(alloc, &source, .{});
+    defer alloc.free(first);
+    const second = try encodeAlloc(alloc, &restored, .{});
+    defer alloc.free(second);
+    try std.testing.expectEqualStrings(first, second);
+}
+
+fn validMinimalJson(alloc: Allocator) ![]u8 {
+    var builder = try PageList.Builder.init(alloc, .{ .cols = 2, .rows = 1 });
+    defer builder.deinit();
+    const page = try builder.allocatePage(.{ .cols = 2, .rows = 2 });
+    page.size.rows = 1;
+    var list = try builder.finish();
+    defer list.deinit();
+    return encodeAlloc(alloc, &list, .{});
+}
+
+test "page checkpoint preserves compressed source representation" {
+    const alloc = std.testing.allocator;
+    var builder = try PageList.Builder.init(alloc, .{
+        .cols = 2,
+        .rows = 1,
+        .max_size = null,
+        .max_lines = null,
+    });
+    defer builder.deinit();
+    for (0..4) |index| {
+        const page = try builder.allocatePage(.{ .cols = 2, .rows = 2 });
+        page.size.rows = 2;
+        page.getRowAndCell(0, 0).cell.* = .init(@intCast('A' + index));
+    }
+    var source = try builder.finish();
+    defer source.deinit();
+    if (source.compress(.full) == .unsupported) return error.SkipZigTest;
+    const first = source.getTopLeft(.screen).node;
+    try std.testing.expect(first.storage() == .compressed);
+    const before = source.memoryStats();
+
+    const bytes = try encodeAlloc(alloc, &source, .{});
+    defer alloc.free(bytes);
+    try std.testing.expect(first.storage() == .compressed);
+    try std.testing.expectEqualDeep(before, source.memoryStats());
+
+    var restored = try decode(alloc, bytes, .{});
+    defer restored.deinit();
+    const canonical = try encodeAlloc(alloc, &restored, .{});
+    defer alloc.free(canonical);
+    try std.testing.expectEqualStrings(bytes, canonical);
+}
+
+test "page checkpoint rejects malformed structures refs Unicode and alternate byte shapes" {
+    const alloc = std.testing.allocator;
+    const valid = try validMinimalJson(alloc);
+    defer alloc.free(valid);
+    var parsed = try std.json.parseFromSlice(Document, alloc, valid, .{});
+    defer parsed.deinit();
+
+    var wide_cells = try alloc.dupe(CellDto, parsed.value.pages[0].rows[0].cells);
+    defer alloc.free(wide_cells);
+    wide_cells[0].width = .wide;
+    var bad = parsed.value;
+    var bad_pages = try alloc.dupe(PageDto, bad.pages);
+    defer alloc.free(bad_pages);
+    var bad_rows = try alloc.dupe(RowDto, bad_pages[0].rows);
+    defer alloc.free(bad_rows);
+    bad_rows[0].cells = wide_cells;
+    bad_pages[0].rows = bad_rows;
+    bad.pages = bad_pages;
+    try std.testing.expectError(error.InvalidWideStructure, validate(alloc, &bad, .{}));
+
+    wide_cells[0].width = .narrow;
+    wide_cells[0].content.codepoint = 0xd800;
+    try std.testing.expectError(error.InvalidUnicode, validate(alloc, &bad, .{}));
+    wide_cells[0].content.codepoint = 0;
+    wide_cells[0].style = 7;
+    try std.testing.expectError(error.InvalidStyleReference, validate(alloc, &bad, .{}));
+
+    try std.testing.expectError(error.InputTooLarge, decode(alloc, valid, .{ .total_bytes = 1 }));
+    try std.testing.expectError(error.TooManyPages, decode(alloc, valid, .{ .pages = 0 }));
+    try std.testing.expectError(error.TooManyCells, decode(alloc, valid, .{ .cells = 1 }));
+
+    const with_string_uri =
+        \\{"schema":"kodosi-page-grid-history-checkpoint","version":1,"grid":{"columns":1,"active_rows":1,"max_scrollback_bytes":null,"max_scrollback_rows":null},"pages":[{"size":{"columns":1,"rows":1},"capacity":{"columns":1,"rows":1,"styles":1,"hyperlink_bytes":1,"grapheme_bytes":0,"string_bytes":1},"styles":[],"hyperlinks":[{"id":1,"kind":"implicit","implicit_id":1,"explicit_id":null,"uri":"x"}],"rows":[]}]}
+    ;
+    try std.testing.expectError(error.UnexpectedToken, decode(alloc, with_string_uri, .{}));
+}
+
+test "page checkpoint validation uses caller allocator transactionally" {
+    const alloc = std.testing.allocator;
+    var source = try buildRichList(alloc);
+    defer source.deinit();
+    const valid = try encodeAlloc(alloc, &source, .{});
+    defer alloc.free(valid);
+    var parsed = try std.json.parseFromSlice(Document, alloc, valid, .{});
+    defer parsed.deinit();
+    var failing = std.testing.FailingAllocator.init(alloc, .{});
+    failing.fail_index = 0;
+    try std.testing.expectError(error.OutOfMemory, validate(
+        failing.allocator(),
+        &parsed.value,
+        .{},
+    ));
+}
