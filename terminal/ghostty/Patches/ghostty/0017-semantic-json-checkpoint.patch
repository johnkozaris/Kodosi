+    pub fn deinit(self: *ScreenState, alloc: Allocator) void {
+        if (self.cursor.activeHyperlink) |link| {
+            alloc.free(link.uri);
+            if (link.explicitId) |id| alloc.free(id);
+        }
+        self.* = undefined;
+    }
