+
+fn expectScreenSuffixParity(
+    source: *Terminal,
+    source_stream: *TerminalStream,
+    suffix: []const u8,
+) !void {
+    const testing = std.testing;
+    const terminal_state = TerminalState.capture(source);
+    var state = try captureScreen(testing.allocator, .primary, source.screens.active);
+    defer state.deinit(testing.allocator);
+    var parser = try captureParser(
+        testing.allocator,
+        source_stream,
+        limits.max_continuation_bytes,
+    );
+    defer parser.deinit(testing.allocator);
+
+    var screen_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer screen_json.deinit();
+    try writeScreenState(&screen_json.writer, state, source.cols, source.rows);
+    var parser_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer parser_json.deinit();
+    try writeParserState(testing.allocator, &parser_json.writer, parser);
+
+    const parsed_screen = try parseScreenState(
+        testing.allocator,
+        screen_json.written(),
+        source.cols,
+        source.rows,
+    );
+    defer parsed_screen.deinit();
+    const parsed_parser = try parseParserState(
+        testing.allocator,
+        parser_json.written(),
+    );
+    defer parsed_parser.deinit();
+
+    const restored_set = try restoreScreenSet(
+        testing.io,
+        testing.allocator,
+        .{
+            .cols = source.cols,
+            .rows = source.rows,
+            .max_scrollback_bytes = 0,
+            .kitty_image_storage_limit = 0,
+        },
+        terminal_state,
+        &.{parsed_screen.value},
+    );
+
+    var restored = try Terminal.init(testing.io, testing.allocator, .{
+        .cols = source.cols,
+        .rows = source.rows,
+        .max_scrollback_bytes = 0,
+        .kitty_image_storage_limit = 0,
+    });
+    defer restored.deinit(testing.allocator);
+    restored.screens.deinit(testing.allocator);
+    restored.screens = restored_set;
+
+    var restored_stream = testStream(&restored);
+    defer restored_stream.deinit();
+    try restoreParser(testing.allocator, &restored_stream, parsed_parser.value);
+
+    source_stream.nextSlice(suffix);
+    restored_stream.nextSlice(suffix);
+
+    var expected = try captureScreen(testing.allocator, .primary, source.screens.active);
+    defer expected.deinit(testing.allocator);
+    var actual = try captureScreen(testing.allocator, .primary, restored.screens.active);
+    defer actual.deinit(testing.allocator);
+
+    var expected_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer expected_json.deinit();
+    try writeScreenState(&expected_json.writer, expected, source.cols, source.rows);
+    var actual_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer actual_json.deinit();
+    try writeScreenState(&actual_json.writer, actual, restored.cols, restored.rows);
+    try testing.expectEqualStrings(expected_json.written(), actual_json.written());
+
+    var expected_parser = try captureParser(
+        testing.allocator,
+        source_stream,
+        limits.max_continuation_bytes,
+    );
+    defer expected_parser.deinit(testing.allocator);
+    var actual_parser = try captureParser(
+        testing.allocator,
+        &restored_stream,
+        limits.max_continuation_bytes,
+    );
+    defer actual_parser.deinit(testing.allocator);
+    var expected_parser_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer expected_parser_json.deinit();
+    try writeParserState(testing.allocator, &expected_parser_json.writer, expected_parser);
+    var actual_parser_json: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer actual_parser_json.deinit();
+    try writeParserState(testing.allocator, &actual_parser_json.writer, actual_parser);
+    try testing.expectEqualStrings(
+        expected_parser_json.written(),
+        actual_parser_json.written(),
+    );
+}
