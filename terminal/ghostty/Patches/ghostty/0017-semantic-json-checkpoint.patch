+/// Transactionally restore semantic terminal and parser state for a host-managed
+/// surface. The terminal address and every callback/config pointer remain stable.
+pub fn restoreCheckpointLocked(
+    self: *Termio,
+    json: []const u8,
+    options: *const checkpoint.RestoreOptions,
+    info: ?checkpoint.InfoOutput,
+    pre_commit_context: anytype,
+    comptime preCommit: fn (@TypeOf(pre_commit_context)) void,
+) Result {
+    if (!checkpoint.validSize(options.size, checkpoint.RestoreOptions) or
+        !checkpoint.validLimits(options.limits)) return .invalid_value;
+    if (json.len > options.limits.max_json_bytes) return .limit_exceeded;
+
+    var constructed = checkpoint.constructTerminal(
+        self.alloc,
+        global.io(),
+        json,
+        options.limits,
+    ) catch |err| return checkpoint.mapError(err);
+    var new_terminal = constructed.terminal;
+    var new_terminal_owned = true;
+    defer constructed.parser.deinit(self.alloc);
+    errdefer if (new_terminal_owned) new_terminal.deinit(self.alloc);
+
+    // Preserve visual configuration and safety policy, never source policy.
+    new_terminal.screens.replaceGenerationsFrom(&self.terminal.screens);
+    new_terminal.flags.focused = self.terminal.flags.focused;
+    new_terminal.flags.visible = self.terminal.flags.visible;
+    if (comptime @hasField(terminalpkg.Screen, "kitty_images")) {
+        var screens = new_terminal.screens.all.iterator();
+        while (screens.next()) |entry| {
+            const screen = entry.value.*;
+            screen.kitty_images.setLimit(
+                screen.io,
+                screen.alloc,
+                screen,
+                self.config.image_storage_limit,
+            );
+            screen.kitty_images.image_limits = .allWithTempDir(global.tmpDirPath());
+        }
+    }
+
+    var handler = freshStreamHandler(self);
+    handler.terminal = &new_terminal;
+    var new_stream: StreamHandler.Stream = .init(.{
+        .allocator = self.alloc,
+        .handler = handler,
+        .continuation_max_bytes = @max(
+            checkpoint.decodedContinuationLen(constructed.parser) catch return .invalid_value,
+            @as(usize, 1),
+        ),
+    });
+    var new_stream_owned = true;
+    errdefer if (new_stream_owned) new_stream.deinit();
+    terminalpkg.checkpoint_screen_json.restoreParser(
+        self.alloc,
+        &new_stream,
+        constructed.parser,
+    ) catch |err| return checkpoint.mapError(err);
+
+    const terminal_width = std.math.mul(
+        u32,
+        @as(u32, new_terminal.cols),
+        self.size.cell.width,
+    ) catch return .limit_exceeded;
+    const terminal_height = std.math.mul(
+        u32,
+        @as(u32, new_terminal.rows),
+        self.size.cell.height,
+    ) catch return .limit_exceeded;
+    const new_size: renderer.Size = .{
+        .screen = .{
+            .width = std.math.add(
+                u32,
+                terminal_width,
+                self.size.padding.left + self.size.padding.right,
+            ) catch return .limit_exceeded,
+            .height = std.math.add(
+                u32,
+                terminal_height,
+                self.size.padding.top + self.size.padding.bottom,
+            ) catch return .limit_exceeded,
+        },
+        .cell = self.size.cell,
+        .padding = self.size.padding,
