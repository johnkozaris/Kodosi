+    defer restored.terminal.deinit(std.testing.allocator);
+    try std.testing.expect(restored.terminal.tabstops.get(3));
+    try std.testing.expect(restored.terminal.tabstops.get(10));
+    try std.testing.expect(!restored.terminal.tabstops.get(8));
+    try std.testing.expectEqual(source.scrolling_region, restored.terminal.scrolling_region);
+}
