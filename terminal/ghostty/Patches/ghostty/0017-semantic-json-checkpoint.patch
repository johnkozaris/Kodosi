+        .{},
+    ));
+}
+
+test "terminal-wide JSON round trip is canonical and independent of parser continuation" {
+    var source = try testTerminal();
+    defer source.deinit(std.testing.allocator);
+    const first = try encodeAlloc(std.testing.allocator, &source);
+    defer std.testing.allocator.free(first);
+    var decoded = try decode(std.testing.allocator, first, .{});
+    defer decoded.deinit();
+    var restored = try decoded.createTerminal(std.testing.io, std.testing.allocator);
+    defer restored.deinit(std.testing.allocator);
+    const second = try encodeAlloc(std.testing.allocator, &restored);
+    defer std.testing.allocator.free(second);
+    try std.testing.expectEqualStrings(first, second);
+}
