+const info_test_sizes = [_]usize{
+    0,
+    @sizeOf(usize),
+    @offsetOf(Info, "json_bytes") + @sizeOf(usize) - 1,
+    @sizeOf(Info),
+    @sizeOf(Info) + 16,
+};
+
+const InfoTestStorage = [8]usize;
+
+fn testInfoInit(storage: *InfoTestStorage, size: usize) struct { *Info, [@sizeOf(InfoTestStorage)]u8 } {
+    @memset(std.mem.asBytes(storage), 0xA5);
+    const info: *Info = @ptrCast(storage);
+    info.size = size;
+    return .{ info, std.mem.asBytes(storage).* };
+}
+
+fn testInfoExpected(
+    storage: *InfoTestStorage,
+    before: *const [@sizeOf(InfoTestStorage)]u8,
+    size: usize,
+    json_bytes: ?usize,
+) !void {
+    const after = std.mem.asBytes(storage);
+    const unchanged_from = if (size < @sizeOf(usize)) 0 else size;
+    try testing.expectEqualSlices(u8, before[unchanged_from..], after[unchanged_from..]);
+
+    const info: *Info = @ptrCast(storage);
+    try testing.expectEqual(size, info.size);
+    inline for (.{ "schema_version", "json_bytes", "continuation_bytes" }) |field| {
+        const offset = @offsetOf(Info, field);
+        const field_size = @sizeOf(@FieldType(Info, field));
+        if (!lib.structSizedFieldFits(Info, size, field)) {
+            try testing.expectEqualSlices(u8, before[offset .. offset + field_size], after[offset .. offset + field_size]);
+        }
+    }
+    if (lib.structSizedFieldFits(Info, size, "schema_version")) {
+        try testing.expectEqual(schema_version, info.schema_version);
+    }
+    if (lib.structSizedFieldFits(Info, size, "json_bytes")) {
+        try testing.expectEqual(json_bytes orelse 0, info.json_bytes);
+    }
+    if (lib.structSizedFieldFits(Info, size, "continuation_bytes")) {
+        try testing.expectEqual(@as(usize, 0), info.continuation_bytes);
+    }
+}
