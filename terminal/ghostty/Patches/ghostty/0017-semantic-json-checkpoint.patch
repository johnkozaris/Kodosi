+test "terminal-wide JSON rejects bounds enums limits and noncanonical sets" {
+    const valid =
+        \\{"schema":"kodosi-terminal-wide-checkpoint","version":1,"dimensions":{"columns":2,"rows":2,"width_px":0,"height_px":0},"margins":{"top":0,"bottom":1,"left":0,"right":1},"status_display":1,"screens":{"initialized":[1],"active":1},"tab_stops":[],"modes":{"current":[],"saved":[],"default":[]},"effective_mouse":{"event":1,"format":1},"previous_printable":null,"cursor_defaults":{"is_default":true,"style":2,"blink":false},"flags":{"modify_other_keys_2":false,"mouse_shift_capture":null,"focused":true,"visible":true,"password_input":false,"shell_redraw":1},"mouse_shape":9,"colors":{"foreground":{"default":null,"override":null},"background":{"default":null,"override":null},"cursor":{"default":null,"override":null},"original_palette":[],"palette_overrides":[]},"text":{"pwd":[],"title":[]},"scrollback":{"max_bytes":0,"max_lines":0},"graphics":{"kitty_images":0,"kitty_placements":0,"kitty_loading":false,"glyphs":0}}
+    ;
+    var parsed = try std.json.parseFromSlice(Document, std.testing.allocator, valid, .{});
+    defer parsed.deinit();
+    const original_palette = [_]RGB{.{ .r = 0, .g = 0, .b = 0 }} ** 256;
+    parsed.value.colors.original_palette = &original_palette;
+
+    var candidate = parsed.value;
+    candidate.dimensions.columns = 0;
+    try std.testing.expectError(error.InvalidDimensions, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.dimensions.columns = 2;
+    candidate.dimensions.rows = 2;
+    try std.testing.expectError(error.InvalidDimensions, validate(&candidate, .{ .max_cells = 3 }));
+    candidate = parsed.value;
+    candidate.margins.right = 2;
+    try std.testing.expectError(error.InvalidMargins, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.status_display = 99;
+    try std.testing.expectError(error.InvalidEnum, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.scrollback.max_bytes = std.math.maxInt(u64);
+    try std.testing.expectError(error.InvalidScrollbackLimit, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.tab_stops = &.{ 1, 1 };
+    try std.testing.expectError(error.InvalidTabStop, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.modes.current = &.{ 2, 1 };
+    try std.testing.expectError(error.InvalidModeSet, validate(&candidate, .{}));
+    candidate = parsed.value;
+    candidate.graphics.glyphs = 1;
+    try std.testing.expectError(error.UnsupportedGraphics, validate(&candidate, .{}));
+}
+
+test "terminal-wide JSON rejects unknown and duplicate fields" {
+    try std.testing.expectError(error.UnknownField, decode(
+        std.testing.allocator,
+        "{\"schema\":\"kodosi-terminal-wide-checkpoint\",\"version\":1,\"extra\":0}",
+        .{},
+    ));
+    try std.testing.expectError(error.DuplicateField, decode(
