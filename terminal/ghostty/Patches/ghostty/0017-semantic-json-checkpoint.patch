+test "terminal-wide JSON preserves REP previous printable" {
+    var source = try testTerminal();
+    defer source.deinit(std.testing.allocator);
+    try source.print('R');
+
+    var restored = try roundTrip(&source);
+    defer std.testing.allocator.free(restored.bytes);
+    defer restored.terminal.deinit(std.testing.allocator);
+    try restored.terminal.printRepeat(2);
+    const text = try restored.terminal.plainString(std.testing.allocator);
+    defer std.testing.allocator.free(text);
+    try std.testing.expectEqualStrings("RR", text);
+}
