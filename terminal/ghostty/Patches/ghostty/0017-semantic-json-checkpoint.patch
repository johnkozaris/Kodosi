+test "terminal-wide JSON preserves current saved and default mode sets" {
+    var source = try testTerminal();
+    defer source.deinit(std.testing.allocator);
+    source.modes.set(.cursor_keys, true);
+    source.modes.save(.cursor_keys);
+    source.modes.set(.cursor_keys, false);
+    source.modes.setDefault(.grapheme_cluster, true);
+
+    var restored = try roundTrip(&source);
+    defer std.testing.allocator.free(restored.bytes);
+    defer restored.terminal.deinit(std.testing.allocator);
+    try std.testing.expect(!restored.terminal.modes.get(.cursor_keys));
+    try std.testing.expect(restored.terminal.modes.saved.cursor_keys);
+    try std.testing.expect(restored.terminal.modes.default.grapheme_cluster);
+    try std.testing.expect(restored.terminal.modes.get(.grapheme_cluster));
+    try std.testing.expect(restored.terminal.modes.restore(.cursor_keys));
+    restored.terminal.modes.set(.grapheme_cluster, false);
+    restored.terminal.modes.reset();
+    try std.testing.expect(restored.terminal.modes.get(.grapheme_cluster));
+}
