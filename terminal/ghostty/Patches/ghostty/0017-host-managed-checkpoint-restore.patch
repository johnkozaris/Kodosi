+    /// Transactionally replace the terminal of a host-managed surface with a
+    /// Ghostty snapshot before any subsequently serialized live output.
+    export fn ghostty_surface_checkpoint_restore(
+        surface_: ?*Surface,
+        ptr: ?[*]const u8,
+        len: usize,
+        resize_pull_scrollback: bool,
+    ) Result {
+        const surface = surface_ orelse return .invalid_value;
+        if (surface.termio_backend != .host_managed or
+            surface.core_surface.io.backend.host_managed.isExited()) return .invalid_value;
+        const snapshot = if (ptr) |data|
+            data[0..len]
+        else if (len == 0)
+            &.{}
+        else
+            return .invalid_value;
+
+        const core = &surface.core_surface;
+        if (core.search != null) return .invalid_value;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        const result = core.io.restoreCheckpointLocked(
+            snapshot,
+            resize_pull_scrollback,
+            core,
+            struct {
+                fn call(ctx: *CoreSurface) void {
+                    ctx.mouse.selection_gesture.reset(&ctx.io.terminal);
+                    ctx.setSelectionWithoutNotification(null);
+                }
+            }.call,
+        );
+        if (result == .success) core.applyCheckpointGeometry(core.io.size);
+        const restored = if (result == .success)
+            core.checkpointRestoredMessage()
+        else
+            null;
+        core.renderer_state.mutex.unlock(global.io());
+        if (result == .success) {
+            if (restored) |notification| {
+                core.deferCheckpointRestored(notification);
+            } else {
+                log.warn("unable to allocate checkpoint metadata notification", .{});
+            }
+            core.queueRender() catch {};
+        }
+        return result;
+    }
