+test "checkpoint notifications coalesce without producers when the app mailbox is full" {
+    const testing = std.testing;
+
+    var app_mailbox: App.Mailbox.Queue = .{};
+    for (0..64) |_| {
+        try testing.expect(app_mailbox.push(
+            testing.io,
+            .{ .quit = {} },
+            .{ .instant = {} },
+        ) > 0);
+    }
+
+    const FullMailbox = struct {
+        queue: *App.Mailbox.Queue,
+        pushes: *usize,
+
+        fn push(
+            self: @This(),
+            message: apprt.surface.Message,
+            timeout: App.Mailbox.Queue.Timeout,
+        ) App.Mailbox.Queue.Size {
+            self.pushes.* += 1;
+            return self.queue.push(global.io(), .{
+                .surface_message = .{
+                    .surface = undefined,
+                    .message = message,
+                },
+            }, timeout);
+        }
+    };
+
+    var pending: PendingCheckpointRestored = .{};
+    defer pending.deinit();
+    var pushes: usize = 0;
+
+    var first_title: [256]u8 = @splat(0);
+    @memcpy(first_title[0.."first".len], "first");
+    pending.publish(FullMailbox{
+        .queue = &app_mailbox,
+        .pushes = &pushes,
+    }, .{
+        .title = first_title,
+        .pwd = try apprt.surface.Message.WriteReq.init(
+            testing.allocator,
+            @as([]const u8, "first-" ** 64),
+        ),
+        .mouse_shape = .text,
+        .selection_changed = true,
+    });
+
+    var latest_title: [256]u8 = @splat(0);
+    @memcpy(latest_title[0.."latest".len], "latest");
+    pending.publish(FullMailbox{
+        .queue = &app_mailbox,
+        .pushes = &pushes,
+    }, .{
+        .title = latest_title,
+        .pwd = try apprt.surface.Message.WriteReq.init(
+            testing.allocator,
+            @as([]const u8, "latest-" ** 64),
+        ),
+        .mouse_shape = .pointer,
+        .selection_changed = true,
+    });
+
+    const latest = pending.take().?;
+    defer latest.deinit();
+    try testing.expectEqualStrings(
+        "latest",
+        std.mem.sliceTo(&latest.title, 0),
+    );
+    try testing.expectEqualStrings("latest-" ** 64, latest.pwd.slice());
+    try testing.expectEqual(terminal.MouseShape.pointer, latest.mouse_shape);
+    try testing.expectEqual(@as(usize, 1), pushes);
+
+    pending.publish(FullMailbox{
+        .queue = &app_mailbox,
+        .pushes = &pushes,
+    }, .{
+        .title = @splat(0),
+        .pwd = try apprt.surface.Message.WriteReq.init(
+            testing.allocator,
+            @as([]const u8, "cleanup-" ** 64),
+        ),
+        .mouse_shape = .text,
+        .selection_changed = true,
+    });
+    try testing.expectEqual(@as(usize, 2), pushes);
+
+    while (app_mailbox.pop(testing.io)) |_| {}
+}
