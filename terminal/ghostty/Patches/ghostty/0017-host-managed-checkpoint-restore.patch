+    const terminal_width = std.math.mul(
+        u32,
+        @as(u32, new_terminal.cols),
+        self.size.cell.width,
+    ) catch return .limit_exceeded;
+    const terminal_height = std.math.mul(
+        u32,
+        @as(u32, new_terminal.rows),
+        self.size.cell.height,
+    ) catch return .limit_exceeded;
+    const new_size: renderer.Size = .{
+        .screen = .{
+            .width = std.math.add(
+                u32,
+                terminal_width,
+                self.size.padding.left + self.size.padding.right,
+            ) catch return .limit_exceeded,
+            .height = std.math.add(
+                u32,
+                terminal_height,
+                self.size.padding.top + self.size.padding.bottom,
+            ) catch return .limit_exceeded,
+        },
+        .cell = self.size.cell,
+        .padding = self.size.padding,
+    };
+    new_terminal.width_px = terminal_width;
+    new_terminal.height_px = terminal_height;
+
+    preCommit(pre_commit_context);
+    var old_terminal = self.terminal;
+    var old_stream = self.terminal_stream;
+    self.terminal = new_terminal;
+    new_terminal_owned = false;
+    self.terminal_stream = new_stream;
+    self.size = new_size;
+    new_stream_owned = false;
+    self.terminal_stream.handler.terminal = &self.terminal;
+    self.renderer_state.terminal = &self.terminal;
