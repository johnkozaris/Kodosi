+const PendingCheckpointRestored = struct {
+    mutex: std.Io.Mutex = .init,
+    value: ?apprt.surface.CheckpointRestored = null,
+    marker_pending: bool = false,
+
+    fn publish(
+        self: *PendingCheckpointRestored,
+        mailbox: anytype,
+        restored: apprt.surface.CheckpointRestored,
+    ) void {
+        self.mutex.lockUncancelable(global.io());
+        if (self.value) |previous| previous.deinit();
+        self.value = restored;
+        if (self.marker_pending) {
+            self.mutex.unlock(global.io());
+            return;
+        }
+        self.marker_pending = true;
+        self.mutex.unlock(global.io());
+
+        _ = mailbox.push(.{ .checkpoint_restored = {} }, .{ .instant = {} });
+    }
+
+    fn take(
+        self: *PendingCheckpointRestored,
+    ) ?apprt.surface.CheckpointRestored {
+        self.mutex.lockUncancelable(global.io());
+        defer self.mutex.unlock(global.io());
+
+        const result = self.value;
+        self.value = null;
+        self.marker_pending = false;
+        return result;
+    }
+
+    fn deinit(self: *PendingCheckpointRestored) void {
+        if (self.take()) |restored| restored.deinit();
+    }
+};
+
+pub fn checkpointRestoredMessage(
+    self: *Surface,
+) ?apprt.surface.CheckpointRestored {
+    return apprt.surface.CheckpointRestored.init(
+        self.alloc,
+        &self.io.terminal,
+    ) catch null;
+}
+
+pub fn deferCheckpointRestored(
+    self: *Surface,
+    restored: apprt.surface.CheckpointRestored,
+) void {
+    self.checkpoint_restored.publish(self.io.surface_mailbox, restored);
+}
+
+pub fn flushCheckpointRestored(self: *Surface) void {
+    const restored = self.checkpoint_restored.take() orelse return;
+    defer restored.deinit();
+
+    if (restored.selection_changed) self.checkpointSelectionChanged();
+    self.handleMessage(.{ .set_title = restored.title }) catch {};
+    self.handleMessage(.{ .set_mouse_shape = restored.mouse_shape }) catch {};
+    var stack = std.heap.stackFallback(256, self.alloc);
+    const pwd_value = stack.get().dupeZ(u8, restored.pwd.slice()) catch return;
+    defer stack.get().free(pwd_value);
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .pwd,
+        .{ .pwd = pwd_value },
+    ) catch {};
+}
