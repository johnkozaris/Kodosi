+/// The longest unfinished input that a restored terminal accepts, the same
+/// bound as the host's own terminals.
+const checkpoint_continuation_max_bytes = 1024 * 1024;
+
+/// Transactionally replace the terminal of a host-managed surface with a
+/// Ghostty snapshot. A snapshot that ends at READY carries the visible screen
+/// without history. The terminal address and every callback/config pointer
+/// remain stable.
+pub fn restoreCheckpointLocked(
+    self: *Termio,
+    bytes: []const u8,
+    resize_pull_scrollback: bool,
+    pre_commit_context: anytype,
+    comptime preCommit: fn (@TypeOf(pre_commit_context)) void,
+) Result {
+    var reader: std.Io.Reader = .fixed(bytes);
+    var decoder: terminalpkg.snapshot.Decoder = .init(&reader);
+    var decoded = decoder.ready(self.alloc, global.io(), .{
+        .max_continuation_bytes = checkpoint_continuation_max_bytes,
+    }) catch |err| return snapshotResult(err);
+    defer decoded.deinit(self.alloc);
+    var new_terminal = decoded.toOwned();
+    var new_terminal_owned = true;
+    defer if (new_terminal_owned) new_terminal.deinit(self.alloc);
+    if (reader.bufferedLen() > 0) {
+        while (decoder.next(self.alloc, &new_terminal) catch |err| return snapshotResult(err)) |_| {}
+        if (reader.bufferedLen() > 0) return .invalid_value;
+    }
+
+    // Preserve visual configuration and safety policy, never source policy.
+    new_terminal.colors.palette.changeDefault(
+        self.alloc,
+        self.config.palette,
+    ) catch return .out_of_memory;
+    new_terminal.colors.background.default = self.config.background.toTerminalRGB();
+    new_terminal.colors.foreground.default = self.config.foreground.toTerminalRGB();
+    new_terminal.colors.cursor.default = cursor: {
+        const color = self.config.cursor_color orelse break :cursor null;
+        break :cursor color.toTerminalRGB() orelse break :cursor null;
+    };
+    new_terminal.screens.replaceGenerationsFrom(&self.terminal.screens);
+    new_terminal.flags.focused = self.terminal.flags.focused;
+    new_terminal.flags.visible = self.terminal.flags.visible;
+    new_terminal.flags.resize_pull_scrollback = resize_pull_scrollback;
+    if (comptime @hasField(terminalpkg.Screen, "kitty_images")) {
+        var screens = new_terminal.screens.all.iterator();
+        while (screens.next()) |entry| {
+            const screen = entry.value.*;
+            screen.kitty_images.setLimit(
+                screen.io,
+                screen.alloc,
