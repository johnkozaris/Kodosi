+test "checkpoint renderer replacement survives a full ordered mailbox" {
+    const testing = std.testing;
+
+    const mailbox = try renderer.Thread.Mailbox.create(testing.allocator);
+    defer mailbox.destroy(testing.allocator);
+    for (0..64) |_| {
+        try testing.expect(mailbox.push(
+            testing.io,
+            .{ .focus = false },
+            .{ .instant = {} },
+        ) > 0);
+    }
+
+    var wakeup = try xev.Async.init();
+    defer wakeup.deinit();
+
+    var mutex: std.Io.Mutex = .init;
+    var state: renderer.State = .{
+        .mutex = &mutex,
+        .terminal = undefined,
+    };
+    var handler: StreamHandler = undefined;
+    handler.renderer_state = &state;
+    handler.renderer_mailbox = mailbox;
+    handler.renderer_wakeup = wakeup;
+
+    const expected_size: renderer.Size = .{
+        .screen = .{ .width = 1200, .height = 800 },
+        .cell = .{ .width = 10, .height = 20 },
+        .padding = .{},
+    };
+    const Consumer = struct {
+        mailbox: *renderer.Thread.Mailbox,
+        mutex: *std.Io.Mutex,
+        expected_size: renderer.Size,
+        restore_returned: *std.atomic.Value(bool),
+        released_mutex: std.atomic.Value(bool) = .init(false),
+        ordered: std.atomic.Value(bool) = .init(false),
+        correct_size: std.atomic.Value(bool) = .init(false),
+        premature_return: std.atomic.Value(bool) = .init(false),
+
+        fn run(self: *@This()) void {
+            self.mutex.lockUncancelable(global.io());
+            self.released_mutex.store(true, .release);
+            self.mutex.unlock(global.io());
+
+            var count: usize = 0;
+            for (0..5_000) |_| {
+                const message = self.mailbox.pop(global.io()) orelse {
+                    std.Io.sleep(
+                        global.io(),
+                        .fromMilliseconds(1),
+                        .awake,
+                    ) catch return;
+                    continue;
+                };
+
+                switch (message) {
+                    .focus => count += 1,
+                    .terminal_replaced => |replacement| {
+                        self.ordered.store(count == 64, .release);
+                        self.correct_size.store(
+                            std.meta.eql(replacement.size, self.expected_size),
+                            .release,
+                        );
+                        std.Io.sleep(
+                            global.io(),
+                            .fromMilliseconds(10),
+                            .awake,
+                        ) catch {};
+                        self.premature_return.store(
+                            self.restore_returned.load(.acquire),
+                            .release,
+                        );
+                        replacement.complete.post(global.io());
+                        return;
+                    },
+                    else => {},
+                }
+            }
+        }
+    };
+
+    var restore_returned: std.atomic.Value(bool) = .init(false);
+    var consumer: Consumer = .{
+        .mailbox = mailbox,
+        .mutex = &mutex,
+        .expected_size = expected_size,
+        .restore_returned = &restore_returned,
+    };
+    mutex.lockUncancelable(global.io());
+    const thread = try std.Thread.spawn(.{}, Consumer.run, .{&consumer});
+    handler.checkpointRendererReplaced(expected_size);
+    restore_returned.store(true, .release);
+    mutex.unlock(global.io());
+    thread.join();
+
+    try testing.expect(consumer.released_mutex.load(.acquire));
+    try testing.expect(consumer.ordered.load(.acquire));
+    try testing.expect(consumer.correct_size.load(.acquire));
+    try testing.expect(!consumer.premature_return.load(.acquire));
+    try testing.expect(mailbox.pop(testing.io) == null);
+}
