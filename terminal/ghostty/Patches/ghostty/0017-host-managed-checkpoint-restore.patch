+    var handler = freshStreamHandler(self);
+    handler.terminal = &new_terminal;
+    var new_stream: StreamHandler.Stream = .init(.{
+        .allocator = self.alloc,
+        .handler = handler,
+    });
+    var new_stream_owned = true;
+    defer if (new_stream_owned) new_stream.deinit();
