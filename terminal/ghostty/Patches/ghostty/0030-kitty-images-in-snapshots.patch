@@ -0,0 +1,907 @@
+//! KITTY records: the Kitty graphics state of a screen.
+//!
+//! A screen with Kitty graphics state writes these records after its SCREEN
+//! pages, so the state is part of the renderable prefix:
+//!
+//! ```text
+//! KITTY_STORAGE      storage limit, ID counters, image count, loading flag
+//! KITTY_IMAGE        one per stored image, oldest first
+//! KITTY_LOADING      the unfinished chunked transmission, if there is one
+//! KITTY_PLACEMENTS   the placements anchored on the SCREEN pages
+//! ```
+//!
+//! After its HISTORY pages the screen writes one more KITTY_PLACEMENTS record
+//! with the placements anchored on history pages. A screen without Kitty
+//! graphics state writes none of these records, so such snapshots are
+//! unchanged.
+//!
+//! An encoder may limit the bytes of image pixels it writes. An image beyond
+//! that limit is written without pixels and restores as a pending image of
+//! the same size, so that placements, eviction and later commands behave the
+//! same while a renderer draws nothing for it. The unfinished transmission is
+//! always written in full.
+//!
+//! Placement anchors are rows counted from the top of the pages restored at
+//! that point: the first SCREEN page for KITTY_PLACEMENTS before READY, and
+//! the oldest history row after HISTORY. A placement that cannot be anchored
+//! when it is decoded is dropped.
+//!
+//! Only builds with Kitty graphics write or read these records.
+//!
+//! All integers are little-endian.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const io = @import("io.zig");
+const record = @import("record.zig");
+const TerminalScreen = @import("../Screen.zig");
+const TerminalScreenKey = @import("../ScreenSet.zig").Key;
+const PageList = @import("../PageList.zig");
+const graphics = @import("../kitty.zig").graphics;
+const command = @import("../kitty/graphics_command.zig");
+
+const Storage = graphics.ImageStorage;
+const Image = graphics.Image;
+const LoadingImage = graphics.LoadingImage;
+const Animation = graphics.Animation;
+const Placement = Storage.Placement;
+const PlacementKey = Storage.PlacementKey;
+
+/// The most image storage a decoded snapshot may request. Larger requests
+/// are reduced to it. It is the default storage limit of the Ghostty app.
+const max_storage_limit = 320 * 1000 * 1000;
+
+/// The largest width or height of a stored image, the same as Kitty.
+const max_dimension = 10000;
+
+/// The largest payload of an unfinished transmission, the same as Kitty.
+const max_loading_bytes = 400 * 1024 * 1024;
+
+pub const EncodeError = Allocator.Error ||
+    std.Io.Writer.Error ||
+    record.Writer.FinishError;
+
+pub const DecodeError = Allocator.Error ||
+    std.Io.Reader.Error ||
+    record.Reader.InitError ||
+    record.Reader.FinishError ||
+    error{
+        /// The next record is valid but is not the expected KITTY record.
+        UnexpectedRecordTag,
+
+        /// A KITTY record names another screen than the one it follows.
+        UnexpectedScreenKey,
+
+        /// A KITTY record carries an impossible value.
+        InvalidKittyRecord,
+    };
+
+/// Which images an encoder writes with their pixels. The images of the
+/// active screen come first; within a screen, images placed on the SCREEN
+/// pages come first, then images placed in history, then the rest, and
+/// newer images before older ones.
+pub const Plan = struct {
+    complete: std.AutoHashMapUnmanaged(Entry, void) = .empty,
+
+    const Entry = struct { key: TerminalScreenKey, id: u32 };
+
+    pub fn init(
+        alloc: Allocator,
+        screens: []const Screen,
+        image_data_limit: usize,
+    ) Allocator.Error!Plan {
+        var plan: Plan = .{};
+        errdefer plan.deinit(alloc);
+        var remaining = image_data_limit;
+        for (screens) |screen| {
+            const storage = &screen.screen.kitty_images;
+            var candidates: std.ArrayListUnmanaged(Candidate) = .empty;
+            defer candidates.deinit(alloc);
+            try candidates.ensureTotalCapacity(alloc, storage.images.count());
+
+            const first_y = firstScreenRow(screen.screen);
+            var it = storage.images.iterator();
+            while (it.next()) |entry| candidates.appendAssumeCapacity(.{
+                .id = entry.key_ptr.*,
+                .generation = entry.value_ptr.generation,
+                .size = entry.value_ptr.storageSize(),
+                .class = placementClass(screen.screen, first_y, entry.key_ptr.*),
+            });
+            std.mem.sortUnstable(Candidate, candidates.items, {}, Candidate.before);
+
+            for (candidates.items) |candidate| {
+                if (candidate.size > remaining) continue;
+                remaining -= candidate.size;
+                try plan.complete.put(alloc, .{ .key = screen.key, .id = candidate.id }, {});
+            }
+        }
+        return plan;
+    }
+
+    pub fn deinit(self: *Plan, alloc: Allocator) void {
+        self.complete.deinit(alloc);
+    }
+
+    fn includes(self: *const Plan, key: TerminalScreenKey, id: u32) bool {
+        return self.complete.contains(.{ .key = key, .id = id });
+    }
+
+    const Candidate = struct {
+        id: u32,
+        generation: u64,
+        size: usize,
+        class: u2,
+
+        fn before(_: void, lhs: Candidate, rhs: Candidate) bool {
+            if (lhs.class != rhs.class) return lhs.class < rhs.class;
+            if (lhs.generation != rhs.generation) return lhs.generation > rhs.generation;
+            return lhs.id < rhs.id;
+        }
+    };
+
+    /// 0 for an image placed on the SCREEN pages, 1 for an image placed in
+    /// history only, 2 for an image without placements.
+    fn placementClass(screen: *const TerminalScreen, first_y: u32, id: u32) u2 {
+        var class: u2 = 2;
+        var it = screen.kitty_images.placements.iterator();
+        while (it.next()) |entry| {
+            if (entry.key_ptr.image_id != id) continue;
+            switch (anchor(screen, first_y, entry.value_ptr.*)) {
+                .screen => return 0,
+                .history => class = 1,
+                .none => {},
+            }
+        }
+        return class;
+    }
+};
+
+/// A screen and its key, in the order an encoder plans them.
+pub const Screen = struct {
+    key: TerminalScreenKey,
+    screen: *const TerminalScreen,
+};
+
+/// Whether a screen has Kitty graphics state that a snapshot must keep.
+pub fn hasState(screen: *const TerminalScreen) bool {
+    const storage = &screen.kitty_images;
+    const defaults: Storage = .{};
+    return storage.images.count() > 0 or
+        storage.placements.count() > 0 or
+        storage.loading != null or
+        storage.next_image_id != defaults.next_image_id or
+        storage.next_internal_placement_id != defaults.next_internal_placement_id;
+}
+
+/// Write the KITTY records that follow a screen's SCREEN pages.
+pub fn encodeScreen(
+    alloc: Allocator,
+    screen: *const TerminalScreen,
+    key: TerminalScreenKey,
+    plan: *const Plan,
+    destination: *record.Writer,
+) EncodeError!void {
+    if (!hasState(screen)) return;
+    const storage = &screen.kitty_images;
+
+    // Images restore in their order of transmission, which keeps the
+    // eviction order.
+    const ids = try alloc.alloc(u32, storage.images.count());
+    defer alloc.free(ids);
+    {
+        var it = storage.images.keyIterator();
+        var i: usize = 0;
+        while (it.next()) |id| : (i += 1) ids[i] = id.*;
+        std.mem.sortUnstable(u32, ids, storage, struct {
+            fn lessThan(s: *const Storage, lhs: u32, rhs: u32) bool {
+                return s.images.get(lhs).?.generation < s.images.get(rhs).?.generation;
+            }
+        }.lessThan);
+    }
+
+    {
+        const payload = destination.begin(.kitty_storage);
+        errdefer destination.cancel();
+        try payload.writeByte(@intCast(@intFromEnum(key)));
+        try io.writeInt(payload, u64, storage.total_limit);
+        try io.writeInt(payload, u32, storage.next_image_id);
+        try io.writeInt(payload, u32, storage.next_internal_placement_id);
+        try io.writeInt(payload, u32, @intCast(ids.len));
+        try payload.writeByte(@intFromBool(storage.loading != null));
+        try destination.finish();
+    }
+
+    for (ids) |id| {
+        const image = storage.images.getPtr(id).?;
+        const payload = destination.begin(.kitty_image);
+        errdefer destination.cancel();
+        try encodeImage(image, plan.includes(key, id), payload);
+        try destination.finish();
+    }
+
+    if (storage.loading) |loading| {
+        const payload = destination.begin(.kitty_loading);
+        errdefer destination.cancel();
+        try encodeLoading(storage, loading, payload);
+        try destination.finish();
+    }
+
+    try encodePlacements(alloc, screen, key, .screen, destination);
+}
+
+/// Write the KITTY_PLACEMENTS record that follows a screen's HISTORY pages.
+pub fn encodeHistory(
+    alloc: Allocator,
+    screen: *const TerminalScreen,
+    key: TerminalScreenKey,
+    destination: *record.Writer,
+) EncodeError!void {
+    if (!hasState(screen)) return;
+    try encodePlacements(alloc, screen, key, .history, destination);
+}
+
+/// True if the next record may have the given tag. Every tag is below 256,
+/// so the first byte of the little-endian tag decides, and a reader with a
+/// one-byte buffer can tell. The record decode checks the whole header. A
+/// source that ends or fails here answers false, and the decode that
+/// follows reports it.
+pub fn nextIs(source: *std.Io.Reader, tag: record.Tag) bool {
+    comptime for (std.enums.values(record.Tag)) |value| {
+        std.debug.assert(@intFromEnum(value) < 256);
+    };
+    if (source.buffer.len == 0) return false;
+    const bytes = source.peek(1) catch return false;
+    return bytes[0] == @intFromEnum(tag);
+}
+
+/// Restore the KITTY records that follow a screen's SCREEN pages, if the
+/// next record begins them.
+pub fn decodeScreen(
+    source: *std.Io.Reader,
+    io_: std.Io,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+    key: TerminalScreenKey,
+) DecodeError!void {
+    if (!nextIs(source, .kitty_storage)) return;
+
+    var header_reader: record.Reader = undefined;
+    try header_reader.init(source);
+    const header = try decodeStorageHeader(header_reader.payloadReader(), key);
+    try header_reader.finish();
+
+    const storage = &screen.kitty_images;
+    storage.setLimit(io_, alloc, screen, @intCast(@min(header.total_limit, max_storage_limit)));
+
+    for (0..header.image_count) |_| {
+        var reader: record.Reader = undefined;
+        try reader.init(source);
+        if (reader.header.tag != .kitty_image) return error.UnexpectedRecordTag;
+        try decodeImage(reader.payloadReader(), io_, alloc, screen);
+        try reader.finish();
+    }
+
+    if (header.loading) {
+        var reader: record.Reader = undefined;
+        try reader.init(source);
+        if (reader.header.tag != .kitty_loading) return error.UnexpectedRecordTag;
+        try decodeLoading(reader.payloadReader(), alloc, screen);
+        try reader.finish();
+    }
+
+    storage.next_image_id = header.next_image_id;
+    storage.next_internal_placement_id = header.next_internal_placement_id;
+
+    try decodePlacements(source, io_, alloc, screen, key);
+}
+
+/// Restore the KITTY_PLACEMENTS record that follows a screen's HISTORY pages,
+/// if the next record is one. A null screen consumes and drops it, as when
+/// some history pages were dropped.
+pub fn decodeHistory(
+    source: *std.Io.Reader,
+    io_: std.Io,
+    alloc: Allocator,
+    screen: ?*TerminalScreen,
+    key: TerminalScreenKey,
+) DecodeError!void {
+    if (!nextIs(source, .kitty_placements)) return;
+    if (screen) |s| return decodePlacements(source, io_, alloc, s, key);
+
+    var reader: record.Reader = undefined;
+    try reader.init(source);
+    try reader.payloadReader().discardAll(reader.header.payload_len);
+    try reader.finish();
+}
+
+const StorageHeader = struct {
+    total_limit: u64,
+    next_image_id: u32,
+    next_internal_placement_id: u32,
+    image_count: u32,
+    loading: bool,
+};
+
+fn decodeStorageHeader(
+    reader: *std.Io.Reader,
+    key: TerminalScreenKey,
+) DecodeError!StorageHeader {
+    if (try decodeKey(reader) != key) return error.UnexpectedScreenKey;
+    return .{
+        .total_limit = try io.readInt(reader, u64),
+        .next_image_id = try io.readInt(reader, u32),
+        .next_internal_placement_id = try io.readInt(reader, u32),
+        .image_count = try io.readInt(reader, u32),
+        .loading = try decodeBool(reader),
+    };
+}
+
+fn decodeKey(reader: *std.Io.Reader) DecodeError!TerminalScreenKey {
+    const raw = try reader.takeByte();
+    return std.enums.fromInt(TerminalScreenKey, raw) orelse error.InvalidKittyRecord;
+}
+
+fn decodeBool(reader: *std.Io.Reader) DecodeError!bool {
+    return switch (try reader.takeByte()) {
+        0 => false,
+        1 => true,
+        else => error.InvalidKittyRecord,
+    };
+}
+
+// Image flags.
+const flag_transient: u8 = 1 << 0;
+const flag_implicit_id: u8 = 1 << 1;
+
+fn encodeImage(image: *const Image, with_pixels: bool, payload: *std.Io.Writer) EncodeError!void {
+    const pixels = image.data.bytes();
+    const complete = with_pixels and pixels != null;
+    try encodeImageHeader(image, payload);
+    try payload.writeByte(@intFromBool(complete));
+    if (!complete) return;
+
+    try payload.writeAll(pixels.?);
+    const anim = image.animation orelse return payload.writeByte(0);
+    try payload.writeByte(1);
+    try io.writeInt(payload, u32, anim.root_gap_ms);
+    try io.writeInt(payload, u32, anim.current_index);
+    try payload.writeByte(@intCast(@intFromEnum(anim.state)));
+    try io.writeInt(payload, u32, anim.max_loops);
+    try io.writeInt(payload, u32, anim.current_loop);
+    try io.writeInt(payload, u32, @intCast(anim.frames.items.len));
+    for (anim.frames.items) |frame| {
+        try io.writeInt(payload, u32, frame.gap_ms);
+        try payload.writeAll(frame.data);
+    }
+}
+
+fn encodeImageHeader(image: *const Image, payload: *std.Io.Writer) EncodeError!void {
+    try io.writeInt(payload, u32, image.id);
+    try io.writeInt(payload, u32, image.number);
+    try io.writeInt(payload, u32, image.width);
+    try io.writeInt(payload, u32, image.height);
+    try payload.writeByte(@intCast(@intFromEnum(image.format)));
+    try payload.writeByte(@intCast(@intFromEnum(image.compression)));
+    var flags: u8 = 0;
+    if (image.metadata.transient) flags |= flag_transient;
+    if (image.metadata.implicit_id) flags |= flag_implicit_id;
+    try payload.writeByte(flags);
+}
+
+/// Decode the fields that encodeImageHeader writes.
+fn decodeImageHeader(reader: *std.Io.Reader) DecodeError!Image {
+    var image: Image = .{
+        .id = try io.readInt(reader, u32),
+        .number = try io.readInt(reader, u32),
+        .width = try io.readInt(reader, u32),
+        .height = try io.readInt(reader, u32),
+    };
+    image.format = std.enums.fromInt(
+        @TypeOf(image.format),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    image.compression = std.enums.fromInt(
+        @TypeOf(image.compression),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    const flags = try reader.takeByte();
+    if (flags & ~(flag_transient | flag_implicit_id) != 0) return error.InvalidKittyRecord;
+    image.metadata.transient = flags & flag_transient != 0;
+    image.metadata.implicit_id = flags & flag_implicit_id != 0;
+    return image;
+}
+
+/// The byte length of a stored image of these dimensions and format.
+fn storedLen(image: Image) DecodeError!usize {
+    const bpp: usize = switch (image.format) {
+        .gray => 1,
+        .gray_alpha => 2,
+        .rgb => 3,
+        .rgba => 4,
+        .png => return error.InvalidKittyRecord,
+    };
+    return @as(usize, image.width) * image.height * bpp;
+}
+
+fn decodeImage(
+    reader: *std.Io.Reader,
+    io_: std.Io,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+) DecodeError!void {
+    var image = try decodeImageHeader(reader);
+    if (image.id == 0 or
+        image.compression != .none or
+        image.width > max_dimension or
+        image.height > max_dimension) return error.InvalidKittyRecord;
+    const len = try storedLen(image);
+    if (!try decodeBool(reader)) {
+        image.data = .{ .pending = len };
+        return addImage(io_, alloc, screen, image);
+    }
+
+    // addImage owns the pixels and frames, so the errdefers end here.
+    {
+        const pixels = try alloc.alloc(u8, len);
+        errdefer alloc.free(pixels);
+        try reader.readSliceAll(pixels);
+        image.data = .{ .complete = pixels };
+        if (try decodeBool(reader)) {
+            image.animation = try decodeAnimation(reader, alloc, image);
+        }
+    }
+    try addImage(io_, alloc, screen, image);
+}
+
+fn decodeAnimation(
+    reader: *std.Io.Reader,
+    alloc: Allocator,
+    image: Image,
+) DecodeError!*Animation {
+    const anim = try alloc.create(Animation);
+    anim.* = .{};
+    errdefer {
+        anim.deinit(alloc);
+        alloc.destroy(anim);
+    }
+    anim.root_gap_ms = try io.readInt(reader, u32);
+    anim.current_index = try io.readInt(reader, u32);
+    anim.state = std.enums.fromInt(
+        Animation.State,
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    anim.max_loops = try io.readInt(reader, u32);
+    anim.current_loop = try io.readInt(reader, u32);
+    const frame_count = try io.readInt(reader, u32);
+    if (anim.current_index > frame_count) return error.InvalidKittyRecord;
+    const frame_len = @as(usize, image.width) * image.height * 4;
+    for (0..frame_count) |_| {
+        const gap_ms = try io.readInt(reader, u32);
+        const data = try alloc.alloc(u8, frame_len);
+        errdefer alloc.free(data);
+        try reader.readSliceAll(data);
+        try anim.frames.append(alloc, .{ .data = data, .gap_ms = gap_ms });
+    }
+    return anim;
+}
+
+/// Store a decoded image and take ownership of its pixels and frames. A
+/// snapshot that holds more than the storage limit degrades the way the
+/// storage itself does: older images are evicted, and an image larger than
+/// the whole limit is dropped.
+fn addImage(
+    io_: std.Io,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+    image: Image,
+) DecodeError!void {
+    var value = image;
+    const storage = &screen.kitty_images;
+    if (storage.images.contains(value.id)) {
+        value.deinit(alloc);
+        return error.InvalidKittyRecord;
+    }
+    if (value.data.len() > storage.total_limit) {
+        value.deinit(alloc);
+        return;
+    }
+
+    // The storage counts only the base pixels of an added image, so the
+    // frames are attached after it and counted here.
+    const anim = value.animation;
+    value.animation = null;
+    storage.addImage(io_, alloc, screen, value) catch |err| {
+        value.animation = anim;
+        value.deinit(alloc);
+        return err;
+    };
+    const a = anim orelse return;
+    if (storage.total_bytes + a.frameBytes() > storage.total_limit) {
+        a.deinit(alloc);
+        alloc.destroy(a);
+        return;
+    }
+    storage.total_bytes += a.frameBytes();
+    storage.images.getPtr(value.id).?.animation = a;
+}
+
+fn encodeLoading(
+    storage: *const Storage,
+    loading: *const LoadingImage,
+    payload: *std.Io.Writer,
+) EncodeError!void {
+    try encodeImageHeader(&loading.image, payload);
+    try payload.writeByte(@intCast(@intFromEnum(loading.quiet)));
+    try io.writeInt(payload, u32, loading.response.id);
+    try io.writeInt(payload, u32, loading.response.image_number);
+    try io.writeInt(payload, u32, loading.response.placement_id);
+    try io.writeInt(payload, u32, loading.response.frame);
+
+    if (loading.display) |d| {
+        try payload.writeByte(1);
+        try encodeDisplay(d, payload);
+    } else try payload.writeByte(0);
+
+    if (loading.frame) |f| {
+        try payload.writeByte(1);
+        try encodeFrameLoading(f.cmd, payload);
+        // The generation only matters as a match with the target image.
+        const target = if (f.cmd.transmission.image_id != 0)
+            storage.images.get(f.cmd.transmission.image_id)
+        else
+            null;
+        try payload.writeByte(@intFromBool(target != null and target.?.generation == f.image_generation));
+    } else try payload.writeByte(0);
+
+    try io.writeInt(payload, u64, loading.data.items.len);
+    try payload.writeAll(loading.data.items);
+}
+
+fn decodeLoading(
+    reader: *std.Io.Reader,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+) DecodeError!void {
+    const image = try decodeImageHeader(reader);
+    const quiet = std.enums.fromInt(
+        @FieldType(LoadingImage, "quiet"),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    var response: graphics.Response = .{};
+    response.id = try io.readInt(reader, u32);
+    response.image_number = try io.readInt(reader, u32);
+    response.placement_id = try io.readInt(reader, u32);
+    response.frame = try io.readInt(reader, u32);
+
+    const display: ?command.Display = if (try decodeBool(reader))
+        try decodeDisplay(reader)
+    else
+        null;
+
+    var frame: ?LoadingImage.FrameContext = null;
+    if (try decodeBool(reader)) {
+        const cmd = try decodeFrameLoading(reader);
+        const valid = try decodeBool(reader);
+        frame = .{ .cmd = cmd, .image_generation = 0 };
+            if (valid and cmd.transmission.image_id != 0) {
+            if (screen.kitty_images.images.get(cmd.transmission.image_id)) |target| {
+                frame.?.image_generation = target.generation;
+            }
+        }
+    }
+
+    const len = try io.readInt(reader, u64);
+    if (len > max_loading_bytes) return error.InvalidKittyRecord;
+    var data: std.ArrayListUnmanaged(u8) = .empty;
+    errdefer data.deinit(alloc);
+    try data.resize(alloc, @intCast(len));
+    try reader.readSliceAll(data.items);
+
+    if (screen.kitty_images.loading != null) return error.InvalidKittyRecord;
+    const loading = try alloc.create(LoadingImage);
+    loading.* = .{
+        .image = image,
+        .data = data,
+        .display = display,
+        .frame = frame,
+        .quiet = quiet,
+        .response = response,
+        .temporary_directory = null,
+    };
+    screen.kitty_images.loading = loading;
+}
+
+fn encodeDisplay(d: command.Display, payload: *std.Io.Writer) EncodeError!void {
+    inline for (.{
+        d.image_id,    d.image_number, d.placement_id, d.x,       d.y,
+        d.width,       d.height,       d.x_offset,     d.y_offset, d.columns,
+        d.rows,        d.parent_id,    d.parent_placement_id,
+    }) |value| try io.writeInt(payload, u32, value);
+    try payload.writeByte(@intCast(@intFromEnum(d.cursor_movement)));
+    try payload.writeByte(@intFromBool(d.virtual_placement));
+    try io.writeInt(payload, i32, d.horizontal_offset);
+    try io.writeInt(payload, i32, d.vertical_offset);
+    try io.writeInt(payload, i32, d.z);
+}
+
+fn decodeDisplay(reader: *std.Io.Reader) DecodeError!command.Display {
+    var d: command.Display = .{};
+    inline for (.{
+        "image_id", "image_number", "placement_id", "x",        "y",
+        "width",    "height",       "x_offset",     "y_offset", "columns",
+        "rows",     "parent_id",    "parent_placement_id",
+    }) |name| @field(d, name) = try io.readInt(reader, u32);
+    d.cursor_movement = std.enums.fromInt(
+        command.Display.CursorMovement,
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    d.virtual_placement = try decodeBool(reader);
+    d.horizontal_offset = try io.readInt(reader, i32);
+    d.vertical_offset = try io.readInt(reader, i32);
+    d.z = try io.readInt(reader, i32);
+    return d;
+}
+
+fn encodeFrameLoading(f: command.AnimationFrameLoading, payload: *std.Io.Writer) EncodeError!void {
+    const t = f.transmission;
+    try payload.writeByte(@intCast(@intFromEnum(t.format)));
+    try payload.writeByte(@intCast(@intFromEnum(t.compression)));
+    inline for (.{
+        t.width,   t.height, t.image_id, t.image_number, t.placement_id,
+        f.x,       f.y,      f.create_frame, f.edit_frame,
+        @as(u32, @bitCast(f.background)),
+    }) |value| try io.writeInt(payload, u32, value);
+    try io.writeInt(payload, i32, f.gap_ms);
+    try payload.writeByte(@intCast(@intFromEnum(f.composition_mode)));
+}
+
+fn decodeFrameLoading(reader: *std.Io.Reader) DecodeError!command.AnimationFrameLoading {
+    var f: command.AnimationFrameLoading = .{};
+    f.transmission.format = std.enums.fromInt(
+        @TypeOf(f.transmission.format),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    f.transmission.compression = std.enums.fromInt(
+        @TypeOf(f.transmission.compression),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    f.transmission.width = try io.readInt(reader, u32);
+    f.transmission.height = try io.readInt(reader, u32);
+    f.transmission.image_id = try io.readInt(reader, u32);
+    f.transmission.image_number = try io.readInt(reader, u32);
+    f.transmission.placement_id = try io.readInt(reader, u32);
+    f.x = try io.readInt(reader, u32);
+    f.y = try io.readInt(reader, u32);
+    f.create_frame = try io.readInt(reader, u32);
+    f.edit_frame = try io.readInt(reader, u32);
+    f.background = @bitCast(try io.readInt(reader, u32));
+    f.gap_ms = try io.readInt(reader, i32);
+    f.composition_mode = std.enums.fromInt(
+        @TypeOf(f.composition_mode),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    return f;
+}
+
+const Phase = enum { screen, history };
+
+const Anchor = union(enum) {
+    /// On the SCREEN pages, in rows from the first SCREEN page's top.
+    screen: Cell,
+
+    /// On a history page, in rows from the oldest history row.
+    history: Cell,
+
+    /// Not anchored on a page: a virtual placement, a relative placement
+    /// rooted at one, or a pin whose row was pruned.
+    none,
+};
+
+const Cell = struct { x: u16, y: u32 };
+
+/// The screen row at the top of the first SCREEN page.
+fn firstScreenRow(screen: *const TerminalScreen) u32 {
+    const first = screen.pages.getTopLeft(.active).node;
+    return screen.pages.pointFromPin(.screen, .{ .node = first }).?.screen.y;
+}
+
+/// Where a placement is anchored. A relative placement is anchored where
+/// its parent chain is rooted.
+fn anchor(screen: *const TerminalScreen, first_y: u32, p: Placement) Anchor {
+    const pin = switch (p.location) {
+        .pin => |pin| pin,
+        .virtual => return .none,
+        .relative => |rel| {
+            const chain = screen.kitty_images.resolveChain(rel) orelse return .none;
+            return switch (chain.root.location) {
+                .pin => anchor(screen, first_y, chain.root),
+                else => .none,
+            };
+        },
+    };
+    if (pin.garbage) return .none;
+    const y = (screen.pages.pointFromPin(.screen, pin.*) orelse return .none).screen.y;
+    return if (y >= first_y)
+        .{ .screen = .{ .x = pin.x, .y = y - first_y } }
+    else
+        .{ .history = .{ .x = pin.x, .y = y } };
+}
+
+/// Write the placements of one phase, parents before their relative
+/// placements so each parent exists when its child is restored.
+fn encodePlacements(
+    alloc: Allocator,
+    screen: *const TerminalScreen,
+    key: TerminalScreenKey,
+    phase: Phase,
+    destination: *record.Writer,
+) EncodeError!void {
+    const storage = &screen.kitty_images;
+    const first_y = firstScreenRow(screen);
+
+    var selected: std.ArrayListUnmanaged(PlacementKey) = .empty;
+    defer selected.deinit(alloc);
+    var written: std.AutoHashMapUnmanaged(PlacementKey, void) = .empty;
+    defer written.deinit(alloc);
+
+    // Placements that are not relative, then relative placements whose
+    // parent was already selected, until no more can be added.
+    var it = storage.placements.iterator();
+    while (it.next()) |entry| {
+        if (entry.value_ptr.location == .relative) continue;
+        if (!inPhase(anchor(screen, first_y, entry.value_ptr.*), phase, entry.value_ptr.location)) continue;
+        try selected.append(alloc, entry.key_ptr.*);
+        try written.put(alloc, entry.key_ptr.*, {});
+    }
+    while (true) {
+        const before = selected.items.len;
+        var rel_it = storage.placements.iterator();
+        while (rel_it.next()) |entry| {
+            const rel = switch (entry.value_ptr.location) {
+                .relative => |rel| rel,
+                else => continue,
+            };
+            if (written.contains(entry.key_ptr.*) or !written.contains(rel.parent)) continue;
+            try selected.append(alloc, entry.key_ptr.*);
+            try written.put(alloc, entry.key_ptr.*, {});
+        }
+        if (selected.items.len == before) break;
+    }
+    if (phase == .history and selected.items.len == 0) {
+        // The history set is optional when it has nothing to restore.
+        return;
+    }
+
+    const payload = destination.begin(.kitty_placements);
+    errdefer destination.cancel();
+    try payload.writeByte(@intCast(@intFromEnum(key)));
+    try io.writeInt(payload, u32, @intCast(selected.items.len));
+    for (selected.items) |placement_key| {
+        const p = storage.placements.get(placement_key).?;
+        try io.writeInt(payload, u32, placement_key.image_id);
+        try payload.writeByte(@intCast(@intFromEnum(placement_key.placement_id.tag)));
+        try io.writeInt(payload, u32, placement_key.placement_id.id);
+        switch (p.location) {
+            .pin => {
+                try payload.writeByte(0);
+                const at = switch (anchor(screen, first_y, p)) {
+                    .screen => |at| at,
+                    .history => |at| at,
+                    .none => unreachable,
+                };
+                try io.writeInt(payload, u16, at.x);
+                try io.writeInt(payload, u32, at.y);
+            },
+            .virtual => try payload.writeByte(1),
+            .relative => |rel| {
+                try payload.writeByte(2);
+                try io.writeInt(payload, u32, rel.parent.image_id);
+                try payload.writeByte(@intCast(@intFromEnum(rel.parent.placement_id.tag)));
+                try io.writeInt(payload, u32, rel.parent.placement_id.id);
+                try io.writeInt(payload, i32, rel.horizontal_offset);
+                try io.writeInt(payload, i32, rel.vertical_offset);
+            },
+        }
+        inline for (.{
+            p.x_offset, p.y_offset, p.source_x, p.source_y, p.source_width,
+            p.source_height, p.columns, p.rows,
+        }) |value| try io.writeInt(payload, u32, value);
+        try io.writeInt(payload, i32, p.z);
+    }
+    try destination.finish();
+}
+
+/// Whether a placement that is not relative belongs to a phase. Virtual
+/// placements have no anchor and restore before READY.
+fn inPhase(at: Anchor, phase: Phase, location: Placement.Location) bool {
+    return switch (at) {
+        .screen => phase == .screen,
+        .history => phase == .history,
+        .none => phase == .screen and location == .virtual,
+    };
+}
+
+fn decodePlacements(
+    source: *std.Io.Reader,
+    io_: std.Io,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+    key: TerminalScreenKey,
+) DecodeError!void {
+    var reader: record.Reader = undefined;
+    try reader.init(source);
+    if (reader.header.tag != .kitty_placements) return error.UnexpectedRecordTag;
+    const payload = reader.payloadReader();
+    if (try decodeKey(payload) != key) return error.UnexpectedScreenKey;
+    const count = try io.readInt(payload, u32);
+    for (0..count) |_| try decodePlacement(payload, alloc, screen);
+    try reader.finish();
+    screen.kitty_images.markMutated(io_);
+}
+
+fn decodePlacementId(reader: *std.Io.Reader) DecodeError!Storage.PlacementId {
+    const tag = std.enums.fromInt(
+        @FieldType(Storage.PlacementId, "tag"),
+        try reader.takeByte(),
+    ) orelse return error.InvalidKittyRecord;
+    return .{ .tag = tag, .id = try io.readInt(reader, u32) };
+}
+
+fn decodePlacement(
+    reader: *std.Io.Reader,
+    alloc: Allocator,
+    screen: *TerminalScreen,
+) DecodeError!void {
+    const key: PlacementKey = .{
+        .image_id = try io.readInt(reader, u32),
+        .placement_id = try decodePlacementId(reader),
+    };
+
+    const At = struct { x: u16, y: u32 };
+    var at: ?At = null;
+    var p: Placement = .{ .location = .virtual };
+    switch (try reader.takeByte()) {
+        0 => at = .{
+            .x = try io.readInt(reader, u16),
+            .y = try io.readInt(reader, u32),
+        },
+        1 => {},
+        2 => p.location = .{ .relative = .{
+            .parent = .{
+                .image_id = try io.readInt(reader, u32),
+                .placement_id = try decodePlacementId(reader),
+            },
+            .horizontal_offset = try io.readInt(reader, i32),
+            .vertical_offset = try io.readInt(reader, i32),
+        } },
+        else => return error.InvalidKittyRecord,
+    }
+    inline for (.{
+        "x_offset", "y_offset", "source_x", "source_y", "source_width",
+        "source_height", "columns", "rows",
+    }) |name| @field(p, name) = try io.readInt(reader, u32);
+    p.z = try io.readInt(reader, i32);
+
+    // A placement whose image, parent, or row is missing, or which repeats
+    // a key, is dropped.
+    const storage = &screen.kitty_images;
+    const image = storage.images.getPtr(key.image_id) orelse return;
+    if (storage.placements.contains(key)) return;
+    const count = std.math.add(
+        @TypeOf(image.metadata.placement_count),
+        image.metadata.placement_count,
+        1,
+    ) catch return;
+    switch (p.location) {
+        .relative => |rel| if (!storage.placements.contains(rel.parent)) return,
+        .virtual => if (at) |pos| {
+            const row = screen.pages.pin(.{ .screen = .{ .x = pos.x, .y = pos.y } }) orelse return;
+            p.location = .{ .pin = try screen.pages.trackPin(row) };
+        },
+        .pin => unreachable,
+    }
+    errdefer p.deinit(screen);
+
+    try storage.placements.put(alloc, key, p);
+    image.metadata.placement_count = count;
+}
