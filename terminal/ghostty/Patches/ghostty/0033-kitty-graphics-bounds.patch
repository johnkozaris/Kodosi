+
+    var s: ImageStorage = .{};
+    defer s.deinit(alloc, t.screens.active);
+    try s.addImage(io, alloc, t.screens.active, .{ .id = 1 });
+    const limit = ImageStorage.placement_count_limit;
+    for (1..limit + 1) |id| {
+        try s.addPlacement(io, alloc, t.screens.active, 1, @intCast(id), .{ .location = .{ .virtual = {} } });
+    }
+    try testing.expectError(
+        error.OutOfMemory,
+        s.addPlacement(io, alloc, t.screens.active, 1, limit + 1, .{ .location = .{ .virtual = {} } }),
+    );
+
+    // Replacing a placement is not refused.
