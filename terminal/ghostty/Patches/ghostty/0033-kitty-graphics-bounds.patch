+test "storage: image count limit evicts the oldest image" {
+    const testing = std.testing;
+    const io = testing.io;
+    const alloc = testing.allocator;
+    var t = try terminal.Terminal.init(io, alloc, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(alloc);
+
+    var s: ImageStorage = .{};
+    defer s.deinit(alloc, t.screens.active);
+    const limit = ImageStorage.image_count_limit;
+    for (1..limit + 2) |id| {
+        try s.addImage(io, alloc, t.screens.active, .{ .id = @intCast(id), .data = .{ .pending = 1 } });
+    }
+    try testing.expectEqual(@as(usize, limit), s.images.count());
+    try testing.expectEqual(@as(usize, limit), s.total_bytes);
+    try testing.expect(s.imageById(1) == null);
+    try testing.expect(s.imageById(limit + 1) != null);
+
+    // Replacing a stored image evicts no other.
+    try s.addImage(io, alloc, t.screens.active, .{ .id = 2, .data = .{ .pending = 1 } });
+    try testing.expectEqual(@as(usize, limit), s.images.count());
