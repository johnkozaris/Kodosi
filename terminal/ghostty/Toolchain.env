ZIG_VERSION=0.17.1
ZIG_AARCH64_MACOS_URL=https://ziglang.org/download/0.17.1/zig-aarch64-macos-0.17.1.tar.xz
ZIG_AARCH64_MACOS_SHA256=75f1bc7a1e9852f17ec9a0c1895f767c4ec56d46bc8a834920eece1d0359dd8d
ZIG_X86_64_LINUX_URL=https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz
ZIG_X86_64_LINUX_SHA256=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a
ZIG_X86_64_WINDOWS_URL=https://ziglang.org/download/0.17.1/zig-x86_64-windows-0.17.1.zip
ZIG_X86_64_WINDOWS_SHA256=b03f477a1943673e02aca0f570e8030dffd536ce1f45cbc4d3326ec31159562e
ZIG_AARCH64_WINDOWS_URL=https://ziglang.org/download/0.17.1/zig-aarch64-windows-0.17.1.zip
ZIG_AARCH64_WINDOWS_SHA256=4789895bdb1e312a2ea73b2a7c0a0cc8d2ab62ba6976e834a7c54cf443377c15
METAL_TOOLCHAIN_BUILD=27B47
METAL_TOOLCHAIN_DMG_SHA256=9a7f61869f1ec662b69634db473f81d7b18f947e9cd81601d4b2825f903b6265

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)
        ZIG_TARGET=aarch64-macos
        ZIG_URL=$ZIG_AARCH64_MACOS_URL
        ZIG_SHA256=$ZIG_AARCH64_MACOS_SHA256
        ;;
    Linux-x86_64)
        ZIG_TARGET=x86_64-linux
        ZIG_URL=$ZIG_X86_64_LINUX_URL
        ZIG_SHA256=$ZIG_X86_64_LINUX_SHA256
        ;;
    MINGW64_NT*-x86_64 | MSYS_NT*-x86_64)
        ZIG_TARGET=x86_64-windows
        ZIG_URL=$ZIG_X86_64_WINDOWS_URL
        ZIG_SHA256=$ZIG_X86_64_WINDOWS_SHA256
        ;;
    MINGW64_NT*-aarch64 | MSYS_NT*-aarch64 | CLANGARM64_NT*-aarch64)
        ZIG_TARGET=aarch64-windows
        ZIG_URL=$ZIG_AARCH64_WINDOWS_URL
        ZIG_SHA256=$ZIG_AARCH64_WINDOWS_SHA256
        ;;
    *)
        echo "[!] unsupported Zig install host: $(uname -s)-$(uname -m)" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac
