{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Auth": {
    "LocalProfileSyncTtlSeconds": 60,
    "Providers": [
      {
        "Enabled": true,
        "Scheme": "authentik",
        "Provider": "authentik",
        "Authority": "https://auth.kodosi.com/application/o/kodosi/",
        "CanonicalIssuer": "https://auth.kodosi.com/application/o/kodosi/",
        "Audiences": [ "kodosi-app" ],
        "AllowedAlgorithms": [ "RS256", "ES256" ],
        "SubjectClaim": "sub",
        "UserNameClaim": "preferred_username",
        "EmailClaim": "email",
        "DisplayNameClaim": "name",
        "AvatarUrlClaim": "picture",
        "RequireHttpsMetadata": true,
        "LinkedIdentityClaims": [
          {
            "Provider": "google",
            "Issuer": "https://accounts.google.com",
            "SubjectClaim": "kodosi_google_subject"
          },
          {
            "Provider": "apple",
            "Issuer": "https://appleid.apple.com",
            "SubjectClaim": "kodosi_apple_subject"
          },
          {
            "Provider": "github",
            "Issuer": "https://github.com",
            "SubjectClaim": "kodosi_github_subject"
          }
        ]
      }
    ]
  },
  "WebSockets": {
    "AllowedOrigins": [],
    "KeepAliveIntervalSeconds": 30
  },
  "RateLimiting": {
    "Api": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "WebSockets": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Proxy": {
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 65536
  },
  "Telemetry": {
    "ServiceName": "Kodosi.Backend",
    "ServiceVersion": "",
    "OtlpEndpoint": "",
    "Protocol": "grpc",
    "UseGzipCompression": false,
    "ResourceAttributes": {}
  },
  "AllowedHosts": "*"
}
