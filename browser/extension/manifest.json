{
  "manifest_version": 3,
  "name": "Shared browser",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "130",
  "permissions": ["debugger", "offscreen", "tabCapture", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
